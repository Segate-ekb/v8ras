<?xml version="1.0" encoding="utf-8"?>
<!-- Публичный интерфейс библиотеки — один класс. Транспорт бинарного протокола SWP лежит
     в src/swp (отделён от кластера и переиспользуем), сервис-специфика RAS — в src/internal:
     коды сообщений и описания сущностей. Оба подключаются из публичного класса. -->
<package-def xmlns="http://oscript.io/schemas/lib-config/1.0">
    <class name="КлиентКластераRAS" file="src/Классы/КлиентКластераRAS.os"/>
</package-def>
