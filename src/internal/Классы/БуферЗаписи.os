// Сборка тела сообщения протокола RAS: целые от старшего байта, две схемы varint, строки UTF-8.
#native

Перем _Байты; // Массив чисел 0..255 — накопитель тела

// Добавляет один байт.
//
// Параметры:
//   Значение - Число - 0..255; старшие разряды отбрасываются.
//
// Возвращаемое значение:
//   БуферЗаписи - этот объект для построения цепочкой.
Функция Байт(Знач Значение) Экспорт
	_Байты.Добавить(Значение % 256);
	Возврат ЭтотОбъект;
КонецФункции

// Записывает беззнаковое 16-битное целое в порядке от старшего байта.
Функция Короткое(Знач Значение) Экспорт
	Значение = Нормализовать(Значение, 65536);
	Байт(Цел(Значение / 256));
	Байт(Значение % 256);
	Возврат ЭтотОбъект;
КонецФункции

// Записывает беззнаковое 32-битное целое в порядке от старшего байта.
Функция Целое(Знач Значение) Экспорт
	Значение = Нормализовать(Значение, 4294967296);
	Байт(Цел(Значение / 16777216) % 256);
	Байт(Цел(Значение / 65536) % 256);
	Байт(Цел(Значение / 256) % 256);
	Байт(Значение % 256);
	Возврат ЭтотОбъект;
КонецФункции

// Записывает беззнаковое 64-битное целое в порядке от старшего байта.
Функция Длинное(Знач Значение) Экспорт
	Значение = Нормализовать(Значение, 18446744073709551616);
	Высокое = Цел(Значение / 4294967296);
	Низкое = Значение - Высокое * 4294967296;
	Целое(Высокое);
	Целое(Низкое);
	Возврат ЭтотОбъект;
КонецФункции

// Записывает размер по схеме Size (разряды по 7 бит, старший бит — продолжение).
// Применяется для длины пакета и числа элементов списка.
Функция Размер(Знач Значение) Экспорт
	Остаток = Цел(Значение / 128);
	Первый = Значение % 128;
	Если Остаток <> 0 Тогда
		Первый = Первый + 128;
	КонецЕсли;
	Байт(Первый);
	Значение = Остаток;
	Пока Значение > 0 Цикл
		Остаток = Цел(Значение / 128);
		Текущий = Значение % 128;
		Если Остаток <> 0 Тогда
			Текущий = Текущий + 128;
		КонецЕсли;
		Байт(Текущий);
		Значение = Остаток;
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// Записывает размер по схеме NullableSize (первый разряд — 6 бит, бит 0x40 — продолжение).
// Применяется для длины строки и идентификатора конечной точки.
Функция РазмерNull(Знач Значение) Экспорт
	Остаток = Цел(Значение / 64);
	Первый = Значение % 64;
	Если Остаток <> 0 Тогда
		Первый = Первый + 64;
	КонецЕсли;
	Байт(Первый);
	Значение = Остаток;
	Пока Значение > 0 Цикл
		Остаток = Цел(Значение / 128);
		Текущий = Значение % 128;
		Если Остаток <> 0 Тогда
			Текущий = Текущий + 128;
		КонецЕсли;
		Байт(Текущий);
		Значение = Остаток;
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// Записывает строку: пустая — одним нулевым байтом, иначе длина в UTF-8 схемой NullableSize и байты.
Функция Текст(Знач Значение) Экспорт
	Если ПустаяСтрока(Значение) Тогда
		Байт(0);
		Возврат ЭтотОбъект;
	КонецЕсли;
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Значение, "UTF-8", Ложь);
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	РазмерNull(Буфер.Размер);
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Байт(Буфер[Индекс]);
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// Записывает булево одним байтом: Истина — 1, Ложь — 0.
Функция Флаг(Знач Значение) Экспорт
	Байт(?(Значение, 1, 0));
	Возврат ЭтотОбъект;
КонецФункции

// Записывает дату как тики (.NET-эпоха): мс * 10 + смещение. Пустая дата — нулевые тики.
Функция Время(Знач Значение) Экспорт
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Длинное(0);
		Возврат ЭтотОбъект;
	КонецЕсли;
	Секунды = Значение - '19700101000000';
	Тики = Секунды * 10000 + 621355968000000;
	Длинное(Тики);
	Возврат ЭтотОбъект;
КонецФункции

// Записывает значение с типом (TypedValue): байт типа и тело. Поддержан только тип LONG (целое 64).
Функция ТипизированноеДлинное(Знач Значение) Экспорт
	Байт(5); // LONG
	Длинное(Значение);
	Возврат ЭтотОбъект;
КонецФункции

// Записывает UUID 16 байтами в каноническом порядке строки.
Функция УИД(Знач Значение) Экспорт
	Для Каждого Октет Из РазобратьUUID(Значение) Цикл
		Байт(Октет);
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// Собранное тело.
//
// Возвращаемое значение:
//   ДвоичныеДанные - накопленные байты.
Функция ДвоичныеДанные() Экспорт
	Буфер = Новый БуферДвоичныхДанных(_Байты.Количество());
	Для Индекс = 0 По _Байты.Количество() - 1 Цикл
		Буфер[Индекс] = _Байты[Индекс];
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
КонецФункции

// Число накопленных байтов.
Функция Длина() Экспорт
	Возврат _Байты.Количество();
КонецФункции

Функция Нормализовать(Знач Значение, Знач Модуль)
	Если Значение < 0 Тогда
		Значение = Значение + Модуль;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Разбирает строку UUID в массив из 16 байтов. Принимает вид с дефисами и без.
Функция РазобратьUUID(Знач Значение) Экспорт
	Текст = СтрЗаменить("" + Значение, "-", "");
	Если СтрДлина(Текст) <> 32 Тогда
		ВызватьИсключение "Неверный UUID: " + Значение;
	КонецЕсли;
	Результат = Новый Массив;
	Индекс = 1;
	Пока Индекс <= 31 Цикл
		Результат.Добавить(ШестнадцатеричныйБайт(Сред(Текст, Индекс, 2)));
		Индекс = Индекс + 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ШестнадцатеричныйБайт(Знач Пара)
	Старший = ШестнадцатеричныйРазряд(Сред(Пара, 1, 1));
	Младший = ШестнадцатеричныйРазряд(Сред(Пара, 2, 1));
	Возврат Старший * 16 + Младший;
КонецФункции

Функция ШестнадцатеричныйРазряд(Знач Символ)
	Позиция = Найти("0123456789abcdef", НРег(Символ));
	Если Позиция = 0 Тогда
		ВызватьИсключение "Неверный шестнадцатеричный разряд: " + Символ;
	КонецЕсли;
	Возврат Позиция - 1;
КонецФункции

Процедура ПриСозданииОбъекта()
	_Байты = Новый Массив;
КонецПроцедуры
