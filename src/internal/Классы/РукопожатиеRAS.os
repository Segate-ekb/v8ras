// Установление сеанса RAS: NEGOTIATE → CONNECT → открытие административной конечной точки
// с автоопределением версии сервиса. При отказе сервер присылает список поддерживаемых
// версий; берём высшую из известных библиотеке, иначе падаем с понятной ошибкой.

Перем _Соединение; // СоединениеRAS

// Выполняет полное рукопожатие и открывает конечную точку администрирования кластера.
//
// Параметры:
//   ЖелаемаяВерсия - Строка, Неопределено - версия сервиса; Неопределено — последняя известная.
//
// Возвращаемое значение:
//   Структура - ВерсияСервиса (Строка), ИдКонечнойТочки (Число), ВерсияКонечнойТочки (Число).
Функция ОткрытьСеанс(Знач ЖелаемаяВерсия = Неопределено) Экспорт
	Согласовать();
	Соединиться();

	Если ЖелаемаяВерсия = Неопределено Тогда
		ЖелаемаяВерсия = ПротоколRAS.ПредпочитаемаяВерсия();
	КонецЕсли;

	Ответ = ПопытатьсяОткрыть(ЖелаемаяВерсия);
	Если Ответ.Успех Тогда
		Возврат РезультатОткрытия(Ответ.Пакет, ЖелаемаяВерсия);
	КонецЕсли;

	ПоддерживаемыеТекст = ИзвлечьПоддерживаемые(Ответ.Пакет.Данные);
	ЗапаснаяВерсия = ВыбратьВерсию(ПоддерживаемыеТекст);
	Если ПустаяСтрока(ЗапаснаяВерсия) Или ЗапаснаяВерсия = ЖелаемаяВерсия Тогда
		ВызватьИсключение "Сервер RAS не принял версию " + ЖелаемаяВерсия
			+ ". Поддерживаемые сервером: " + ?(ПустаяСтрока(ПоддерживаемыеТекст), "не сообщены", ПоддерживаемыеТекст)
			+ ". Известные библиотеке: " + СтрСоединить(ПротоколRAS.ИзвестныеВерсии(), ", ")
			+ ". Обновите библиотеку v8ras под новую версию платформы.";
	КонецЕсли;

	Ответ = ПопытатьсяОткрыть(ЗапаснаяВерсия);
	Если Не Ответ.Успех Тогда
		ВызватьИсключение "Сервер RAS отклонил и запасную версию " + ЗапаснаяВерсия
			+ " (сообщено поддерживаемых: " + ПоддерживаемыеТекст + ").";
	КонецЕсли;
	Возврат РезультатОткрытия(Ответ.Пакет, ЗапаснаяВерсия);
КонецФункции

Процедура Согласовать()
	Тело = Новый БуферЗаписи();
	Тело.Целое(ПротоколRAS.Магия()).Короткое(ПротоколRAS.ВерсияПротокола()).Короткое(ПротоколRAS.ВерсияКодека());
	_Соединение.ОтправитьПакет(ПротоколRAS.ПакетNEGOTIATE(), Тело.ДвоичныеДанные());
КонецПроцедуры

Процедура Соединиться()
	Тело = Новый БуферЗаписи();
	Тело.РазмерNull(1).Текст("connect.timeout").ТипизированноеДлинное(2000);
	_Соединение.ОтправитьПакет(ПротоколRAS.ПакетCONNECT(), Тело.ДвоичныеДанные());

	Пакет = _Соединение.ПрочитатьПакет();
	Если Пакет.Тип <> ПротоколRAS.ПакетCONNECT_ACK() Тогда
		ВызватьИсключение "Ожидался CONNECT_ACK, получен пакет типа " + Пакет.Тип;
	КонецЕсли;
КонецПроцедуры

// Возвращает Структура(Успех, Пакет): Успех — пришёл OPEN_ACK; иначе Пакет — отказ.
Функция ПопытатьсяОткрыть(Знач Версия)
	Тело = Новый БуферЗаписи();
	Тело.Текст(ПротоколRAS.ИмяСервиса()).Текст(Версия).Байт(0);
	_Соединение.ОтправитьПакет(ПротоколRAS.ПакетENDPOINT_OPEN(), Тело.ДвоичныеДанные());

	Пакет = _Соединение.ПрочитатьПакет();
	Результат = Новый Структура();
	Результат.Вставить("Успех", Пакет.Тип = ПротоколRAS.ПакетENDPOINT_OPEN_ACK());
	Результат.Вставить("Пакет", Пакет);
	Если Не Результат.Успех И Пакет.Тип <> ПротоколRAS.ПакетENDPOINT_FAILURE() Тогда
		ВызватьИсключение "Неожиданный ответ на открытие конечной точки: тип " + Пакет.Тип;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция РезультатОткрытия(Знач Пакет, Знач Версия)
	Читатель = Новый БуферЧтения(Пакет.Данные);
	ИдентификаторСервиса = Читатель.ПрочитатьТекст();
	ВерсияКонечнойТочки = Читатель.ПрочитатьТекст();
	ИдКонечнойТочки = Читатель.ПрочитатьРазмерNull();

	Результат = Новый Структура();
	Результат.Вставить("ВерсияСервиса", Версия);
	Результат.Вставить("ИдКонечнойТочки", ИдКонечнойТочки);
	Результат.Вставить("ВерсияКонечнойТочки", ЦелаяВерсия(ВерсияКонечнойТочки));
	Результат.Вставить("ИдентификаторСервиса", ИдентификаторСервиса);
	Возврат Результат;
КонецФункции

// Читает из текста отказа перечень поддерживаемых версий: фрагмент после "supported=".
Функция ИзвлечьПоддерживаемые(Знач ДвоичныеДанные)
	Текст = БезопаснаяСтрока(ДвоичныеДанные);
	Маркер = "supported=";
	Позиция = Найти(Текст, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
	КонецСписка = Найти(Хвост, "]");
	Если КонецСписка > 0 Тогда
		Хвост = Лев(Хвост, КонецСписка - 1);
	КонецЕсли;
	Возврат СокрЛП(СтрЗаменить(СтрЗаменить(Хвост, "[", ""), Символы.ПС, " "));
КонецФункции

// Выбирает высшую известную версию, присутствующую в тексте поддерживаемых.
Функция ВыбратьВерсию(Знач ПоддерживаемыеТекст)
	Если ПустаяСтрока(ПоддерживаемыеТекст) Тогда
		Возврат "";
	КонецЕсли;
	Известные = ПротоколRAS.ИзвестныеВерсии();
	Индекс = Известные.ВГраница();
	Пока Индекс >= 0 Цикл
		Версия = Известные[Индекс];
		Если Найти(ПоддерживаемыеТекст, Версия) > 0 Тогда
			Возврат Версия;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ЦелаяВерсия(Знач ТекстВерсии)
	Точка = Найти(ТекстВерсии, ".");
	Целое = ?(Точка > 0, Лев(ТекстВерсии, Точка - 1), ТекстВерсии);
	Попытка
		Возврат Число(Целое);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция БезопаснаяСтрока(Знач ДвоичныеДанные)
	Попытка
		Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, "UTF-8");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Параметры:
//   Соединение - СоединениеRAS - открытый транспорт к серверу RAS.
Процедура ПриСозданииОбъекта(Знач Соединение)
	_Соединение = Соединение;
КонецПроцедуры
