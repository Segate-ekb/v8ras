// Кадрирование протокола RAS поверх TCP: пакет = [байт типа][Size длины][тело].
// Пакет NEGOTIATE (тип 0) особый — передаётся только телом, без типа и длины.

Перем _Сокет; // TCPСоединение или совместимый объект (ОтправитьДвоичныеДанные, ПрочитатьДвоичныеДанные, Закрыть)

// Отправляет пакет.
//
// Параметры:
//   Тип        - Число         - код типа пакета протокола RAS.
//   ДвоичныеТело - ДвоичныеДанные - тело пакета (может быть пустым).
Процедура ОтправитьПакет(Знач Тип, Знач ДвоичныеТело) Экспорт
	Если Тип = 0 Тогда
		_Сокет.ОтправитьДвоичныеДанные(ДвоичныеТело);
		Возврат;
	КонецЕсли;
	БуфТело = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеТело);
	Заголовок = Новый БуферЗаписи();
	Заголовок.Байт(Тип).Размер(БуфТело.Размер);
	_Сокет.ОтправитьДвоичныеДанные(Заголовок.ДвоичныеДанные());
	Если БуфТело.Размер > 0 Тогда
		_Сокет.ОтправитьДвоичныеДанные(ДвоичныеТело);
	КонецЕсли;
КонецПроцедуры

// Читает один пакет целиком.
//
// Возвращаемое значение:
//   Структура - Тип (Число), Данные (ДвоичныеДанные) — тело пакета.
Функция ПрочитатьПакет() Экспорт
	Тип = ПрочитатьБайтИзСокета();
	Длина = ПрочитатьРазмерИзСокета();
	Если Длина > 0 Тогда
		Тело = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ПрочитатьРовно(Длина));
	Иначе
		Тело = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(0));
	КонецЕсли;
	Результат = Новый Структура();
	Результат.Вставить("Тип", Тип);
	Результат.Вставить("Данные", Тело);
	Возврат Результат;
КонецФункции

// Закрывает подлежащий сокет.
Процедура Закрыть() Экспорт
	_Сокет.Закрыть();
КонецПроцедуры

Функция ПрочитатьБайтИзСокета()
	Возврат ПрочитатьРовно(1)[0];
КонецФункции

// Читает длину пакета по схеме Size непосредственно из сокета.
Функция ПрочитатьРазмерИзСокета()
	Текущий = ПрочитатьБайтИзСокета();
	Значение = Текущий % 128;
	Сдвиг = 7;
	Пока Текущий >= 128 Цикл
		Текущий = ПрочитатьБайтИзСокета();
		Значение = Значение + (Текущий % 128) * СтепеньДвойки(Сдвиг);
		Сдвиг = Сдвиг + 7;
	КонецЦикла;
	Возврат Значение;
КонецФункции

// Читает ровно Количество байтов, дочитывая частичные порции; бросает при обрыве.
Функция ПрочитатьРовно(Знач Количество)
	Результат = Новый БуферДвоичныхДанных(Количество);
	Собрано = 0;
	Пока Собрано < Количество Цикл
		Порция = _Сокет.ПрочитатьДвоичныеДанные(Количество - Собрано);
		БуфПорция = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Порция);
		Если БуфПорция.Размер = 0 Тогда
			ВызватьИсключение "Соединение RAS закрыто: получено " + Собрано + " из " + Количество + " байт";
		КонецЕсли;
		Для Индекс = 0 По БуфПорция.Размер - 1 Цикл
			Результат[Собрано + Индекс] = БуфПорция[Индекс];
		КонецЦикла;
		Собрано = Собрано + БуфПорция.Размер;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтепеньДвойки(Знач Показатель)
	Результат = 1;
	Для Сч = 1 По Показатель Цикл
		Результат = Результат * 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Параметры:
//   Сокет - TCPСоединение - открытое соединение с сервером RAS.
Процедура ПриСозданииОбъекта(Знач Сокет)
	_Сокет = Сокет;
КонецПроцедуры
