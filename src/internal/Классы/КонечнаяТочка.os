// Обмен сообщениями с административной конечной точкой RAS поверх кадра ENDPOINT_MESSAGE.
// Кадр запроса: [ид точки][формат=0][вид=1][код сообщения][тело]. Ответ разбирается
// обратно: вид 1 — полезная нагрузка, вид 0 — пусто, вид 0xFF или пакет FAILURE — ошибка.

Перем _Соединение;         // СоединениеRAS
Перем _ИдКонечнойТочки;    // Число
Перем _ВерсияКонечнойТочки; // Число

// Версия сериализации сущностей, согласованная при открытии точки.
Функция Версия() Экспорт
	Возврат _ВерсияКонечнойТочки;
КонецФункции

// Отправляет запрос и читает ответ.
//
// Параметры:
//   КодСообщения - Число - код запроса (см. ПротоколRAS).
//   ТелоЗапроса  - БуферЗаписи, Неопределено - тело запроса; Неопределено — пустое.
//
// Возвращаемое значение:
//   Структура - Вид (Число), КодОтвета (Число), Читатель (БуферЧтения или Неопределено).
Функция ОтправитьЗапрос(Знач КодСообщения, Знач ТелоЗапроса = Неопределено) Экспорт
	Кадр = Новый БуферЗаписи();
	Кадр.РазмерNull(_ИдКонечнойТочки).Короткое(0).Байт(ПротоколRAS.ВидСООБЩЕНИЕ()).Байт(КодСообщения);
	Если ТелоЗапроса <> Неопределено Тогда
		ДописатьБайты(Кадр, ТелоЗапроса.ДвоичныеДанные());
	КонецЕсли;
	_Соединение.ОтправитьПакет(ПротоколRAS.ПакетENDPOINT_MESSAGE(), Кадр.ДвоичныеДанные());

	Пакет = _Соединение.ПрочитатьПакет();
	Если Пакет.Тип = ПротоколRAS.ПакетENDPOINT_FAILURE() Тогда
		ВызватьИсключение "Конечная точка RAS вернула ошибку: " + ТекстОшибки(Пакет.Данные);
	КонецЕсли;
	Если Пакет.Тип <> ПротоколRAS.ПакетENDPOINT_MESSAGE() Тогда
		ВызватьИсключение "Ожидалось сообщение конечной точки, получен пакет типа " + Пакет.Тип;
	КонецЕсли;

	Читатель = Новый БуферЧтения(Пакет.Данные);
	Читатель.ПрочитатьРазмерNull(); // ид конечной точки
	Читатель.ПрочитатьКороткое();   // формат
	Вид = Читатель.ПрочитатьБайт();

	Результат = Новый Структура();
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("КодОтвета", -1);
	Результат.Вставить("Читатель", Неопределено);

	Если Вид = 255 Тогда
		ВызватьИсключение "Конечная точка RAS вернула исключение: " + ДвеСтроки(Читатель);
	ИначеЕсли Вид = ПротоколRAS.ВидСООБЩЕНИЕ() Тогда
		Результат.КодОтвета = Читатель.ПрочитатьБайт();
		Результат.Читатель = Читатель;
	КонецЕсли;

	Возврат Результат;
КонецФункции

Процедура ДописатьБайты(ЦельБуфер, Знач Данные)
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		ЦельБуфер.Байт(Буфер[Индекс]);
	КонецЦикла;
КонецПроцедуры

Функция ДвеСтроки(Знач Читатель)
	Сервис = Читатель.ПрочитатьТекст();
	Сообщение = Читатель.ПрочитатьТекст();
	Возврат Сервис + ": " + Сообщение;
КонецФункции

Функция ТекстОшибки(Знач Данные)
	Попытка
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");
	Исключение
		Возврат "нечитаемое тело ошибки";
	КонецПопытки;
КонецФункции

// Параметры:
//   Соединение         - СоединениеRAS - открытый транспорт.
//   ИдКонечнойТочки     - Число         - идентификатор открытой точки.
//   ВерсияКонечнойТочки - Число         - версия сериализации сущностей.
Процедура ПриСозданииОбъекта(Знач Соединение, Знач ИдКонечнойТочки, Знач ВерсияКонечнойТочки)
	_Соединение = Соединение;
	_ИдКонечнойТочки = ИдКонечнойТочки;
	_ВерсияКонечнойТочки = ВерсияКонечнойТочки;
КонецПроцедуры
