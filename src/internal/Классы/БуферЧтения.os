// Разбор тела ответа протокола RAS: целые от старшего байта, две схемы varint, строки UTF-8.
#native

Перем _Буфер;    // БуферДвоичныхДанных — принятые байты
Перем _Позиция;  // Число — смещение чтения

// Остаток непрочитанных байтов.
Функция Остаток() Экспорт
	Возврат _Буфер.Размер - _Позиция;
КонецФункции

// Есть ли ещё непрочитанные байты.
Функция ЕстьДанные() Экспорт
	Возврат _Позиция < _Буфер.Размер;
КонецФункции

// Читает один байт (0..255).
Функция ПрочитатьБайт() Экспорт
	Если _Позиция >= _Буфер.Размер Тогда
		ВызватьИсключение "Чтение за границей буфера на позиции " + _Позиция;
	КонецЕсли;
	Значение = _Буфер[_Позиция];
	_Позиция = _Позиция + 1;
	Возврат Значение;
КонецФункции

// Читает беззнаковое 16-битное целое от старшего байта.
Функция ПрочитатьКороткое() Экспорт
	Старший = ПрочитатьБайт();
	Младший = ПрочитатьБайт();
	Возврат Старший * 256 + Младший;
КонецФункции

// Читает беззнаковое 32-битное целое от старшего байта.
Функция ПрочитатьЦелое() Экспорт
	Б3 = ПрочитатьБайт();
	Б2 = ПрочитатьБайт();
	Б1 = ПрочитатьБайт();
	Б0 = ПрочитатьБайт();
	Возврат Б3 * 16777216 + Б2 * 65536 + Б1 * 256 + Б0;
КонецФункции

// Читает беззнаковое 64-битное целое от старшего байта.
Функция ПрочитатьДлинное() Экспорт
	Высокое = ПрочитатьЦелое();
	Низкое = ПрочитатьЦелое();
	Возврат Высокое * 4294967296 + Низкое;
КонецФункции

// Читает число двойной точности IEEE 754 (8 байт от старшего). Бесконечность и NaN
// возвращаются как 0 — метрикам они не нужны.
Функция ПрочитатьДвойное() Экспорт
	Биты = ПрочитатьДлинное();
	Знак = ?(Биты >= 9223372036854775808, -1, 1); // бит 63
	БезЗнака = Биты % 9223372036854775808;
	Экспонента = Цел(БезЗнака / 4503599627370496); // биты 52..62
	Мантисса = БезЗнака % 4503599627370496;         // биты 0..51
	Если Экспонента = 0 Тогда
		Если Мантисса = 0 Тогда
			Возврат 0;
		КонецЕсли;
		Возврат Знак * Мантисса * Степень2(-1074); // денормализованное
	ИначеЕсли Экспонента = 2047 Тогда
		Возврат 0; // бесконечность или NaN
	КонецЕсли;
	Дробь = 1 + Мантисса / 4503599627370496;
	Возврат Знак * Дробь * Степень2(Экспонента - 1023);
КонецФункции

// Читает размер по схеме Size.
Функция ПрочитатьРазмер() Экспорт
	Текущий = ПрочитатьБайт();
	Значение = Текущий % 128;
	Сдвиг = 7;
	Пока Текущий >= 128 Цикл
		Текущий = ПрочитатьБайт();
		Значение = Значение + (Текущий % 128) * СтепеньДвойки(Сдвиг);
		Сдвиг = Сдвиг + 7;
	КонецЦикла;
	Возврат Значение;
КонецФункции

// Читает размер по схеме NullableSize.
Функция ПрочитатьРазмерNull() Экспорт
	Текущий = ПрочитатьБайт();
	Если Текущий >= 128 Тогда
		ВызватьИсключение "Ожидался NullableSize, прочитан байт " + Текущий;
	КонецЕсли;
	Значение = Текущий % 64;
	Если Текущий < 64 Тогда
		Возврат Значение;
	КонецЕсли;
	Текущий = ПрочитатьБайт();
	Значение = Значение + (Текущий % 128) * 64;
	Сдвиг = 13;
	Пока Текущий >= 128 Цикл
		Текущий = ПрочитатьБайт();
		Значение = Значение + (Текущий % 128) * СтепеньДвойки(Сдвиг);
		Сдвиг = Сдвиг + 7;
	КонецЦикла;
	Возврат Значение;
КонецФункции

// Читает строку: длина схемой NullableSize, затем байты UTF-8; нулевая длина — пустая строка.
Функция ПрочитатьТекст() Экспорт
	Длина = ПрочитатьРазмерNull();
	Если Длина = 0 Тогда
		Возврат "";
	КонецЕсли;
	Данные = ПрочитатьДвоичные(Длина);
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");
КонецФункции

// Читает булево: ненулевой байт — Истина.
Функция ПрочитатьФлаг() Экспорт
	Возврат ПрочитатьБайт() <> 0;
КонецФункции

// Читает UUID (16 байтов) и возвращает каноническую строку с дефисами в нижнем регистре.
Функция ПрочитатьУИД() Экспорт
	Шестнадцатеричное = "";
	Для Индекс = 1 По 16 Цикл
		Шестнадцатеричное = Шестнадцатеричное + ДваРазряда(ПрочитатьБайт());
	КонецЦикла;
	Возврат Сред(Шестнадцатеричное, 1, 8) + "-"
		+ Сред(Шестнадцатеричное, 9, 4) + "-"
		+ Сред(Шестнадцатеричное, 13, 4) + "-"
		+ Сред(Шестнадцатеричное, 17, 4) + "-"
		+ Сред(Шестнадцатеричное, 21, 12);
КонецФункции

// Читает дату: тики (мс * 10 + смещение эпохи .NET) 64-битным целым; нулевые тики — пустая дата.
Функция ПрочитатьВремя() Экспорт
	Тики = ПрочитатьДлинное();
	Если Тики <= 0 Тогда
		Возврат '00010101000000';
	КонецЕсли;
	Миллисекунды = (Тики - 621355968000000) / 10;
	Секунды = Цел(Миллисекунды / 1000);
	Возврат '19700101000000' + Секунды;
КонецФункции

// Читает срез из N байтов как ДвоичныеДанные и сдвигает позицию.
Функция ПрочитатьДвоичные(Знач Количество) Экспорт
	Если _Позиция + Количество > _Буфер.Размер Тогда
		ВызватьИсключение "Запрошено " + Количество + " байт, доступно " + Остаток();
	КонецЕсли;
	Срез = Новый БуферДвоичныхДанных(Количество);
	Для Индекс = 0 По Количество - 1 Цикл
		Срез[Индекс] = _Буфер[_Позиция + Индекс];
	КонецЦикла;
	_Позиция = _Позиция + Количество;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Срез);
КонецФункции

Функция ДваРазряда(Знач Значение)
	Разряды = "0123456789abcdef";
	Старший = Сред(Разряды, Цел(Значение / 16) + 1, 1);
	Младший = Сред(Разряды, (Значение % 16) + 1, 1);
	Возврат Старший + Младший;
КонецФункции

Функция СтепеньДвойки(Знач Показатель)
	Результат = 1;
	Для Сч = 1 По Показатель Цикл
		Результат = Результат * 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Степень двойки с поддержкой отрицательного показателя (2^n, в т.ч. дробное).
Функция Степень2(Знач Показатель)
	Если Показатель >= 0 Тогда
		Возврат СтепеньДвойки(Показатель);
	КонецЕсли;
	Возврат 1 / СтепеньДвойки(-Показатель);
КонецФункции

// Параметры:
//   Данные - ДвоичныеДанные, БуферДвоичныхДанных - принятые байты.
Процедура ПриСозданииОбъекта(Знач Данные)
	Если ТипЗнч(Данные) = Тип("БуферДвоичныхДанных") Тогда
		_Буфер = Данные;
	Иначе
		_Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	КонецЕсли;
	_Позиция = 0;
КонецПроцедуры
