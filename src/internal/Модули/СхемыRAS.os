// Описания сущностей сервиса администрирования кластера: поля в порядке протокола.
// Источник — v8platform/protos (serializeapis/v8platform/serialize/v1, rasapis/ras/messages/v1);
// справа от поля — его имя в спецификации. Одно описание и читает ответы, и пишет запросы.
#Использовать "../../swp"
#native

Перем _Кластер, _Менеджер, _Сервер, _ДиапазонПортов, _Процесс, _Лицензия;
Перем _БазаКратко, _База, _Сеанс, _Соединение, _Блокировка, _Администратор;

// ClusterInfo.
Функция Кластер() Экспорт
	Если _Кластер = Неопределено Тогда
		_Кластер = Новый ОписаниеСущностиSWP("Кластер")
			.УИД("Ид")                                // uuid
			.Целое("ПериодПринудительногоЗавершения") // expiration_timeout
			.Текст("Хост")                            // host
			.Целое("ИнтервалПерезапуска")             // lifetime_limit
			.Короткое("Порт", 0, 1541)                // port
			.Целое("ДопустимыйОбъемПамяти")           // max_memory_size
			.Целое("ИнтервалПревышенияПамяти")        // max_memory_time_limit
			.Текст("Имя")                             // name
			.Целое("УровеньБезопасности")             // security_level
			.Целое("УровеньОтказоустойчивости")       // session_fault_tolerance_level
			.Целое("РежимРаспределенияНагрузки")      // load_balancing_mode
			.Целое("ДопустимоеОтклонениеОшибок")      // errors_count_threshold
			.Флаг("ЗавершатьПроблемныеПроцессы")      // kill_problem_processes
			.Флаг("ДампПриПревышенииПамяти", 9);      // kill_by_memory_with_dump
	КонецЕсли;
	Возврат _Кластер;
КонецФункции

// ManagerInfo.
Функция Менеджер() Экспорт
	Если _Менеджер = Неопределено Тогда
		_Менеджер = Новый ОписаниеСущностиSWP("Менеджер")
			.УИД("Ид")            // uuid
			.Текст("Описание")    // descr
			.Текст("Хост")        // host
			.ЦелоеФлаг("Главный") // main_manager
			.Короткое("Порт")     // port
			.Текст("Pid");        // pid
	КонецЕсли;
	Возврат _Менеджер;
КонецФункции

// PortRange.
Функция ДиапазонПортов() Экспорт
	Если _ДиапазонПортов = Неопределено Тогда
		_ДиапазонПортов = Новый ОписаниеСущностиSWP("ДиапазонПортов")
			.Короткое("Верхний")  // high
			.Короткое("Нижний");  // low
	КонецЕсли;
	Возврат _ДиапазонПортов;
КонецФункции

// ServerInfo.
Функция Сервер() Экспорт
	Если _Сервер = Неопределено Тогда
		_Сервер = Новый ОписаниеСущностиSWP("Сервер")
			.УИД("Ид")                                       // uuid
			.Текст("ХостАгента")                             // agent_host
			.Короткое("ПортАгента", 0, 1540)                 // agent_port
			.Текст("Имя")                                    // name
			.Флаг("Центральный")                             // main_server
			.Длинное("БезопасныйОбъемПамятиПроцессов")       // safe_working_processes_memory_limit
			.Длинное("БезопасныйРасходПамятиЗаВызов")        // safe_call_memory_limit
			.Целое("ИнфобазНаПроцесс")                       // infobases_limit
			.Длинное("ПредельныйОбъемПамятиПроцессов")       // memory_limit
			.Целое("СоединенийНаПроцесс")                    // connections_limit
			.Короткое("ПортКластера", 0, 1541)               // cluster_port
			.Флаг("МенеджерПодКаждыйСервис")                 // dedicate_managers
			.Список("ДиапазоныПортов", ДиапазонПортов())     // port_ranges
			.Длинное("КритическийОбъемПамятиПроцессов", 8)   // critical_total_memory
			.Длинное("ВременноДопустимыйОбъемПамяти", 8)     // temporary_allowed_total_memory
			.Длинное("ИнтервалВременногоПревышенияПамяти", 8); // temporary_allowed_total_memory_time_limit
	КонецЕсли;
	Возврат _Сервер;
КонецФункции

// LicenseInfo — лицензия, выданная сеансу или рабочему процессу.
Функция Лицензия() Экспорт
	Если _Лицензия = Неопределено Тогда
		_Лицензия = Новый ОписаниеСущностиSWP("Лицензия")
			.Текст("ИмяФайла")                // full_name
			.Текст("ПолноеПредставление")     // full_presentation
			.Флаг("ВыданаСервером")           // issued_by_server
			.Целое("Тип")                     // license_type
			.Целое("МаксПользователейВсего")  // max_users_all
			.Целое("МаксПользователейТекущее") // max_users_cur
			.Флаг("Сетевая")                  // net
			.Текст("АдресМенеджера")          // rmngr_address
			.Текст("PidМенеджера")            // rmngr_pid
			.Целое("ПортМенеджера")           // rmngr_port
			.Текст("Серия")                   // series
			.Текст("КраткоеПредставление");   // short_presentation
	КонецЕсли;
	Возврат _Лицензия;
КонецФункции

// ProcessInfo.
Функция Процесс() Экспорт
	Если _Процесс = Неопределено Тогда
		_Процесс = Новый ОписаниеСущностиSWP("Процесс")
			.УИД("Ид")                                     // uuid
			.Двойное("СредняяДлительностьОбратногоВызова") // avg_back_call_time
			.Двойное("СредняяДлительностьВызова")          // avg_call_time
			.Двойное("СредняяДлительностьВызоваСУБД")      // avg_db_call_time
			.Двойное("СредняяДлительностьБлокировок")      // avg_lock_call_time
			.Двойное("СредняяДлительностьСерверногоВызова") // avg_server_call_time
			.Двойное("СреднееЧислоПотоков")                // avg_threads
			.Целое("Емкость")                              // capacity
			.Целое("Соединений")                           // connections
			.Текст("Хост")                                 // host
			.Флаг("Включен")                               // enable
			.Список("Лицензии", Лицензия())                // licenses
			.Короткое("Порт")                              // port
			.Целое("ВремяПревышенияПамяти")                // memory_excess_time
			.Целое("ПамятьКБ")                             // memory_size
			.Текст("Pid")                                  // pid
			.ЦелоеФлаг("Запущен")                          // running
			.Целое("РазмерВыборки")                        // selection_size
			.Время("Начало")                               // started_at
			.ЦелоеФлаг("Используется")                     // use
			.Целое("ДоступнаяПроизводительность")          // available_perfomance
			.Флаг("Резервный", 9);                         // reverse
	КонецЕсли;
	Возврат _Процесс;
КонецФункции

// InfobaseSummaryInfo.
Функция БазаКратко() Экспорт
	Если _БазаКратко = Неопределено Тогда
		_БазаКратко = Новый ОписаниеСущностиSWP("БазаКратко")
			.УИД("Ид")         // uuid
			.Текст("Описание") // descr
			.Текст("Имя");     // name
	КонецЕсли;
	Возврат _БазаКратко;
КонецФункции

// InfobaseInfo.
Функция База() Экспорт
	Если _База = Неопределено Тогда
		_База = Новый ОписаниеСущностиSWP("База")
			.УИД("Ид")                                    // uuid
			.Целое("СмещениеДат")                         // date_offset
			.Текст("СУБД")                                // dbms
			.Текст("ИмяБД")                               // db_name
			.Текст("ПарольБД")                            // db_pwd
			.Текст("СерверБД")                            // db_server
			.Текст("ПользовательБД")                      // db_user
			.Время("НачалоБлокировки")                    // denied_from
			.Текст("СообщениеБлокировки")                 // denied_message
			.Текст("ПараметрБлокировки")                  // denied_parameter
			.Время("КонецБлокировки")                     // denied_to
			.Текст("Описание")                            // descr
			.Текст("Локаль")                              // locale
			.Текст("Имя")                                 // name
			.Текст("КодРазрешения")                       // permission_code
			.Флаг("БлокировкаРегламентных")               // scheduled_jobs_deny
			.Целое("УровеньБезопасности")                 // security_level
			.Флаг("БлокировкаСеансов")                    // sessions_deny
			.Целое("ВыдачаЛицензийСервером")              // license_distribution
			.Текст("ПараметрыВнешнегоУправленияСеансами") // external_session_manager_connection_string
			.Флаг("ВнешнееУправлениеСеансамиОбязательно") // external_session_manager_required
			.Текст("ПрофильБезопасности")                 // security_profile_name
			.Текст("ПрофильБезопасногоРежима")            // safe_mode_security_profile_name
			.Флаг("РезервироватьРабочиеПроцессы", 9);     // reserve_working_processes
	КонецЕсли;
	Возврат _База;
КонецФункции

// SessionInfo.
Функция Сеанс() Экспорт
	Если _Сеанс = Неопределено Тогда
		_Сеанс = Новый ОписаниеСущностиSWP("Сеанс")
			.УИД("Ид")                                   // uuid
			.Текст("Приложение")                         // app_id
			.Целое("БлокированоСУБД")                    // blocked_by_dbms
			.Целое("БлокированоБлокировками")            // blocked_by_ls
			.Длинное("БайтВсего")                        // bytes_all
			.Длинное("БайтЗа5Минут")                     // bytes_last5min
			.Целое("ВызововВсего")                       // calls_all
			.Длинное("ВызововЗа5Минут")                  // calls_last5min
			.УИД("ИдСоединения")                         // connection_id
			.Длинное("БайтСУБДВсего")                    // dbms_bytes_all
			.Длинное("БайтСУБДЗа5Минут")                 // dbms_bytes_last5min
			.Текст("ЗахваченоСУБД")                      // db_proc_info
			.Целое("ЗахваченоСУБДМс")                    // db_proc_took
			.Время("ЗахваченоСУБДВ")                     // db_proc_took_at
			.Целое("ДлительностьВсего")                  // duration_all
			.Целое("ДлительностьСУБДВсего")              // duration_all_dbms
			.Целое("ДлительностьТекущая")                // duration_current
			.Целое("ДлительностьСУБДТекущая")            // duration_current_dbms
			.Длинное("ДлительностьЗа5Минут")             // duration_last_5_min
			.Длинное("ДлительностьСУБДЗа5Минут")         // duration_last_5_min_dbms
			.Текст("Хост")                               // host
			.УИД("ИдБазы")                               // infobase_id
			.Время("ПоследняяАктивность")                // last_active_at
			.Флаг("Спящий")                              // hibernate
			.Целое("ЗаснутьЧерез")                       // passive_session_hibernate_time
			.Целое("ЗавершитьСпящийЧерез")               // hibernate_session_terminate_time
			.Список("Лицензии", Лицензия())              // licenses
			.Текст("Локаль")                             // locale
			.УИД("ИдПроцесса")                           // process_id
			.Целое("Номер")                              // id
			.Время("Начало")                             // started_at
			.Текст("ИмяПользователя")                    // user_name
			.Длинное("ПамятьТекущая", 4)                 // memory_current
			.Длинное("ПамятьЗа5Минут", 4)                // memory_last5min
			.Длинное("ПамятьВсего", 4)                   // memory_total
			.Длинное("ЧтениеТекущее", 4)                 // read_current
			.Длинное("ЧтениеЗа5Минут", 4)                // read_last5min
			.Длинное("ЧтениеВсего", 4)                   // read_total
			.Длинное("ЗаписьТекущая", 4)                 // write_current
			.Длинное("ЗаписьЗа5Минут", 4)                // write_last5min
			.Длинное("ЗаписьВсего", 4)                   // write_total
			.Целое("ДлительностьСервисаТекущая", 5)      // duration_current_service
			.Длинное("ДлительностьСервисаЗа5Минут", 5)   // duration_last5min_service
			.Целое("ДлительностьСервисаВсего", 5)        // duration_all_service
			.Текст("ТекущийСервис", 5)                   // current_service_name
			.Длинное("ПроцессорноеВремяТекущее", 6)      // cpu_time_current
			.Длинное("ПроцессорноеВремяЗа5Минут", 6)     // cpu_time_last5min
			.Длинное("ПроцессорноеВремяВсего", 6)        // cpu_time_total
			.Текст("РазделениеДанных", 7)                // data_separation
			.Текст("АдресКлиента", 10);                  // client_ip_address
	КонецЕсли;
	Возврат _Сеанс;
КонецФункции

// ConnectionShortInfo.
Функция Соединение() Экспорт
	Если _Соединение = Неопределено Тогда
		_Соединение = Новый ОписаниеСущностиSWP("Соединение")
			.УИД("Ид")                        // uuid
			.Текст("Приложение")              // application
			.Целое("БлокированоБлокировками") // blocked_by_ls
			.Время("Подключено")              // connected_at
			.Целое("Номер")                   // id
			.Текст("Хост")                    // host
			.УИД("ИдБазы")                    // infobase_id
			.УИД("ИдПроцесса")                // process_id
			.Целое("НомерСеанса");            // session_id
	КонецЕсли;
	Возврат _Соединение;
КонецФункции

// LockInfo.
Функция Блокировка() Экспорт
	Если _Блокировка = Неопределено Тогда
		_Блокировка = Новый ОписаниеСущностиSWP("Блокировка")
			.УИД("ИдСоединения") // connection_id
			.Текст("Описание")   // description
			.Время("Установлена") // locked_at
			.УИД("ИдОбъекта")    // object_id
			.УИД("ИдСеанса");    // session_id
	КонецЕсли;
	Возврат _Блокировка;
КонецФункции

// AdminInfo.
Функция Администратор() Экспорт
	Если _Администратор = Неопределено Тогда
		_Администратор = Новый ОписаниеСущностиSWP("Администратор")
			.Текст("Имя")                        // name
			.Текст("Описание")                   // descr
			.Текст("Пароль")                     // password
			.Флаг("АутентификацияПаролем", 0, Истина) // password_auth_allowed
			.Флаг("АутентификацияОС")            // sys_auth_allowed
			.Текст("ПользовательОС");            // sys_user_name
	КонецЕсли;
	Возврат _Администратор;
КонецФункции
