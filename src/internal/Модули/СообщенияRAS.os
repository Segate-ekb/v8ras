// Сервис администрирования кластера 1С поверх SWP: имя, известные версии и коды запросов.
// Коды — из v8platform/protos (rasapis/ras/messages/v1/types.proto); ответ с данными приходит
// с кодом запроса + 1, команды отвечают пустым сообщением.
#native

Функция ИмяСервиса() Экспорт
	Возврат "v8.service.Admin.Cluster";
КонецФункции

// Версии сервиса, которые знает библиотека, по возрастанию; последняя — предпочитаемая.
// Сервер принимает и более старые версии, поэтому последняя известная работает с новыми платформами,
// пока сервер её поддерживает.
Функция ИзвестныеВерсии() Экспорт
	Возврат СтрРазделить("3.0,4.0,5.0,6.0,7.0,8.0,9.0,10.0,11.0,12.0,13.0,14.0,15.0,16.0,17.0,18.0,19.0,20.0,21.0,22.0", ",");
КонецФункции

// Первая платформа 1С, чей сервер согласует версию сервиса, например 9 → "8.3.16"; "" — неизвестна.
Функция Платформа(Знач Версия) Экспорт
	Для Каждого Пара Из СтрРазделить("4=8.3.11 5=8.3.12 6=8.3.13 7=8.3.14 8=8.3.15 9=8.3.16 10=8.3.17 11=8.3.20 12=8.3.23 13=8.3.24 14=8.3.25 15=8.3.26 16=8.3.27 22=8.3.27.2342", " ") Цикл
		Если СтрНачинаетсяС(Пара, Формат(Версия, "ЧГ=0") + "=") Тогда
			Возврат Сред(Пара, СтрНайти(Пара, "=") + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

#Область Агент

