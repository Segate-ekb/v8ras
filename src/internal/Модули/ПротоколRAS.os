// Константы бинарного протокола RAS 1С: магия, версии, имя сервиса, коды пакетов и сообщений.
// Значения выверены по открытым реализациям протокола; расхождения ловит прогон против живого RAS.

// Магическое число первого пакета NEGOTIATE (0x1c535750).
Функция Магия() Экспорт
	Возврат 475223888;
КонецФункции

// Версия транспортного протокола RAS.
Функция ВерсияПротокола() Экспорт
	Возврат 256;
КонецФункции

// Версия кодека значений.
Функция ВерсияКодека() Экспорт
	Возврат 256;
КонецФункции

// Имя административного сервиса кластера.
Функция ИмяСервиса() Экспорт
	Возврат "v8.service.Admin.Cluster";
КонецФункции

// Известные версии сервиса администрирования по возрастанию. Последняя — предпочитаемая.
// Сервер поддерживает диапазон версий вниз от своей; запрос последней известной
// работает и против более нового сервера, пока его нижняя граница её не переросла.
Функция ИзвестныеВерсии() Экспорт
	Возврат СтрРазделить("3.0,4.0,5.0,6.0,7.0,8.0,9.0,10.0", ",");
КонецФункции

// Предпочитаемая (последняя известная) версия сервиса.
Функция ПредпочитаемаяВерсия() Экспорт
	Список = ИзвестныеВерсии();
	Возврат Список[Список.ВГраница()];
КонецФункции

