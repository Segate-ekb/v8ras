// Разбор сущностей администрирования кластера из ответа RAS. Порядок полей и
// версионные добавления выверены по открытым описаниям протокола. Поля читаются
// строго по порядку (смещения важны); в структуру выносится набор, полезный для метрик.

// Разбирает список кластеров.
//
// Параметры:
//   Читатель - БуферЧтения - полезная нагрузка ответа GET_CLUSTERS.
//   Версия   - Число        - версия сериализации конечной точки.
//
// Возвращаемое значение:
//   Массив из Структура - Ид, Хост, Порт, Имя, УровеньБезопасности.
Функция РазобратьКластеры(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Читатель.ПрочитатьЦелое(); // expiration_timeout
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Читатель.ПрочитатьЦелое(); // life_time_limit
		Элемент.Вставить("Порт", Читатель.ПрочитатьКороткое());
		Читатель.ПрочитатьЦелое(); // max_memory_size
		Читатель.ПрочитатьЦелое(); // max_memory_time_limit
		Элемент.Вставить("Имя", Читатель.ПрочитатьТекст());
		Элемент.Вставить("УровеньБезопасности", Читатель.ПрочитатьЦелое());
		Читатель.ПрочитатьЦелое(); // session_fault_tolerance_level
		Читатель.ПрочитатьЦелое(); // load_balancing_mode
		Читатель.ПрочитатьЦелое(); // errors_count_threshold
		Читатель.ПрочитатьФлаг();   // kill_problem_processes
		Если Версия > 8 Тогда
			Читатель.ПрочитатьФлаг(); // kill_by_memory_with_dump
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает список сеансов.
//
// Параметры:
//   Читатель - БуферЧтения - полезная нагрузка ответа GET_SESSIONS/GET_INFOBASE_SESSIONS.
//   Версия   - Число        - версия сериализации конечной точки.
//
// Возвращаемое значение:
//   Массив из Структура - идентификаторы, хост, пользователь, память, вызовы, длительности,
//                         процессорное время, число лицензий и прочее, полезное для метрик.
Функция РазобратьСеансы(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Приложение", Читатель.ПрочитатьТекст());
		Элемент.Вставить("БлокировокСУБД", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("БлокировокУУ", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("БайтВсего", Читатель.ПрочитатьДлинное());
		Читатель.ПрочитатьДлинное(); // bytes_last5min
		Элемент.Вставить("ВызововВсего", Читатель.ПрочитатьЦелое());
		Читатель.ПрочитатьДлинное(); // calls_last5min
		Элемент.Вставить("ИдСоединения", Читатель.ПрочитатьУИД());
		Читатель.ПрочитатьДлинное(); // dbms_bytes_all
		Читатель.ПрочитатьДлинное(); // dbms_bytes_last5min
		Читатель.ПрочитатьТекст();    // db_proc_info
		Читатель.ПрочитатьЦелое();    // db_proc_took
		Читатель.ПрочитатьВремя();    // db_proc_took_at
		Элемент.Вставить("ДлительностьВсего", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ДлительностьВсегоСУБД", Читатель.ПрочитатьЦелое());
		Читатель.ПрочитатьЦелое();    // duration_current
		Читатель.ПрочитатьЦелое();    // duration_current_dbms
		Читатель.ПрочитатьДлинное();  // duration_last5min
		Читатель.ПрочитатьДлинное();  // duration_last5min_dbms
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ИдБазы", Читатель.ПрочитатьУИД());
		Элемент.Вставить("ПоследняяАктивность", Читатель.ПрочитатьВремя());
		Элемент.Вставить("Спящий", Читатель.ПрочитатьФлаг());
		Читатель.ПрочитатьЦелое();    // passive_session_hibernate_time
		Читатель.ПрочитатьЦелое();    // hibernate_session_terminate_time
		Элемент.Вставить("ЧислоЛицензий", ПропуститьЛицензии(Читатель));
		Элемент.Вставить("Локаль", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ИдПроцесса", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Номер", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Старт", Читатель.ПрочитатьВремя());
		Элемент.Вставить("ИмяПользователя", Читатель.ПрочитатьТекст());
		Если Версия >= 4 Тогда
			Элемент.Вставить("ПамятьТекущая", Читатель.ПрочитатьДлинное());
			Читатель.ПрочитатьДлинное(); // memory_last5min
			Элемент.Вставить("ПамятьВсего", Читатель.ПрочитатьДлинное());
			Элемент.Вставить("ЧтениеТекущее", Читатель.ПрочитатьДлинное());
			Читатель.ПрочитатьДлинное(); // read_last5min
			Элемент.Вставить("ЧтениеВсего", Читатель.ПрочитатьДлинное());
			Элемент.Вставить("ЗаписьТекущая", Читатель.ПрочитатьДлинное());
			Читатель.ПрочитатьДлинное(); // write_last5min
			Элемент.Вставить("ЗаписьВсего", Читатель.ПрочитатьДлинное());
		КонецЕсли;
		Если Версия >= 5 Тогда
			Читатель.ПрочитатьЦелое();   // duration_current_service
			Читатель.ПрочитатьДлинное(); // duration_last5min_service
			Читатель.ПрочитатьЦелое();   // duration_all_service
			Читатель.ПрочитатьТекст();   // current_service_name
		КонецЕсли;
		Если Версия >= 6 Тогда
			Читатель.ПрочитатьДлинное(); // cpu_time_current
			Читатель.ПрочитатьДлинное(); // cpu_time_last5min
			Элемент.Вставить("ПроцессорноеВремяВсего", Читатель.ПрочитатьДлинное());
		КонецЕсли;
		Если Версия >= 7 Тогда
			Читатель.ПрочитатьТекст();   // data_separation
		КонецЕсли;
		Если Версия >= 10 Тогда
			Элемент.Вставить("АдресКлиента", Читатель.ПрочитатьТекст());
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает короткий список соединений.
//
// Параметры:
//   Читатель - БуферЧтения - полезная нагрузка ответа GET_CONNECTIONS_SHORT.
//   Версия   - Число        - версия сериализации (поля соединения от версии не зависят).
//
// Возвращаемое значение:
//   Массив из Структура - Ид, Приложение, Хост, ИдБазы, ИдПроцесса, Номер, ПодключенВ, НомерСеанса.
Функция РазобратьСоединения(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Приложение", Читатель.ПрочитатьТекст());
		Элемент.Вставить("БлокировокУУ", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ПодключенВ", Читатель.ПрочитатьВремя());
		Элемент.Вставить("Номер", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ИдБазы", Читатель.ПрочитатьУИД());
		Элемент.Вставить("ИдПроцесса", Читатель.ПрочитатьУИД());
		Элемент.Вставить("НомерСеанса", Читатель.ПрочитатьЦелое());
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пропускает встроенный список лицензий, возвращая его размер.
Функция ПропуститьЛицензии(Знач Читатель)
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Читатель.ПрочитатьТекст(); // full_name
		Читатель.ПрочитатьТекст(); // full_presentation
		Читатель.ПрочитатьФлаг();   // issued_by_server
		Читатель.ПрочитатьЦелое();  // license_type
		Читатель.ПрочитатьЦелое();  // max_users_all
		Читатель.ПрочитатьЦелое();  // max_users_cur
		Читатель.ПрочитатьФлаг();   // net
		Читатель.ПрочитатьТекст();  // rmngr_address
		Читатель.ПрочитатьТекст();  // rmngr_pid
		Читатель.ПрочитатьЦелое();  // rmngr_port
		Читатель.ПрочитатьТекст();  // series
		Читатель.ПрочитатьТекст();  // short_presentation
	КонецЦикла;
	Возврат Количество;
КонецФункции
