// Разбор сущностей администрирования кластера из ответа RAS. Порядок полей и
// версионные добавления выверены по открытым описаниям протокола. Поля читаются
// строго по порядку (смещения важны); в структуру выносится набор, полезный для метрик.

// Разбирает список кластеров.
//
// Параметры:
//   Читатель - БуферЧтения - полезная нагрузка ответа GET_CLUSTERS.
//   Версия   - Число        - версия сериализации конечной точки.
//
// Возвращаемое значение:
//   Массив из Структура - Ид, Хост, Порт, Имя, УровеньБезопасности.
Функция РазобратьКластеры(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Читатель.ПрочитатьЦелое(); // expiration_timeout
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Читатель.ПрочитатьЦелое(); // life_time_limit
		Элемент.Вставить("Порт", Читатель.ПрочитатьКороткое());
		Читатель.ПрочитатьЦелое(); // max_memory_size
		Читатель.ПрочитатьЦелое(); // max_memory_time_limit
		Элемент.Вставить("Имя", Читатель.ПрочитатьТекст());
		Элемент.Вставить("УровеньБезопасности", Читатель.ПрочитатьЦелое());
		Читатель.ПрочитатьЦелое(); // session_fault_tolerance_level
		Читатель.ПрочитатьЦелое(); // load_balancing_mode
		Читатель.ПрочитатьЦелое(); // errors_count_threshold
		Читатель.ПрочитатьФлаг();   // kill_problem_processes
		Если Версия > 8 Тогда
			Читатель.ПрочитатьФлаг(); // kill_by_memory_with_dump
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает список сеансов.
//
// Параметры:
//   Читатель - БуферЧтения - полезная нагрузка ответа GET_SESSIONS/GET_INFOBASE_SESSIONS.
//   Версия   - Число        - версия сериализации конечной точки.
//
// Возвращаемое значение:
//   Массив из Структура - идентификаторы, хост, пользователь, память, вызовы, длительности,
//                         процессорное время, число лицензий и прочее, полезное для метрик.
Функция РазобратьСеансы(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Приложение", Читатель.ПрочитатьТекст());
		Элемент.Вставить("БлокировокСУБД", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("БлокировокУУ", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("БайтВсего", Читатель.ПрочитатьДлинное());
		Читатель.ПрочитатьДлинное(); // bytes_last5min
		Элемент.Вставить("ВызововВсего", Читатель.ПрочитатьЦелое());
		Читатель.ПрочитатьДлинное(); // calls_last5min
		Элемент.Вставить("ИдСоединения", Читатель.ПрочитатьУИД());
		Читатель.ПрочитатьДлинное(); // dbms_bytes_all
		Читатель.ПрочитатьДлинное(); // dbms_bytes_last5min
		Читатель.ПрочитатьТекст();    // db_proc_info
		Читатель.ПрочитатьЦелое();    // db_proc_took
		Читатель.ПрочитатьВремя();    // db_proc_took_at
		Элемент.Вставить("ДлительностьВсего", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ДлительностьВсегоСУБД", Читатель.ПрочитатьЦелое());
		Читатель.ПрочитатьЦелое();    // duration_current
		Читатель.ПрочитатьЦелое();    // duration_current_dbms
		Читатель.ПрочитатьДлинное();  // duration_last5min
		Читатель.ПрочитатьДлинное();  // duration_last5min_dbms
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ИдБазы", Читатель.ПрочитатьУИД());
		Элемент.Вставить("ПоследняяАктивность", Читатель.ПрочитатьВремя());
		Элемент.Вставить("Спящий", Читатель.ПрочитатьФлаг());
		Читатель.ПрочитатьЦелое();    // passive_session_hibernate_time
		Читатель.ПрочитатьЦелое();    // hibernate_session_terminate_time
		Лицензии = РазобратьЛицензии(Читатель);
		Элемент.Вставить("Лицензии", Лицензии);
		Элемент.Вставить("ЧислоЛицензий", Лицензии.Количество());
		Элемент.Вставить("Локаль", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ИдПроцесса", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Номер", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Старт", Читатель.ПрочитатьВремя());
		Элемент.Вставить("ИмяПользователя", Читатель.ПрочитатьТекст());
		Если Версия >= 4 Тогда
			Элемент.Вставить("ПамятьТекущая", Читатель.ПрочитатьДлинное());
			Читатель.ПрочитатьДлинное(); // memory_last5min
			Элемент.Вставить("ПамятьВсего", Читатель.ПрочитатьДлинное());
			Элемент.Вставить("ЧтениеТекущее", Читатель.ПрочитатьДлинное());
			Читатель.ПрочитатьДлинное(); // read_last5min
			Элемент.Вставить("ЧтениеВсего", Читатель.ПрочитатьДлинное());
			Элемент.Вставить("ЗаписьТекущая", Читатель.ПрочитатьДлинное());
			Читатель.ПрочитатьДлинное(); // write_last5min
			Элемент.Вставить("ЗаписьВсего", Читатель.ПрочитатьДлинное());
		КонецЕсли;
		Если Версия >= 5 Тогда
			Читатель.ПрочитатьЦелое();   // duration_current_service
			Читатель.ПрочитатьДлинное(); // duration_last5min_service
			Читатель.ПрочитатьЦелое();   // duration_all_service
			Читатель.ПрочитатьТекст();   // current_service_name
		КонецЕсли;
		Если Версия >= 6 Тогда
			Читатель.ПрочитатьДлинное(); // cpu_time_current
			Читатель.ПрочитатьДлинное(); // cpu_time_last5min
			Элемент.Вставить("ПроцессорноеВремяВсего", Читатель.ПрочитатьДлинное());
		КонецЕсли;
		Если Версия >= 7 Тогда
			Читатель.ПрочитатьТекст();   // data_separation
		КонецЕсли;
		Если Версия >= 10 Тогда
			Элемент.Вставить("АдресКлиента", Читатель.ПрочитатьТекст());
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает короткий список соединений.
//
// Параметры:
//   Читатель - БуферЧтения - полезная нагрузка ответа GET_CONNECTIONS_SHORT.
//   Версия   - Число        - версия сериализации (поля соединения от версии не зависят).
//
// Возвращаемое значение:
//   Массив из Структура - Ид, Приложение, Хост, ИдБазы, ИдПроцесса, Номер, ПодключенВ, НомерСеанса.
Функция РазобратьСоединения(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Приложение", Читатель.ПрочитатьТекст());
		Элемент.Вставить("БлокировокУУ", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ПодключенВ", Читатель.ПрочитатьВремя());
		Элемент.Вставить("Номер", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ИдБазы", Читатель.ПрочитатьУИД());
		Элемент.Вставить("ИдПроцесса", Читатель.ПрочитатьУИД());
		Элемент.Вставить("НомерСеанса", Читатель.ПрочитатьЦелое());
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает встроенный список лицензий.
//
// Возвращаемое значение:
//   Массив из Структура - Серия, ВсегоЛицензий (max_users_all), ЗанятоЛицензий (max_users_cur),
//                         ВыданаСервером, Сетевая, Тип, ПолноеПредставление.
Функция РазобратьЛицензии(Знач Читатель) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Читатель.ПрочитатьТекст(); // full_name
		Элемент.Вставить("ПолноеПредставление", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ВыданаСервером", Читатель.ПрочитатьФлаг());
		Элемент.Вставить("Тип", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ВсегоЛицензий", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ЗанятоЛицензий", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Сетевая", Читатель.ПрочитатьФлаг());
		Читатель.ПрочитатьТекст(); // rmngr_address
		Читатель.ПрочитатьТекст(); // rmngr_pid
		Читатель.ПрочитатьЦелое();  // rmngr_port
		Элемент.Вставить("Серия", Читатель.ПрочитатьТекст());
		Читатель.ПрочитатьТекст(); // short_presentation
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает список рабочих процессов.
//
// Параметры:
//   Читатель - БуферЧтения - полезная нагрузка ответа GET_WORKING_PROCESSES.
//   Версия   - Число        - версия сериализации конечной точки.
//
// Возвращаемое значение:
//   Массив из Структура - Ид, Хост, Порт, Pid, Включён, Запущен, Используется, Соединения,
//                         ПамятьБайт, ДоступнаяПроизводительность, средние длительности вызовов,
//                         ЧислоЛицензий и список Лицензии.
Функция РазобратьПроцессы(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Читатель.ПрочитатьДвойное(); // avg_back_call_time
		Элемент.Вставить("СредняяДлительностьВызова", Читатель.ПрочитатьДвойное());
		Читатель.ПрочитатьДвойное(); // avg_db_call_time
		Читатель.ПрочитатьДвойное(); // avg_lock_call_time
		Элемент.Вставить("СредняяДлительностьСерверногоВызова", Читатель.ПрочитатьДвойное());
		Элемент.Вставить("СреднееЧислоПотоков", Читатель.ПрочитатьДвойное());
		Читатель.ПрочитатьЦелое();   // capacity
		Элемент.Вставить("Соединения", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Включён", Читатель.ПрочитатьФлаг());
		Лицензии = РазобратьЛицензии(Читатель);
		Элемент.Вставить("Лицензии", Лицензии);
		Элемент.Вставить("ЧислоЛицензий", Лицензии.Количество());
		Элемент.Вставить("Порт", Читатель.ПрочитатьКороткое());
		Читатель.ПрочитатьЦелое();   // memory_excess_time
		Элемент.Вставить("ПамятьБайт", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Pid", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Запущен", Читатель.ПрочитатьЦелое() = 1);
		Читатель.ПрочитатьЦелое();   // selection_size
		Элемент.Вставить("Старт", Читатель.ПрочитатьВремя());
		Элемент.Вставить("Используется", Читатель.ПрочитатьЦелое() = 1);
		Элемент.Вставить("ДоступнаяПроизводительность", Читатель.ПрочитатьЦелое());
		Если Версия >= 9 Тогда
			Читатель.ПрочитатьФлаг(); // reverse
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает список блокировок (управляемых и объектных).
//
// Параметры:
//   Читатель - БуферЧтения - нагрузка ответа GET_LOCKS/GET_INFOBASE_LOCKS/… .
//   Версия   - Число        - версия сериализации (поля блокировки от версии не зависят).
//
// Возвращаемое значение:
//   Массив из Структура - ИдСоединения, Описание, Заблокировано, ИдОбъекта, ИдСеанса.
Функция РазобратьБлокировки(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("ИдСоединения", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Описание", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Заблокировано", Читатель.ПрочитатьВремя());
		Элемент.Вставить("ИдОбъекта", Читатель.ПрочитатьУИД());
		Элемент.Вставить("ИдСеанса", Читатель.ПрочитатьУИД());
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает список рабочих серверов кластера.
//
// Параметры:
//   Читатель - БуферЧтения - нагрузка ответа GET_WORKING_SERVERS.
//   Версия   - Число        - версия сериализации (от версии 8 добавлены лимиты памяти).
//
// Возвращаемое значение:
//   Массив из Структура - Ид, ХостАгента, ПортАгента, Имя, Главный, лимиты памяти/соединений/инфобаз,
//                         ПортКластера, КритическаяПамять.
Функция РазобратьСерверы(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Элемент.Вставить("ХостАгента", Читатель.ПрочитатьТекст());
		Элемент.Вставить("ПортАгента", Читатель.ПрочитатьКороткое());
		Элемент.Вставить("Имя", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Главный", Читатель.ПрочитатьФлаг());
		Элемент.Вставить("БезопаснаяПамятьПроцессов", Читатель.ПрочитатьДлинное());
		Элемент.Вставить("БезопаснаяПамятьВызова", Читатель.ПрочитатьДлинное());
		Элемент.Вставить("ЛимитИнфобаз", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ЛимитПамяти", Читатель.ПрочитатьДлинное());
		Элемент.Вставить("ЛимитСоединений", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("ПортКластера", Читатель.ПрочитатьКороткое());
		Элемент.Вставить("ВыделенныеМенеджеры", Читатель.ПрочитатьФлаг());
		Диапазонов = Читатель.ПрочитатьРазмер();
		Для Д = 1 По Диапазонов Цикл
			Читатель.ПрочитатьКороткое(); // верхняя граница порта
			Читатель.ПрочитатьКороткое(); // нижняя граница порта
		КонецЦикла;
		Если Версия >= 8 Тогда
			Элемент.Вставить("КритическаяПамять", Читатель.ПрочитатьДлинное());
			Читатель.ПрочитатьДлинное(); // temporary_allowed_total_memory
			Читатель.ПрочитатьДлинное(); // temporary_allowed_total_memory_time_limit
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает список менеджеров кластера (rmngr).
//
// Возвращаемое значение:
//   Массив из Структура - Ид, Описание, Хост, Главный, Порт, Pid.
Функция РазобратьМенеджеры(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Описание", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Хост", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Главный", Читатель.ПрочитатьЦелое());
		Элемент.Вставить("Порт", Читатель.ПрочитатьКороткое());
		Элемент.Вставить("Pid", Читатель.ПрочитатьТекст());
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает короткий список информационных баз.
//
// Возвращаемое значение:
//   Массив из Структура - Ид, Имя, Описание.
Функция РазобратьИнфобазыКратко(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Ид", Читатель.ПрочитатьУИД());
		Элемент.Вставить("Описание", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Имя", Читатель.ПрочитатьТекст());
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Разбирает полную информацию об информационной базе. Возвращает все поля, пригодные
// для обратной записи (ФорматироватьИнформациюОБазы): чтение → правка → обновление.
Функция РазобратьИнформациюОБазы(Знач Читатель, Знач Версия) Экспорт
	Инфо = Новый Структура();
	Инфо.Вставить("Ид", Читатель.ПрочитатьУИД());
	Инфо.Вставить("СмещениеДаты", Читатель.ПрочитатьЦелое());
	Инфо.Вставить("СУБД", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ИмяБД", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ПарольБД", Читатель.ПрочитатьТекст());
	Инфо.Вставить("СерверБД", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ПользовательБД", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ЗапретСДаты", Читатель.ПрочитатьВремя());
	Инфо.Вставить("СообщениеБлокировки", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ПараметрБлокировки", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ЗапретПоДату", Читатель.ПрочитатьВремя());
	Инфо.Вставить("Описание", Читатель.ПрочитатьТекст());
	Инфо.Вставить("Локаль", Читатель.ПрочитатьТекст());
	Инфо.Вставить("Имя", Читатель.ПрочитатьТекст());
	Инфо.Вставить("КодРазрешения", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ЗапретРегламентных", Читатель.ПрочитатьФлаг());
	Инфо.Вставить("УровеньБезопасности", Читатель.ПрочитатьЦелое());
	Инфо.Вставить("ЗапретСеансов", Читатель.ПрочитатьФлаг());
	Инфо.Вставить("РаспределениеЛицензий", Читатель.ПрочитатьЦелое());
	Инфо.Вставить("СтрокаВнешнегоУправленияСеансами", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ВнешнееУправлениеСеансамиОбязательно", Читатель.ПрочитатьФлаг());
	Инфо.Вставить("ПрофильБезопасности", Читатель.ПрочитатьТекст());
	Инфо.Вставить("ПрофильБезопасностиБезопасногоРежима", Читатель.ПрочитатьТекст());
	Инфо.Вставить("РезервироватьРабочиеПроцессы", Ложь);
	Если Версия >= 9 Тогда
		Инфо.РезервироватьРабочиеПроцессы = Читатель.ПрочитатьФлаг();
	КонецЕсли;
	Возврат Инфо;
КонецФункции

// Пишет полную информацию об инфобазе в тело запроса (CREATE_INFOBASE/UPDATE_INFOBASE).
// Порядок полей совпадает с РазобратьИнформациюОБазы.
Процедура ФорматироватьИнформациюОБазы(ЦельБуфер, Знач Инфо, Знач Версия) Экспорт
	ЦельБуфер.УИД(Поле(Инфо, "Ид", "00000000-0000-0000-0000-000000000000"));
	ЦельБуфер.Целое(Поле(Инфо, "СмещениеДаты", 0));
	ЦельБуфер.Текст(Поле(Инфо, "СУБД", ""));
	ЦельБуфер.Текст(Поле(Инфо, "ИмяБД", ""));
	ЦельБуфер.Текст(Поле(Инфо, "ПарольБД", ""));
	ЦельБуфер.Текст(Поле(Инфо, "СерверБД", ""));
	ЦельБуфер.Текст(Поле(Инфо, "ПользовательБД", ""));
	ЦельБуфер.Время(Поле(Инфо, "ЗапретСДаты", '00010101000000'));
	ЦельБуфер.Текст(Поле(Инфо, "СообщениеБлокировки", ""));
	ЦельБуфер.Текст(Поле(Инфо, "ПараметрБлокировки", ""));
	ЦельБуфер.Время(Поле(Инфо, "ЗапретПоДату", '00010101000000'));
	ЦельБуфер.Текст(Поле(Инфо, "Описание", ""));
	ЦельБуфер.Текст(Поле(Инфо, "Локаль", ""));
	ЦельБуфер.Текст(Поле(Инфо, "Имя", ""));
	ЦельБуфер.Текст(Поле(Инфо, "КодРазрешения", ""));
	ЦельБуфер.Флаг(Поле(Инфо, "ЗапретРегламентных", Ложь));
	ЦельБуфер.Целое(Поле(Инфо, "УровеньБезопасности", 0));
	ЦельБуфер.Флаг(Поле(Инфо, "ЗапретСеансов", Ложь));
	ЦельБуфер.Целое(Поле(Инфо, "РаспределениеЛицензий", 0));
	ЦельБуфер.Текст(Поле(Инфо, "СтрокаВнешнегоУправленияСеансами", ""));
	ЦельБуфер.Флаг(Поле(Инфо, "ВнешнееУправлениеСеансамиОбязательно", Ложь));
	ЦельБуфер.Текст(Поле(Инфо, "ПрофильБезопасности", ""));
	ЦельБуфер.Текст(Поле(Инфо, "ПрофильБезопасностиБезопасногоРежима", ""));
	Если Версия >= 9 Тогда
		ЦельБуфер.Флаг(Поле(Инфо, "РезервироватьРабочиеПроцессы", Ложь));
	КонецЕсли;
КонецПроцедуры

Функция Поле(Знач Инфо, Знач Ключ, Знач Умолчание)
	Если Инфо.Свойство(Ключ) Тогда
		Возврат Инфо[Ключ];
	КонецЕсли;
	Возврат Умолчание;
КонецФункции

// Разбирает список администраторов (кластера или агента).
//
// Возвращаемое значение:
//   Массив из Структура - Имя, Описание, ПарольРазрешён, СистемнаяАутентификация, СистемныйПользователь.
Функция РазобратьАдминистраторов(Знач Читатель, Знач Версия) Экспорт
	Результат = Новый Массив;
	Количество = Читатель.ПрочитатьРазмер();
	Для Сч = 1 По Количество Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("Имя", Читатель.ПрочитатьТекст());
		Элемент.Вставить("Описание", Читатель.ПрочитатьТекст());
		Читатель.ПрочитатьТекст(); // password (в ответе пустой)
		Элемент.Вставить("ПарольРазрешён", Читатель.ПрочитатьФлаг());
		Элемент.Вставить("СистемнаяАутентификация", Читатель.ПрочитатьФлаг());
		Элемент.Вставить("СистемныйПользователь", Читатель.ПрочитатьТекст());
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пишет администратора (AdminInfo) в тело запроса регистрации.
Процедура ФорматироватьАдминистратора(ЦельБуфер, Знач Админ) Экспорт
	ЦельБуфер.Текст(Поле(Админ, "Имя", ""));
	ЦельБуфер.Текст(Поле(Админ, "Описание", ""));
	ЦельБуфер.Текст(Поле(Админ, "Пароль", ""));
	ЦельБуфер.Флаг(Поле(Админ, "ПарольРазрешён", Истина));
	ЦельБуфер.Флаг(Поле(Админ, "СистемнаяАутентификация", Ложь));
	ЦельБуфер.Текст(Поле(Админ, "СистемныйПользователь", ""));
КонецПроцедуры

// Пишет описание кластера (ClusterInfo) в тело запроса регистрации.
Процедура ФорматироватьКластер(ЦельБуфер, Знач Инфо, Знач Версия) Экспорт
	ЦельБуфер.УИД(Поле(Инфо, "Ид", "00000000-0000-0000-0000-000000000000"));
	ЦельБуфер.Целое(Поле(Инфо, "СрокЗавершенияПростоя", 0));
	ЦельБуфер.Текст(Поле(Инфо, "Хост", ""));
	ЦельБуфер.Целое(Поле(Инфо, "ПределВремениЖизни", 0));
	ЦельБуфер.Короткое(Поле(Инфо, "Порт", 1541));
	ЦельБуфер.Целое(Поле(Инфо, "МаксПамять", 0));
	ЦельБуфер.Целое(Поле(Инфо, "МаксПамятьПредел", 0));
	ЦельБуфер.Текст(Поле(Инфо, "Имя", ""));
	ЦельБуфер.Целое(Поле(Инфо, "УровеньБезопасности", 0));
	ЦельБуфер.Целое(Поле(Инфо, "УровеньОтказоустойчивости", 0));
	ЦельБуфер.Целое(Поле(Инфо, "РежимБалансировки", 0));
	ЦельБуфер.Целое(Поле(Инфо, "ПорогОшибок", 0));
	ЦельБуфер.Флаг(Поле(Инфо, "УбиватьПроблемные", Ложь));
	Если Версия > 8 Тогда
		ЦельБуфер.Флаг(Поле(Инфо, "УбиватьПоПамятиСДампом", Ложь));
	КонецЕсли;
КонецПроцедуры

// Пишет описание рабочего сервера (ServerInfo) в тело запроса регистрации.
Процедура ФорматироватьСервер(ЦельБуфер, Знач Инфо, Знач Версия) Экспорт
	ЦельБуфер.УИД(Поле(Инфо, "Ид", "00000000-0000-0000-0000-000000000000"));
	ЦельБуфер.Текст(Поле(Инфо, "ХостАгента", ""));
	ЦельБуфер.Короткое(Поле(Инфо, "ПортАгента", 1540));
	ЦельБуфер.Текст(Поле(Инфо, "Имя", ""));
	ЦельБуфер.Флаг(Поле(Инфо, "Главный", Ложь));
	ЦельБуфер.Длинное(Поле(Инфо, "БезопаснаяПамятьПроцессов", 0));
	ЦельБуфер.Длинное(Поле(Инфо, "БезопаснаяПамятьВызова", 0));
	ЦельБуфер.Целое(Поле(Инфо, "ЛимитИнфобаз", 0));
	ЦельБуфер.Длинное(Поле(Инфо, "ЛимитПамяти", 0));
	ЦельБуфер.Целое(Поле(Инфо, "ЛимитСоединений", 0));
	ЦельБуфер.Короткое(Поле(Инфо, "ПортКластера", 1541));
	ЦельБуфер.Флаг(Поле(Инфо, "ВыделенныеМенеджеры", Ложь));
	Диапазоны = Поле(Инфо, "ДиапазоныПортов", Новый Массив);
	ЦельБуфер.Размер(Диапазоны.Количество());
	Для Каждого Диапазон Из Диапазоны Цикл
		ЦельБуфер.Короткое(Поле(Диапазон, "Верхний", 1591));
		ЦельБуфер.Короткое(Поле(Диапазон, "Нижний", 1560));
	КонецЦикла;
	Если Версия >= 8 Тогда
		ЦельБуфер.Длинное(Поле(Инфо, "КритическаяПамять", 0));
		ЦельБуфер.Длинное(Поле(Инфо, "ВременнаяПамять", 0));
		ЦельБуфер.Длинное(Поле(Инфо, "ВременнаяПамятьПредел", 0));
	КонецЕсли;
КонецПроцедуры
