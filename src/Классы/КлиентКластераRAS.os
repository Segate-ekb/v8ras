// Клиент сервера администрирования кластера 1С (RAS) на чистом OneScript: бинарный протокол SWP
// напрямую, без rac и без платформы; версия сервиса определяется при подключении.
#Использовать "../swp"
#Использовать "../internal"
#native

Перем _Хост;           // Строка
Перем _Порт;           // Число
Перем _ЖелаемаяВерсия; // Строка, Неопределено
Перем _ТаймаутМс;      // Число — предел ожидания ответа сервера
Перем _Канал;          // КаналSWP
Перем _Точка;          // КонечнаяТочкаSWP
Перем _ВерсияСервиса;  // Строка

// Подключается к RAS и открывает конечную точку администрирования.
//
// Параметры:
//   Сокет - Неопределено, Объект - готовый сокет (TCPСоединение или совместимый); Неопределено —
//           открыть TCP-соединение к Хост:Порт с таймаутом из конструктора.
//
// Возвращаемое значение:
//   КлиентКластераRAS - этот объект.
Функция Подключить(Знач Сокет = Неопределено) Экспорт
	Если Сокет = Неопределено Тогда
		Сокет = Новый TCPСоединение(_Хост, _Порт);
		Сокет.ТаймаутЧтения = _ТаймаутМс;
		Сокет.ТаймаутОтправки = _ТаймаутМс;
	КонецЕсли;
	_Канал = Новый КаналSWP(Сокет);
	Рукопожатие = Новый РукопожатиеSWP(_Канал);
	Сеанс = Рукопожатие.ОткрытьСеанс(СообщенияRAS.ИмяСервиса(), СообщенияRAS.ИзвестныеВерсии(), _ЖелаемаяВерсия);
	_ВерсияСервиса = Сеанс.ВерсияСервиса;
	_Точка = Новый КонечнаяТочкаSWP(_Канал, Сеанс.ИдКонечнойТочки, Сеанс.ВерсияКонечнойТочки);
	Возврат ЭтотОбъект;
КонецФункции

// Согласованная версия сервиса администрирования, например "10.0".
Функция ВерсияСервиса() Экспорт
	Возврат _ВерсияСервиса;
КонецФункции

// Версия платформы 1С на сервере, например "8.3.27.1859". Доступно с платформы 8.3.16.
Функция ВерсияАгента() Экспорт
	ТребуетВерсию(9, "ВерсияАгента");
	Возврат Текст(СообщенияRAS.GET_AGENT_VERSION());
КонецФункции

// Закрывает соединение с RAS.
Процедура Отключить() Экспорт
	Если _Канал = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		_Канал.Закрыть();
	Исключение
		// соединение уже разорвано — закрывать нечего
	КонецПопытки;
	_Канал = Неопределено;
	_Точка = Неопределено;
КонецПроцедуры

#Область Аутентификация

// Администратор агента: нужен для операций уровня агента (админы агента, регистрация кластеров).
Процедура АутентифицироватьАгент(Знач Пользователь, Знач Пароль) Экспорт
	Команда(СообщенияRAS.AUTHENTICATE_AGENT(), Новый БуферЗаписиSWP().Текст(Пользователь).Текст(Пароль));
КонецПроцедуры

// Администратор кластера: нужен для чтения и управления объектами кластера.
Процедура АутентифицироватьКластер(Знач ИдКластера, Знач Пользователь, Знач Пароль) Экспорт
	Команда(СообщенияRAS.AUTHENTICATE_CLUSTER(), УИДы(ИдКластера).Текст(Пользователь).Текст(Пароль));
КонецПроцедуры

// Пользователь информационной базы: нужен для операций с базой.
Процедура АутентифицироватьБазу(Знач ИдКластера, Знач Пользователь, Знач Пароль) Экспорт
	Команда(СообщенияRAS.ADD_AUTHENTICATION(), УИДы(ИдКластера).Текст(Пользователь).Текст(Пароль));
КонецПроцедуры

#КонецОбласти

#Область Чтение

// Кластеры агента. Поля — см. СхемыRAS.Кластер.
Функция Кластеры() Экспорт
	Возврат Список(СообщенияRAS.GET_CLUSTERS(), Неопределено, СхемыRAS.Кластер());
КонецФункции

// Менеджеры кластера (rmngr). Поля — см. СхемыRAS.Менеджер.
Функция Менеджеры(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_CLUSTER_MANAGERS(), УИДы(ИдКластера), СхемыRAS.Менеджер());
КонецФункции

// Рабочие серверы кластера. Поля — см. СхемыRAS.Сервер.
Функция РабочиеСерверы(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_WORKING_SERVERS(), УИДы(ИдКластера), СхемыRAS.Сервер());
КонецФункции

// Рабочие процессы кластера. Поля — см. СхемыRAS.Процесс.
Функция РабочиеПроцессы(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_WORKING_PROCESSES(), УИДы(ИдКластера), СхемыRAS.Процесс());
КонецФункции

// Информационные базы кластера, кратко. Поля — см. СхемыRAS.БазаКратко.
Функция Инфобазы(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_INFOBASES_SHORT(), УИДы(ИдКластера), СхемыRAS.БазаКратко());
КонецФункции

// Полное описание информационной базы; годится для обратной передачи в ОбновитьБазу.
Функция ИнформацияОБазе(Знач ИдКластера, Знач ИдБазы) Экспорт
	Возврат Сущность(СообщенияRAS.GET_INFOBASE_INFO(), УИДы(ИдКластера, ИдБазы), СхемыRAS.База());
КонецФункции

// Сеансы кластера. Поля — см. СхемыRAS.Сеанс.
Функция Сеансы(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_SESSIONS(), УИДы(ИдКластера), СхемыRAS.Сеанс());
КонецФункции

// Соединения кластера. Поля — см. СхемыRAS.Соединение.
Функция Соединения(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_CONNECTIONS_SHORT(), УИДы(ИдКластера), СхемыRAS.Соединение());
КонецФункции

// Блокировки кластера. Поля — см. СхемыRAS.Блокировка.
Функция Блокировки(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_LOCKS(), УИДы(ИдКластера), СхемыRAS.Блокировка());
КонецФункции

// Блокировки информационной базы.
Функция БлокировкиБазы(Знач ИдКластера, Знач ИдБазы) Экспорт
	Возврат Список(СообщенияRAS.GET_INFOBASE_LOCKS(), УИДы(ИдКластера, ИдБазы), СхемыRAS.Блокировка());
КонецФункции

// Блокировки соединения.
Функция БлокировкиСоединения(Знач ИдКластера, Знач ИдСоединения) Экспорт
	Возврат Список(СообщенияRAS.GET_CONNECTION_LOCKS(), УИДы(ИдКластера, ИдСоединения), СхемыRAS.Блокировка());
КонецФункции

// Блокировки сеанса.
Функция БлокировкиСеанса(Знач ИдКластера, Знач ИдБазы, Знач ИдСеанса) Экспорт
	Возврат Список(СообщенияRAS.GET_SESSION_LOCKS(), УИДы(ИдКластера, ИдБазы, ИдСеанса), СхемыRAS.Блокировка());
КонецФункции

// Администраторы кластера. Поля — см. СхемыRAS.Администратор.
Функция АдминистраторыКластера(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_CLUSTER_ADMINS(), УИДы(ИдКластера), СхемыRAS.Администратор());
КонецФункции

// Администраторы агента. Требует аутентификации агента.
Функция АдминистраторыАгента() Экспорт
	Возврат Список(СообщенияRAS.GET_AGENT_ADMINS(), Неопределено, СхемыRAS.Администратор());
КонецФункции

// Сервисы кластера с менеджерами, на которых они работают. Поля — см. СхемыRAS.Сервис.
Функция Сервисы(Знач ИдКластера) Экспорт
	Возврат Список(СообщенияRAS.GET_CLUSTER_SERVICES(), УИДы(ИдКластера), СхемыRAS.Сервис());
КонецФункции

#КонецОбласти

#Область УправлениеБазами

// Создаёт информационную базу.
//
// Параметры:
//   ИдКластера - Строка    - UUID кластера.
//   Инфо       - Структура - поля базы (см. СхемыRAS.База); незаданные — по умолчанию.
//   Режим      - Число     - 1 создать базу в СУБД, 0 только зарегистрировать.
//
// Возвращаемое значение:
//   Строка - UUID созданной базы.
Функция СоздатьБазу(Знач ИдКластера, Знач Инфо, Знач Режим = 1) Экспорт
	Тело = УИДы(ИдКластера).Сущность(СхемыRAS.База(), Инфо, _Точка.Версия()).Целое(Режим);
	Возврат Идентификатор(СообщенияRAS.CREATE_INFOBASE(), Тело);
КонецФункции

// Обновляет информационную базу структурой полей целиком (см. ИнформацияОБазе).
Процедура ОбновитьБазу(Знач ИдКластера, Знач Инфо) Экспорт
	Команда(СообщенияRAS.UPDATE_INFOBASE(), УИДы(ИдКластера).Сущность(СхемыRAS.База(), Инфо, _Точка.Версия()));
КонецПроцедуры

// Удаляет информационную базу.
//
// Параметры:
//   Режим - Число - 0 только снять с регистрации, 1 удалить базу данных, 2 очистить базу данных.
Процедура УдалитьБазу(Знач ИдКластера, Знач ИдБазы, Знач Режим = 0) Экспорт
	Команда(СообщенияRAS.DROP_INFOBASE(), УИДы(ИдКластера, ИдБазы).Целое(Режим));
КонецПроцедуры

// Включает блокировку начала сеансов в базе.
Процедура ЗаблокироватьСеансы(Знач ИдКластера, Знач ИдБазы, Знач Сообщение = "", Знач КодРазрешения = "") Экспорт
	Инфо = ИнформацияОБазе(ИдКластера, ИдБазы);
	Инфо.БлокировкаСеансов = Истина;
	Инфо.СообщениеБлокировки = Сообщение;
	Инфо.КодРазрешения = КодРазрешения;
	ОбновитьБазу(ИдКластера, Инфо);
КонецПроцедуры

// Снимает блокировку начала сеансов в базе.
Процедура РазблокироватьСеансы(Знач ИдКластера, Знач ИдБазы) Экспорт
	Инфо = ИнформацияОБазе(ИдКластера, ИдБазы);
	Инфо.БлокировкаСеансов = Ложь;
	ОбновитьБазу(ИдКластера, Инфо);
КонецПроцедуры

#КонецОбласти

#Область УправлениеСеансами

// Принудительно завершает сеанс.
Процедура ЗавершитьСеанс(Знач ИдКластера, Знач ИдСеанса, Знач Сообщение = "") Экспорт
	Команда(СообщенияRAS.TERMINATE_SESSION(), УИДы(ИдКластера, ИдСеанса).Текст(Сообщение));
КонецПроцедуры

// Разрывает соединение.
Процедура РазорватьСоединение(Знач ИдКластера, Знач ИдПроцесса, Знач ИдСоединения) Экспорт
	Команда(СообщенияRAS.DISCONNECT(), УИДы(ИдКластера, ИдПроцесса, ИдСоединения));
КонецПроцедуры

#КонецОбласти

#Область УправлениеАдминистраторами

// Регистрирует администратора кластера. Админ — структура (см. СхемыRAS.Администратор).
Процедура ЗарегистрироватьАдминаКластера(Знач ИдКластера, Знач Админ) Экспорт
	Команда(СообщенияRAS.REG_CLUSTER_ADMIN(), УИДы(ИдКластера).Сущность(СхемыRAS.Администратор(), Админ, _Точка.Версия()));
КонецПроцедуры

// Удаляет администратора кластера.
Процедура УдалитьАдминаКластера(Знач ИдКластера, Знач Имя) Экспорт
	Команда(СообщенияRAS.UNREG_CLUSTER_ADMIN(), УИДы(ИдКластера).Текст(Имя));
КонецПроцедуры

// Регистрирует администратора агента.
Процедура ЗарегистрироватьАдминаАгента(Знач Админ) Экспорт
	Команда(СообщенияRAS.REG_AGENT_ADMIN(), Новый БуферЗаписиSWP().Сущность(СхемыRAS.Администратор(), Админ, _Точка.Версия()));
КонецПроцедуры

// Удаляет администратора агента.
Процедура УдалитьАдминаАгента(Знач Имя) Экспорт
	Команда(СообщенияRAS.UNREG_AGENT_ADMIN(), Новый БуферЗаписиSWP().Текст(Имя));
КонецПроцедуры

#КонецОбласти

#Область УправлениеТопологией

// Регистрирует кластер на агенте. Инфо — структура (см. СхемыRAS.Кластер).
//
// Возвращаемое значение:
//   Строка - UUID кластера.
Функция ЗарегистрироватьКластер(Знач Инфо) Экспорт
	Тело = Новый БуферЗаписиSWP().Сущность(СхемыRAS.Кластер(), Инфо, _Точка.Версия());
	Возврат Идентификатор(СообщенияRAS.REG_CLUSTER(), Тело);
КонецФункции

// Снимает кластер с регистрации. Требует прав администратора этого кластера.
Процедура УдалитьКластер(Знач ИдКластера) Экспорт
	Команда(СообщенияRAS.UNREG_CLUSTER(), УИДы(ИдКластера));
КонецПроцедуры

// Регистрирует рабочий сервер в кластере. Инфо — структура (см. СхемыRAS.Сервер).
//
// Возвращаемое значение:
//   Строка - UUID сервера.
Функция ЗарегистрироватьСервер(Знач ИдКластера, Знач Инфо) Экспорт
	Тело = УИДы(ИдКластера).Сущность(СхемыRAS.Сервер(), Инфо, _Точка.Версия());
	Возврат Идентификатор(СообщенияRAS.REG_WORKING_SERVER(), Тело);
КонецФункции

// Снимает рабочий сервер с регистрации.
Процедура УдалитьСервер(Знач ИдКластера, Знач ИдСервера) Экспорт
	Команда(СообщенияRAS.UNREG_WORKING_SERVER(), УИДы(ИдКластера, ИдСервера));
КонецПроцедуры

#КонецОбласти

#Область ТребованияНазначения

// Требования назначения функциональности рабочего сервера. Поля — см. СхемыRAS.ТребованиеНазначения.
Функция ТребованияНазначения(Знач ИдКластера, Знач ИдСервера) Экспорт
	Возврат Список(СообщенияRAS.GET_ASSIGNMENT_RULES(), УИДы(ИдКластера, ИдСервера), СхемыRAS.ТребованиеНазначения());
КонецФункции

// Одно требование назначения по идентификатору.
Функция ТребованиеНазначения(Знач ИдКластера, Знач ИдСервера, Знач ИдТребования) Экспорт
	Возврат Сущность(СообщенияRAS.GET_ASSIGNMENT_RULE_INFO(), УИДы(ИдКластера, ИдСервера, ИдТребования), СхемыRAS.ТребованиеНазначения());
КонецФункции

// Добавляет требование назначения рабочему серверу.
//
// Параметры:
//   ИдКластера - Строка    - UUID кластера.
//   ИдСервера  - Строка    - UUID рабочего сервера.
//   Инфо       - Структура - поля требования (см. СхемыRAS.ТребованиеНазначения); Ид не задают.
//   Позиция    - Число     - место в списке требований сервера с нуля.
//
// Возвращаемое значение:
//   Строка - UUID созданного требования.
Функция ДобавитьТребованиеНазначения(Знач ИдКластера, Знач ИдСервера, Знач Инфо, Знач Позиция = 0) Экспорт
	Тело = УИДы(ИдКластера, ИдСервера).Сущность(СхемыRAS.ТребованиеНазначения(), Инфо, _Точка.Версия()).Целое(Позиция);
	Возврат Идентификатор(СообщенияRAS.REG_ASSIGNMENT_RULE(), Тело);
КонецФункции

// Удаляет требование назначения.
Процедура УдалитьТребованиеНазначения(Знач ИдКластера, Знач ИдСервера, Знач ИдТребования) Экспорт
	Команда(СообщенияRAS.UNREG_ASSIGNMENT_RULE(), УИДы(ИдКластера, ИдСервера, ИдТребования));
КонецПроцедуры

// Применяет требования назначения в кластере.
//
// Параметры:
//   Полностью - Булево - Истина — перераспределить всё, Ложь — только то, что нарушает требования.
Процедура ПрименитьТребованияНазначения(Знач ИдКластера, Знач Полностью = Истина) Экспорт
	Команда(СообщенияRAS.APPLY_ASSIGNMENT_RULES(), УИДы(ИдКластера).Целое(?(Полностью, 1, 0)));
КонецПроцедуры

#КонецОбласти

#Область ПотреблениеРесурсов

// Счётчики потребления ресурсов кластера. Поля — см. СхемыRAS.Счётчик.
Функция Счётчики(Знач ИдКластера) Экспорт
	ТребуетВерсию(4, "Счётчики");
	Возврат Список(СообщенияRAS.GET_RESOURCE_COUNTERS(), УИДы(ИдКластера), СхемыRAS.Счётчик());
КонецФункции

// Счётчик потребления ресурсов по имени.
Функция Счётчик(Знач ИдКластера, Знач Имя) Экспорт
	ТребуетВерсию(4, "Счётчик");
	Возврат Сущность(СообщенияRAS.GET_RESOURCE_COUNTER_INFO(), УИДы(ИдКластера).Текст(Имя), СхемыRAS.Счётчик());
КонецФункции

// Создаёт или обновляет счётчик. Инфо — структура (см. СхемыRAS.Счётчик), ключ — Имя.
Процедура ЗаписатьСчётчик(Знач ИдКластера, Знач Инфо) Экспорт
	ТребуетВерсию(4, "ЗаписатьСчётчик");
	Команда(СообщенияRAS.REG_RESOURCE_COUNTER(), УИДы(ИдКластера).Сущность(СхемыRAS.Счётчик(), Инфо, _Точка.Версия()));
КонецПроцедуры

// Удаляет счётчик по имени.
Процедура УдалитьСчётчик(Знач ИдКластера, Знач Имя) Экспорт
	ТребуетВерсию(4, "УдалитьСчётчик");
	Команда(СообщенияRAS.UNREG_RESOURCE_COUNTER(), УИДы(ИдКластера).Текст(Имя));
КонецПроцедуры

// Текущие значения счётчика по объектам учёта. Поля — см. СхемыRAS.ЗначениеСчётчика.
//
// Параметры:
//   ИдКластера - Строка - UUID кластера.
//   Имя        - Строка - имя счётчика.
//   Объект     - Строка - объект учёта вида "infobase=…;user=…"; "" — все объекты.
Функция ЗначенияСчётчика(Знач ИдКластера, Знач Имя, Знач Объект = "") Экспорт
	ТребуетВерсию(4, "ЗначенияСчётчика");
	Возврат Список(СообщенияRAS.GET_COUNTER_VALUES(), УИДы(ИдКластера).Текст(Имя).Текст(Объект), СхемыRAS.ЗначениеСчётчика());
КонецФункции

// Накопленные значения счётчика по объектам учёта. Параметры — как у ЗначенияСчётчика.
Функция НакопленныеЗначенияСчётчика(Знач ИдКластера, Знач Имя, Знач Объект = "") Экспорт
	ТребуетВерсию(4, "НакопленныеЗначенияСчётчика");
	Возврат Список(СообщенияRAS.GET_COUNTER_ACCUMULATED_VALUES(), УИДы(ИдКластера).Текст(Имя).Текст(Объект), СхемыRAS.ЗначениеСчётчика());
КонецФункции

// Сбрасывает накопленные значения счётчика. Параметры — как у ЗначенияСчётчика.
Процедура ОчиститьЗначенияСчётчика(Знач ИдКластера, Знач Имя, Знач Объект = "") Экспорт
	ТребуетВерсию(4, "ОчиститьЗначенияСчётчика");
	Команда(СообщенияRAS.CLEAR_COUNTER_VALUE(), УИДы(ИдКластера).Текст(Имя).Текст(Объект));
КонецПроцедуры

// Ограничения потребления ресурсов кластера. Поля — см. СхемыRAS.Ограничение.
Функция Ограничения(Знач ИдКластера) Экспорт
	ТребуетВерсию(4, "Ограничения");
	Возврат Список(СообщенияRAS.GET_RESOURCE_LIMITS(), УИДы(ИдКластера), СхемыRAS.Ограничение());
КонецФункции

// Ограничение потребления ресурсов по имени.
Функция Ограничение(Знач ИдКластера, Знач Имя) Экспорт
	ТребуетВерсию(4, "Ограничение");
	Возврат Сущность(СообщенияRAS.GET_RESOURCE_LIMIT_INFO(), УИДы(ИдКластера).Текст(Имя), СхемыRAS.Ограничение());
КонецФункции

// Создаёт или обновляет ограничение. Инфо — структура (см. СхемыRAS.Ограничение), ключ — Имя.
Процедура ЗаписатьОграничение(Знач ИдКластера, Знач Инфо) Экспорт
	ТребуетВерсию(4, "ЗаписатьОграничение");
	Команда(СообщенияRAS.REG_RESOURCE_LIMIT(), УИДы(ИдКластера).Сущность(СхемыRAS.Ограничение(), Инфо, _Точка.Версия()));
КонецПроцедуры

// Удаляет ограничение по имени.
Процедура УдалитьОграничение(Знач ИдКластера, Знач Имя) Экспорт
	ТребуетВерсию(4, "УдалитьОграничение");
	Команда(СообщенияRAS.UNREG_RESOURCE_LIMIT(), УИДы(ИдКластера).Текст(Имя));
КонецПроцедуры

#КонецОбласти

// Запрос, отвечающий списком сущностей; ответ приходит с кодом запроса + 1.
Функция Список(Знач Код, Знач Тело, Знач Описание)
	Возврат _Точка.Запрос(Код, Тело, Код + 1).ПрочитатьСписок(Описание, _Точка.Версия());
КонецФункции

Функция Сущность(Знач Код, Знач Тело, Знач Описание)
	Возврат _Точка.Запрос(Код, Тело, Код + 1).ПрочитатьСущность(Описание, _Точка.Версия());
КонецФункции

Функция Идентификатор(Знач Код, Знач Тело)
	Возврат _Точка.Запрос(Код, Тело, Код + 1).ПрочитатьУИД();
КонецФункции

Процедура Команда(Знач Код, Знач Тело)
	_Точка.Запрос(Код, Тело);
КонецПроцедуры

Функция Текст(Знач Код)
	Возврат _Точка.Запрос(Код, Неопределено, Код + 1).ПрочитатьТекст();
КонецФункции

// Операцию, появившуюся в версии сервиса Минимум, на более старом сервере не отправляем:
// ошибка называет платформу, с которой метод доступен, и то, что согласовал сервер.
Процедура ТребуетВерсию(Знач Минимум, Знач Метод)
	Если _Точка.Версия() >= Минимум Тогда
		Возврат;
	КонецЕсли;
	Текущая = СообщенияRAS.Платформа(_Точка.Версия());
	ВызватьИсключение СтрШаблон("RAS: %1() доступен на сервере 1С не ниже %2 (версия сервиса администрирования %3.0); подключён сервер с версией сервиса %4.0%5",
		Метод, СообщенияRAS.Платформа(Минимум), Минимум, _Точка.Версия(), ?(Текущая = "", "", " (" + Текущая + ")"));
КонецПроцедуры

Функция УИДы(Знач Первый, Знач Второй = Неопределено, Знач Третий = Неопределено)
	Тело = Новый БуферЗаписиSWP().УИД(Первый);
	Если Второй <> Неопределено Тогда
		Тело.УИД(Второй);
	КонецЕсли;
	Если Третий <> Неопределено Тогда
		Тело.УИД(Третий);
	КонецЕсли;
	Возврат Тело;
КонецФункции

// Параметры:
//   Хост           - Строка               - адрес сервера RAS.
//   Порт           - Число                - порт RAS.
//   Версия         - Строка, Неопределено - версия сервиса; Неопределено — автоопределение.
//   ТаймаутСекунд  - Число                - предел ожидания ответа сервера.
Процедура ПриСозданииОбъекта(Знач Хост = "localhost", Знач Порт = 1545, Знач Версия = Неопределено, Знач ТаймаутСекунд = 30)
	_Хост = Хост;
	_Порт = Порт;
	_ЖелаемаяВерсия = Версия;
	_ТаймаутМс = ТаймаутСекунд * 1000;
КонецПроцедуры
