// Клиент сервера администрирования кластера 1С (RAS) на чистом OneScript.
// Говорит с RAS нативно по бинарному протоколу: без вызова rac и без платформы.
// Версия сервиса определяется автоматически при подключении.
#Использовать "../internal"

Перем _Хост;            // Строка
Перем _Порт;            // Число
Перем _ЖелаемаяВерсия;  // Строка или Неопределено
Перем _Соединение;      // СоединениеRAS
Перем _КонечнаяТочка;   // КонечнаяТочка
Перем _ВерсияСервиса;   // Строка

// Подключается к RAS и открывает конечную точку администрирования.
//
// Параметры:
//   Сокет - Неопределено, Объект - готовый сокет (TCPСоединение или совместимый);
//           Неопределено — открыть TCP-соединение к Хост:Порт. Seam для тестов и TLS.
//
// Возвращаемое значение:
//   КлиентКластераRAS - этот объект.
Функция Подключить(Знач Сокет = Неопределено) Экспорт
	Если Сокет = Неопределено Тогда
		Сокет = Новый TCPСоединение(_Хост, _Порт);
	КонецЕсли;
	_Соединение = Новый СоединениеRAS(Сокет);
	Рукопожатие = Новый РукопожатиеRAS(_Соединение);
	Итог = Рукопожатие.ОткрытьСеанс(_ЖелаемаяВерсия);
	_ВерсияСервиса = Итог.ВерсияСервиса;
	_КонечнаяТочка = Новый КонечнаяТочка(_Соединение, Итог.ИдКонечнойТочки, Итог.ВерсияКонечнойТочки);
	Возврат ЭтотОбъект;
КонецФункции

// Согласованная версия сервиса администрирования (например, "10.0").
Функция ВерсияСервиса() Экспорт
	Возврат _ВерсияСервиса;
КонецФункции

// Аутентификация администратора агента кластера (нужна для некоторых операций агента).
Процедура АутентифицироватьАгент(Знач Пользователь, Знач Пароль) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.Текст(Пользователь).Текст(Пароль);
	_КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеAUTHENTICATE_AGENT(), Тело);
КонецПроцедуры

// Аутентификация администратора кластера (нужна для чтения сеансов, соединений, блокировок).
Процедура АутентифицироватьКластер(Знач ИдКластера, Знач Пользователь, Знач Пароль) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера).Текст(Пользователь).Текст(Пароль);
	_КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеAUTHENTICATE_CLUSTER(), Тело);
КонецПроцедуры

// Список кластеров агента.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьКластеры.
Функция Кластеры() Экспорт
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_CLUSTERS());
	Возврат СущностиRAS.РазобратьКластеры(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Сеансы кластера. Требует предварительной аутентификации кластера.
//
// Параметры:
//   ИдКластера - Строка - UUID кластера.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьСеансы.
Функция Сеансы(Знач ИдКластера) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_SESSIONS(), Тело);
	Возврат СущностиRAS.РазобратьСеансы(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Соединения кластера. Требует предварительной аутентификации кластера.
//
// Параметры:
//   ИдКластера - Строка - UUID кластера.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьСоединения.
Функция Соединения(Знач ИдКластера) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_CONNECTIONS_SHORT(), Тело);
	Возврат СущностиRAS.РазобратьСоединения(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Рабочие процессы кластера. Требует предварительной аутентификации кластера.
//
// Параметры:
//   ИдКластера - Строка - UUID кластера.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьПроцессы.
Функция РабочиеПроцессы(Знач ИдКластера) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_WORKING_PROCESSES(), Тело);
	Возврат СущностиRAS.РазобратьПроцессы(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Рабочие серверы кластера. Требует аутентификации кластера.
Функция РабочиеСерверы(Знач ИдКластера) Экспорт
	Ответ = ЗапросПоКластеру(ПротоколRAS.СообщениеGET_WORKING_SERVERS(), ИдКластера);
	Возврат СущностиRAS.РазобратьСерверы(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Менеджеры кластера (rmngr). Требует аутентификации кластера.
Функция Менеджеры(Знач ИдКластера) Экспорт
	Ответ = ЗапросПоКластеру(ПротоколRAS.СообщениеGET_CLUSTER_MANAGERS(), ИдКластера);
	Возврат СущностиRAS.РазобратьМенеджеры(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Блокировки кластера. Требует аутентификации кластера.
Функция Блокировки(Знач ИдКластера) Экспорт
	Ответ = ЗапросПоКластеру(ПротоколRAS.СообщениеGET_LOCKS(), ИдКластера);
	Возврат СущностиRAS.РазобратьБлокировки(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Блокировки информационной базы.
Функция БлокировкиБазы(Знач ИдКластера, Знач ИдБазы) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера).УИД(ИдБазы);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_INFOBASE_LOCKS(), Тело);
	Возврат СущностиRAS.РазобратьБлокировки(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Блокировки соединения.
Функция БлокировкиСоединения(Знач ИдКластера, Знач ИдСоединения) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера).УИД(ИдСоединения);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_CONNECTION_LOCKS(), Тело);
	Возврат СущностиRAS.РазобратьБлокировки(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Блокировки сеанса.
Функция БлокировкиСеанса(Знач ИдКластера, Знач ИдБазы, Знач ИдСеанса) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера).УИД(ИдБазы).УИД(ИдСеанса);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_SESSION_LOCKS(), Тело);
	Возврат СущностиRAS.РазобратьБлокировки(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Краткий список информационных баз кластера. Требует аутентификации кластера.
Функция Инфобазы(Знач ИдКластера) Экспорт
	Ответ = ЗапросПоКластеру(ПротоколRAS.СообщениеGET_INFOBASES_SHORT(), ИдКластера);
	Возврат СущностиRAS.РазобратьИнфобазыКратко(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Полная информация об информационной базе. Требует аутентификации кластера.
//
// Возвращаемое значение:
//   Структура - все поля базы, пригодные для обратной передачи в ОбновитьБазу.
Функция ИнформацияОБазе(Знач ИдКластера, Знач ИдБазы) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера).УИД(ИдБазы);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_INFOBASE_INFO(), Тело);
	Возврат СущностиRAS.РазобратьИнформациюОБазы(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Создаёт информационную базу.
//
// Параметры:
//   ИдКластера - Строка    - UUID кластера.
//   Инфо       - Структура - поля базы (см. РазобратьИнформациюОБазы); незаданные берутся по умолчанию.
//   Режим      - Число     - 1 создавать базу в СУБД, 0 только зарегистрировать.
//
// Возвращаемое значение:
//   Строка - UUID созданной базы.
Функция СоздатьБазу(Знач ИдКластера, Знач Инфо, Знач Режим = 1) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	СущностиRAS.ФорматироватьИнформациюОБазы(Тело, Инфо, _КонечнаяТочка.Версия());
	Тело.Целое(Режим);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеCREATE_INFOBASE(), Тело);
	Возврат Ответ.Читатель.ПрочитатьУИД();
КонецФункции

// Обновляет информационную базу переданной структурой полей (целиком).
Процедура ОбновитьБазу(Знач ИдКластера, Знач Инфо) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	СущностиRAS.ФорматироватьИнформациюОБазы(Тело, Инфо, _КонечнаяТочка.Версия());
	_КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеUPDATE_INFOBASE(), Тело);
КонецПроцедуры

// Удаляет (или снимает с регистрации) информационную базу.
//
// Параметры:
//   Режим - Число - 0 только разрегистрировать, 1 удалить базу данных, 2 очистить базу данных.
Процедура УдалитьБазу(Знач ИдКластера, Знач ИдБазы, Знач Режим = 0) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера).УИД(ИдБазы).Целое(Режим);
	_КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеDROP_INFOBASE(), Тело);
КонецПроцедуры

// Блокирует начало сеансов в базе. Читает текущую инфу, ставит запрет и обновляет.
Процедура ЗаблокироватьСеансы(Знач ИдКластера, Знач ИдБазы, Знач Сообщение = "", Знач КодРазрешения = "") Экспорт
	Инфо = ИнформацияОБазе(ИдКластера, ИдБазы);
	Инфо.ЗапретСеансов = Истина;
	Инфо.СообщениеБлокировки = Сообщение;
	Инфо.КодРазрешения = КодРазрешения;
	ОбновитьБазу(ИдКластера, Инфо);
КонецПроцедуры

// Снимает запрет начала сеансов в базе.
Процедура РазблокироватьСеансы(Знач ИдКластера, Знач ИдБазы) Экспорт
	Инфо = ИнформацияОБазе(ИдКластера, ИдБазы);
	Инфо.ЗапретСеансов = Ложь;
	ОбновитьБазу(ИдКластера, Инфо);
КонецПроцедуры

// Закрывает соединение с RAS.
Процедура Отключить() Экспорт
	Если _Соединение <> Неопределено Тогда
		Попытка
			_Соединение.Закрыть();
		Исключение
		КонецПопытки;
		_Соединение = Неопределено;
		_КонечнаяТочка = Неопределено;
	КонецЕсли;
КонецПроцедуры

// Отправляет запрос, тело которого — только UUID кластера.
Функция ЗапросПоКластеру(Знач КодСообщения, Знач ИдКластера)
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	Возврат _КонечнаяТочка.ОтправитьЗапрос(КодСообщения, Тело);
КонецФункции

// Параметры:
//   Хост   - Строка - адрес сервера RAS.
//   Порт   - Число  - порт RAS (по умолчанию 1545).
//   Версия - Строка, Неопределено - желаемая версия сервиса; Неопределено — автоопределение.
Процедура ПриСозданииОбъекта(Знач Хост, Знач Порт = 1545, Знач Версия = Неопределено)
	_Хост = Хост;
	_Порт = Порт;
	_ЖелаемаяВерсия = Версия;
КонецПроцедуры
