// Клиент сервера администрирования кластера 1С (RAS) на чистом OneScript.
// Говорит с RAS нативно по бинарному протоколу: без вызова rac и без платформы.
// Версия сервиса определяется автоматически при подключении.
#Использовать "../internal"

Перем _Хост;            // Строка
Перем _Порт;            // Число
Перем _ЖелаемаяВерсия;  // Строка или Неопределено
Перем _Соединение;      // СоединениеRAS
Перем _КонечнаяТочка;   // КонечнаяТочка
Перем _ВерсияСервиса;   // Строка

// Подключается к RAS и открывает конечную точку администрирования.
//
// Параметры:
//   Сокет - Неопределено, Объект - готовый сокет (TCPСоединение или совместимый);
//           Неопределено — открыть TCP-соединение к Хост:Порт. Seam для тестов и TLS.
//
// Возвращаемое значение:
//   КлиентКластераRAS - этот объект.
Функция Подключить(Знач Сокет = Неопределено) Экспорт
	Если Сокет = Неопределено Тогда
		Сокет = Новый TCPСоединение(_Хост, _Порт);
	КонецЕсли;
	_Соединение = Новый СоединениеRAS(Сокет);
	Рукопожатие = Новый РукопожатиеRAS(_Соединение);
	Итог = Рукопожатие.ОткрытьСеанс(_ЖелаемаяВерсия);
	_ВерсияСервиса = Итог.ВерсияСервиса;
	_КонечнаяТочка = Новый КонечнаяТочка(_Соединение, Итог.ИдКонечнойТочки, Итог.ВерсияКонечнойТочки);
	Возврат ЭтотОбъект;
КонецФункции

// Согласованная версия сервиса администрирования (например, "10.0").
Функция ВерсияСервиса() Экспорт
	Возврат _ВерсияСервиса;
КонецФункции

// Аутентификация администратора агента кластера (нужна для некоторых операций агента).
Процедура АутентифицироватьАгент(Знач Пользователь, Знач Пароль) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.Текст(Пользователь).Текст(Пароль);
	_КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеAUTHENTICATE_AGENT(), Тело);
КонецПроцедуры

// Аутентификация администратора кластера (нужна для чтения сеансов, соединений, блокировок).
Процедура АутентифицироватьКластер(Знач ИдКластера, Знач Пользователь, Знач Пароль) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера).Текст(Пользователь).Текст(Пароль);
	_КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеAUTHENTICATE_CLUSTER(), Тело);
КонецПроцедуры

// Список кластеров агента.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьКластеры.
Функция Кластеры() Экспорт
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_CLUSTERS());
	Возврат СущностиRAS.РазобратьКластеры(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Сеансы кластера. Требует предварительной аутентификации кластера.
//
// Параметры:
//   ИдКластера - Строка - UUID кластера.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьСеансы.
Функция Сеансы(Знач ИдКластера) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_SESSIONS(), Тело);
	Возврат СущностиRAS.РазобратьСеансы(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Соединения кластера. Требует предварительной аутентификации кластера.
//
// Параметры:
//   ИдКластера - Строка - UUID кластера.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьСоединения.
Функция Соединения(Знач ИдКластера) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_CONNECTIONS_SHORT(), Тело);
	Возврат СущностиRAS.РазобратьСоединения(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Рабочие процессы кластера. Требует предварительной аутентификации кластера.
//
// Параметры:
//   ИдКластера - Строка - UUID кластера.
//
// Возвращаемое значение:
//   Массив из Структура - см. СущностиRAS.РазобратьПроцессы.
Функция РабочиеПроцессы(Знач ИдКластера) Экспорт
	Тело = Новый БуферЗаписи();
	Тело.УИД(ИдКластера);
	Ответ = _КонечнаяТочка.ОтправитьЗапрос(ПротоколRAS.СообщениеGET_WORKING_PROCESSES(), Тело);
	Возврат СущностиRAS.РазобратьПроцессы(Ответ.Читатель, _КонечнаяТочка.Версия());
КонецФункции

// Закрывает соединение с RAS.
Процедура Отключить() Экспорт
	Если _Соединение <> Неопределено Тогда
		Попытка
			_Соединение.Закрыть();
		Исключение
		КонецПопытки;
		_Соединение = Неопределено;
		_КонечнаяТочка = Неопределено;
	КонецЕсли;
КонецПроцедуры

// Параметры:
//   Хост   - Строка - адрес сервера RAS.
//   Порт   - Число  - порт RAS (по умолчанию 1545).
//   Версия - Строка, Неопределено - желаемая версия сервиса; Неопределено — автоопределение.
Процедура ПриСозданииОбъекта(Знач Хост, Знач Порт = 1545, Знач Версия = Неопределено)
	_Хост = Хост;
	_Порт = Порт;
	_ЖелаемаяВерсия = Версия;
КонецПроцедуры
