// Установление сеанса SWP: NEGOTIATE → CONNECT → открытие конечной точки сервиса с выбором версии.
// Отказ сервера перечисляет его версии — берём высшую из известных клиенту; общих нет — понятная ошибка.
#native

Перем _Канал; // КаналSWP

// Выполняет рукопожатие и открывает конечную точку сервиса.
//
// Параметры:
//   ИмяСервиса      - Строка             - имя сервиса, например "v8.service.Admin.Cluster".
//   ИзвестныеВерсии - Массив из Строка   - версии, которые знает клиент, по возрастанию.
//   ЖелаемаяВерсия  - Строка, Неопределено - версия для первой попытки; Неопределено — последняя известная.
//
// Возвращаемое значение:
//   Структура - ВерсияСервиса (Строка), ИдКонечнойТочки (Число), ВерсияКонечнойТочки (Число).
Функция ОткрытьСеанс(Знач ИмяСервиса, Знач ИзвестныеВерсии, Знач ЖелаемаяВерсия = Неопределено) Экспорт
	Согласовать();
	Соединиться();

	Если ЖелаемаяВерсия = Неопределено Тогда
		ЖелаемаяВерсия = ИзвестныеВерсии[ИзвестныеВерсии.ВГраница()];
	КонецЕсли;

	Ответ = ОткрытьКонечнуюТочку(ИмяСервиса, ЖелаемаяВерсия);
	Если Ответ.Тип = ПакетыSWP.ENDPOINT_OPEN_ACK() Тогда
		Возврат РезультатОткрытия(Ответ.Данные, ЖелаемаяВерсия);
	КонецЕсли;

	Поддерживаемые = ВерсииИзОтказа(Ответ.Данные);
	Запасная = ВысшаяОбщая(Поддерживаемые, ИзвестныеВерсии);
	Если Запасная = Неопределено Или Запасная = ЖелаемаяВерсия Тогда
		ВызватьИсключение "SWP: сервер не принял версию " + ЖелаемаяВерсия + " сервиса " + ИмяСервиса
			+ ". Сервер поддерживает: " + ?(Поддерживаемые.Количество() = 0, "не сообщил", СтрСоединить(Поддерживаемые, ", "))
			+ ". Клиент знает: " + СтрСоединить(ИзвестныеВерсии, ", ")
			+ ". Нужна поддержка новой версии в клиентской библиотеке.";
	КонецЕсли;

	Ответ = ОткрытьКонечнуюТочку(ИмяСервиса, Запасная);
	Если Ответ.Тип <> ПакетыSWP.ENDPOINT_OPEN_ACK() Тогда
		ВызватьИсключение "SWP: сервер отклонил и версию " + Запасная + " из своего списка: " + ОписаниеОтказа(Ответ.Данные);
	КонецЕсли;
	Возврат РезультатОткрытия(Ответ.Данные, Запасная);
КонецФункции

Процедура Согласовать()
	Тело = Новый БуферЗаписиSWP();
	Тело.Целое(ПакетыSWP.Магия()).Короткое(ПакетыSWP.ВерсияПротокола()).Короткое(ПакетыSWP.ВерсияКодека());
	_Канал.ОтправитьПакет(ПакетыSWP.NEGOTIATE(), Тело.ДвоичныеДанные());
КонецПроцедуры

Процедура Соединиться()
	Тело = Новый БуферЗаписиSWP();
	Тело.РазмерNull(1).Текст("connect.timeout").ТипизированноеДлинное(2000);
	_Канал.ОтправитьПакет(ПакетыSWP.CONNECT(), Тело.ДвоичныеДанные());
	Ответ = _Канал.ПрочитатьПакет();
	Если Ответ.Тип <> ПакетыSWP.CONNECT_ACK() Тогда
		ВызватьИсключение "SWP: на CONNECT ожидался CONNECT_ACK, получен пакет типа " + Ответ.Тип;
	КонецЕсли;
КонецПроцедуры

// Возвращает пакет ответа: ENDPOINT_OPEN_ACK или ENDPOINT_FAILURE.
Функция ОткрытьКонечнуюТочку(Знач ИмяСервиса, Знач Версия)
	Тело = Новый БуферЗаписиSWP();
	Тело.Текст(ИмяСервиса).Текст(Версия).Байт(0);
	_Канал.ОтправитьПакет(ПакетыSWP.ENDPOINT_OPEN(), Тело.ДвоичныеДанные());
	Ответ = _Канал.ПрочитатьПакет();
	Если Ответ.Тип <> ПакетыSWP.ENDPOINT_OPEN_ACK() И Ответ.Тип <> ПакетыSWP.ENDPOINT_FAILURE() Тогда
		ВызватьИсключение "SWP: на открытие конечной точки получен пакет типа " + Ответ.Тип;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция РезультатОткрытия(Знач Данные, Знач Версия)
	Читатель = Новый БуферЧтенияSWP(Данные);
	Читатель.ПрочитатьТекст(); // идентификатор сервиса
	ВерсияТочки = Читатель.ПрочитатьТекст();
	Результат = Новый Структура;
	Результат.Вставить("ВерсияСервиса", Версия);
	Результат.Вставить("ИдКонечнойТочки", Читатель.ПрочитатьРазмерNull());
	Результат.Вставить("ВерсияКонечнойТочки", ЦелаяЧасть(ВерсияТочки));
	Возврат Результат;
КонецФункции

// Версии из текста отказа: фрагмент «supported=[8.0, 9.0]» в причине ошибки.
Функция ВерсииИзОтказа(Знач Данные)
	Результат = Новый Массив;
	Текст = ТекстДанных(Данные);
	Позиция = СтрНайти(Текст, "supported=");
	Если Позиция = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Хвост = Сред(Текст, Позиция + СтрДлина("supported="));
	Конец = СтрНайти(Хвост, "]");
	Если Конец > 0 Тогда
		Хвост = Лев(Хвост, Конец - 1);
	КонецЕсли;
	Хвост = СтрЗаменить(СтрЗаменить(Хвост, "[", ""), ",", " ");
	Для Каждого Слово Из СтрРазделить(Хвост, " ", Ложь) Цикл
		Результат.Добавить(СокрЛП(Слово));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Высшая версия клиента, которая есть в списке сервера; сравнение по точному совпадению.
Функция ВысшаяОбщая(Знач Поддерживаемые, Знач ИзвестныеВерсии)
	Индекс = ИзвестныеВерсии.ВГраница();
	Пока Индекс >= 0 Цикл
		Если Поддерживаемые.Найти(ИзвестныеВерсии[Индекс]) <> Неопределено Тогда
			Возврат ИзвестныеВерсии[Индекс];
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Читаемое описание отказа ENDPOINT_FAILURE: класс причины и сообщение.
Функция ОписаниеОтказа(Знач Данные)
	Попытка
		Читатель = Новый БуферЧтенияSWP(Данные);
		Читатель.ПрочитатьТекст(); // идентификатор сервиса
		Читатель.ПрочитатьТекст(); // версия
		Читатель.ПрочитатьРазмерNull(); // ид конечной точки
		Причина = Читатель.ПрочитатьТекст();
		Сообщение = Читатель.ПрочитатьТекст();
		Возврат Причина + ": " + Сообщение;
	Исключение
		Возврат ТекстДанных(Данные);
	КонецПопытки;
КонецФункции

Функция ТекстДанных(Знач Данные)
	Попытка
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ЦелаяЧасть(Знач ТекстВерсии)
	Точка = СтрНайти(ТекстВерсии, ".");
	Попытка
		Возврат Число(?(Точка > 0, Лев(ТекстВерсии, Точка - 1), ТекстВерсии));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Параметры:
//   Канал - КаналSWP - открытый канал к серверу.
Процедура ПриСозданииОбъекта(Знач Канал = Неопределено)
	_Канал = Канал;
КонецПроцедуры
