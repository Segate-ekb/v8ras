// Описание сущности SWP: поля в порядке протокола с типом и версией сервиса, с которой поле есть.
// Одно описание служит и чтению (БуферЧтенияSWP.ПрочитатьСущность), и записи (БуферЗаписиSWP.Сущность).
//
// Коды типов полей:
//   1 Байт, 2 Флаг, 3 Короткое (16 бит), 4 Целое (32 бита), 5 Длинное (64 бита), 6 Двойное (IEEE 754),
//   7 Текст (UTF-8), 8 УИД, 9 Время, 10 ЦелоеФлаг (булево в 32 битах), 11 Список (вложенные сущности),
//   12 СписокУИД (размер Size и UUID подряд).
#native

Перем _Имя;       // Строка — имя сущности для сообщений об ошибках
Перем _Имена;     // Массив из Строка — имена полей
Перем _Типы;      // Массив из Число — коды типов
Перем _Версии;    // Массив из Число — версия сервиса, с которой поле передаётся (0 — всегда)
Перем _Вложенные; // Массив из ОписаниеСущностиSWP, Неопределено — описание элементов списка
Перем _Умолчания; // Массив — значение для записи без заданного поля и для поля, которого нет в версии

// Добавляет поле-байт.
//
// Параметры:
//   ИмяПоля   - Строка - ключ в структуре сущности.
//   СВерсии   - Число  - версия сервиса, с которой поле есть в протоколе.
//   Умолчание - Число  - значение, если поле не задано или отсутствует в версии.
//
// Возвращаемое значение:
//   ОписаниеСущностиSWP - этот объект для построения цепочкой.
Функция Байт(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = 0) Экспорт
	Возврат Добавить(ИмяПоля, 1, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет поле-флаг (байт 0/1). Параметры — как у Байт.
Функция Флаг(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = Ложь) Экспорт
	Возврат Добавить(ИмяПоля, 2, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет 16-битное беззнаковое поле. Параметры — как у Байт.
Функция Короткое(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = 0) Экспорт
	Возврат Добавить(ИмяПоля, 3, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет 32-битное знаковое поле (дополнительный код). Параметры — как у Байт.
Функция Целое(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = 0) Экспорт
	Возврат Добавить(ИмяПоля, 4, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет 64-битное беззнаковое поле. Параметры — как у Байт.
Функция Длинное(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = 0) Экспорт
	Возврат Добавить(ИмяПоля, 5, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет поле двойной точности IEEE 754. Параметры — как у Байт.
Функция Двойное(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = 0) Экспорт
	Возврат Добавить(ИмяПоля, 6, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет строковое поле UTF-8. Параметры — как у Байт.
Функция Текст(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = "") Экспорт
	Возврат Добавить(ИмяПоля, 7, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет поле UUID (16 байт). Параметры — как у Байт.
Функция УИД(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = "00000000-0000-0000-0000-000000000000") Экспорт
	Возврат Добавить(ИмяПоля, 8, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет поле-дату (тики .NET в 64 битах). Параметры — как у Байт.
Функция Время(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = '00010101000000') Экспорт
	Возврат Добавить(ИмяПоля, 9, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет булево поле, которое протокол передаёт 32-битным целым. Параметры — как у Байт.
Функция ЦелоеФлаг(Знач ИмяПоля, Знач СВерсии = 0, Знач Умолчание = Ложь) Экспорт
	Возврат Добавить(ИмяПоля, 10, СВерсии, Умолчание, Неопределено);
КонецФункции

// Добавляет список вложенных сущностей (размер Size и элементы подряд).
//
// Параметры:
//   ИмяПоля - Строка              - ключ в структуре сущности.
//   Элемент - ОписаниеСущностиSWP - описание элемента списка.
//   СВерсии - Число               - версия сервиса, с которой поле есть в протоколе.
//
// Возвращаемое значение:
//   ОписаниеСущностиSWP - этот объект для построения цепочкой.
Функция Список(Знач ИмяПоля, Знач Элемент, Знач СВерсии = 0) Экспорт
	Возврат Добавить(ИмяПоля, 11, СВерсии, Неопределено, Элемент);
КонецФункции

// Добавляет список UUID (размер Size и идентификаторы подряд); читается массивом строк. Параметры — как у Байт.
Функция СписокУИД(Знач ИмяПоля, Знач СВерсии = 0) Экспорт
	Возврат Добавить(ИмяПоля, 12, СВерсии, Неопределено, Неопределено);
КонецФункции

// Имя сущности.
Функция Имя() Экспорт
	Возврат _Имя;
КонецФункции

// Имена полей по порядку протокола (массив описания, только для чтения).
Функция Имена() Экспорт
	Возврат _Имена;
КонецФункции

// Коды типов полей (массив описания, только для чтения).
Функция Типы() Экспорт
	Возврат _Типы;
КонецФункции

// Версии появления полей (массив описания, только для чтения).
Функция Версии() Экспорт
	Возврат _Версии;
КонецФункции

// Описания элементов списков; для прочих полей — Неопределено (массив описания, только для чтения).
Функция Вложенные() Экспорт
	Возврат _Вложенные;
КонецФункции

// Значение поля по умолчанию; для списка — новый пустой массив.
//
// Параметры:
//   Индекс - Число - номер поля с нуля.
//
// Возвращаемое значение:
//   Произвольный - значение по умолчанию.
Функция Умолчание(Знач Индекс) Экспорт
	Если _Типы[Индекс] = 11 Или _Типы[Индекс] = 12 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат _Умолчания[Индекс];
КонецФункции

Функция Добавить(Знач ИмяПоля, Знач Тип, Знач СВерсии, Знач Умолчание, Знач Вложенное)
	_Имена.Добавить(ИмяПоля);
	_Типы.Добавить(Тип);
	_Версии.Добавить(СВерсии);
	_Умолчания.Добавить(Умолчание);
	_Вложенные.Добавить(Вложенное);
	Возврат ЭтотОбъект;
КонецФункции

Процедура ПриСозданииОбъекта(Знач ИмяСущности = "")
	_Имя = ИмяСущности;
	_Имена = Новый Массив;
	_Типы = Новый Массив;
	_Версии = Новый Массив;
	_Вложенные = Новый Массив;
	_Умолчания = Новый Массив;
КонецПроцедуры
