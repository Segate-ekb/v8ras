// Разбор тела сообщения SWP: целые от старшего байта, две схемы varint, строки UTF-8, UUID, даты,
// числа двойной точности и сущности по описанию (ОписаниеСущностиSWP).
#native

Перем _Буфер;   // БуферДвоичныхДанных — принятые байты
Перем _Позиция; // Число — смещение чтения
Перем _Порядок; // ПорядокБайтов — от старшего байта
Перем _Размер;  // Число — размер буфера; свойство .NET-объекта дорого читать на каждом поле

// Число непрочитанных байтов.
Функция Остаток() Экспорт
	Возврат _Размер - _Позиция;
КонецФункции

// Остались ли непрочитанные байты.
Функция ЕстьДанные() Экспорт
	Возврат _Позиция < _Размер;
КонецФункции

// Читает байт (0..255).
Функция ПрочитатьБайт() Экспорт
	Потребовать(1);
	Значение = _Буфер[_Позиция];
	_Позиция = _Позиция + 1;
	Возврат Значение;
КонецФункции

// Читает беззнаковое 16-битное целое.
Функция ПрочитатьКороткое() Экспорт
	Потребовать(2);
	Значение = _Буфер.ПрочитатьЦелое16(_Позиция, _Порядок);
	_Позиция = _Позиция + 2;
	Возврат Значение;
КонецФункции

// Читает беззнаковое 32-битное целое.
Функция ПрочитатьЦелое() Экспорт
	Потребовать(4);
	Значение = _Буфер.ПрочитатьЦелое32(_Позиция, _Порядок);
	_Позиция = _Позиция + 4;
	Возврат Значение;
КонецФункции

// Читает беззнаковое 64-битное целое.
Функция ПрочитатьДлинное() Экспорт
	Потребовать(8);
	Значение = _Буфер.ПрочитатьЦелое64(_Позиция, _Порядок);
	_Позиция = _Позиция + 8;
	Возврат Значение;
КонецФункции

// Читает число двойной точности IEEE 754. Бесконечность, NaN и денормализованные числа дают 0.
Функция ПрочитатьДвойное() Экспорт
	Биты = ПрочитатьДлинное();
	Знак = ?(Биты >= 9223372036854775808, -1, 1);
	БезЗнака = Биты % 9223372036854775808;
	Экспонента = Цел(БезЗнака / 4503599627370496);
	Мантисса = БезЗнака % 4503599627370496;
	Если Экспонента = 0 Или Экспонента = 2047 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Знак * (1 + Мантисса / 4503599627370496) * Степень2(Экспонента - 1023);
КонецФункции

// Читает размер по схеме Size: разряды по 7 бит, старший бит — продолжение.
Функция ПрочитатьРазмер() Экспорт
	Текущий = ПрочитатьБайт();
	Значение = Текущий % 128;
	Множитель = 128;
	Пока Текущий >= 128 Цикл
		Текущий = ПрочитатьБайт();
		Значение = Значение + (Текущий % 128) * Множитель;
		Множитель = Множитель * 128;
	КонецЦикла;
	Возврат Значение;
КонецФункции

// Читает размер по схеме NullableSize: первый разряд 6 бит, бит 0x40 — продолжение.
Функция ПрочитатьРазмерNull() Экспорт
	Текущий = ПрочитатьБайт();
	Если Текущий >= 128 Тогда
		ВызватьИсключение "SWP: ожидался NullableSize, прочитан байт " + Текущий + " на позиции " + (_Позиция - 1);
	КонецЕсли;
	Значение = Текущий % 64;
	Если Текущий < 64 Тогда
		Возврат Значение;
	КонецЕсли;
	Множитель = 64;
	Текущий = 128;
	Пока Текущий >= 128 Цикл
		Текущий = ПрочитатьБайт();
		Значение = Значение + (Текущий % 128) * Множитель;
		Множитель = Множитель * 128;
	КонецЦикла;
	Возврат Значение;
КонецФункции

// Читает строку: длина NullableSize и байты UTF-8; нулевая длина — пустая строка.
Функция ПрочитатьТекст() Экспорт
	Длина = ПрочитатьРазмерNull();
	Если Длина = 0 Тогда
		Возврат "";
	КонецЕсли;
	Потребовать(Длина);
	Значение = ПолучитьСтрокуИзБуфераДвоичныхДанных(_Буфер.Прочитать(_Позиция, Длина), "UTF-8");
	_Позиция = _Позиция + Длина;
	Возврат Значение;
КонецФункции

// Читает булево: ненулевой байт — Истина.
Функция ПрочитатьФлаг() Экспорт
	Возврат ПрочитатьБайт() <> 0;
КонецФункции

// Читает UUID (16 байт) в виде строки с дефисами в нижнем регистре.
Функция ПрочитатьУИД() Экспорт
	Потребовать(16);
	Hex = НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(_Буфер.Прочитать(_Позиция, 16)));
	_Позиция = _Позиция + 16;
	Возврат Сред(Hex, 1, 8) + "-" + Сред(Hex, 9, 4) + "-" + Сред(Hex, 13, 4) + "-"
		+ Сред(Hex, 17, 4) + "-" + Сред(Hex, 21, 12);
КонецФункции

// Читает дату: 64-битные тики по 100 мкс от 0001-01-01; нулевые тики — пустая дата.
Функция ПрочитатьВремя() Экспорт
	Возврат '00010101000000' + Цел(ПрочитатьДлинное() / 10000);
КонецФункции

// Читает Количество байтов как двоичные данные.
Функция ПрочитатьДвоичные(Знач Количество) Экспорт
	Потребовать(Количество);
	Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(_Буфер.Прочитать(_Позиция, Количество));
	_Позиция = _Позиция + Количество;
	Возврат Данные;
КонецФункции

// Читает сущность по описанию. Поля, которых нет в версии, получают значение по умолчанию.
//
// Параметры:
//   Описание - ОписаниеСущностиSWP - порядок и типы полей.
//   Версия   - Число               - версия сервиса, согласованная при открытии конечной точки.
//
// Возвращаемое значение:
//   Структура - ключи — имена полей описания.
Функция ПрочитатьСущность(Знач Описание, Знач Версия) Экспорт
	Результат = Новый Структура;
	Имена = Описание.Имена();
	Типы = Описание.Типы();
	Версии = Описание.Версии();
	Вложенные = Описание.Вложенные();
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Если Версии[Индекс] > Версия Тогда
			Результат.Вставить(Имена[Индекс], Описание.Умолчание(Индекс));
		Иначе
			Результат.Вставить(Имена[Индекс], ПрочитатьПоле(Типы[Индекс], Вложенные[Индекс], Версия));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Читает список сущностей: размер Size и элементы подряд.
//
// Параметры:
//   Описание - ОписаниеСущностиSWP - описание элемента.
//   Версия   - Число               - версия сервиса.
//
// Возвращаемое значение:
//   Массив из Структура - см. ПрочитатьСущность.
Функция ПрочитатьСписок(Знач Описание, Знач Версия) Экспорт
	Количество = ПрочитатьРазмер();
	Результат = Новый Массив;
	Для Сч = 1 По Количество Цикл
		Результат.Добавить(ПрочитатьСущность(Описание, Версия));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Проверки — по убыванию частоты типов в сущностях кластера.
Функция ПрочитатьПоле(Знач Тип, Знач Вложенное, Знач Версия)
	Если Тип = 4 Тогда
		Возврат ПрочитатьЦелое();
	ИначеЕсли Тип = 5 Тогда
		Возврат ПрочитатьДлинное();
	ИначеЕсли Тип = 7 Тогда
		Возврат ПрочитатьТекст();
	ИначеЕсли Тип = 8 Тогда
		Возврат ПрочитатьУИД();
	ИначеЕсли Тип = 2 Тогда
		Возврат ПрочитатьФлаг();
	ИначеЕсли Тип = 9 Тогда
		Возврат ПрочитатьВремя();
	ИначеЕсли Тип = 3 Тогда
		Возврат ПрочитатьКороткое();
	ИначеЕсли Тип = 6 Тогда
		Возврат ПрочитатьДвойное();
	ИначеЕсли Тип = 10 Тогда
		Возврат ПрочитатьЦелое() <> 0;
	ИначеЕсли Тип = 11 Тогда
		Возврат ПрочитатьСписок(Вложенное, Версия);
	ИначеЕсли Тип = 1 Тогда
		Возврат ПрочитатьБайт();
	КонецЕсли;
	ВызватьИсключение "SWP: неизвестный код типа поля " + Тип;
КонецФункции

Процедура Потребовать(Знач Количество)
	Если _Позиция + Количество > _Размер Тогда
		ВызватьИсключение "SWP: ответ обрывается — на позиции " + _Позиция + " нужно " + Количество
			+ " байт, осталось " + (_Размер - _Позиция);
	КонецЕсли;
КонецПроцедуры

Функция Степень2(Знач Показатель)
	Если Показатель > 90 Или Показатель < -90 Тогда
		ВызватьИсключение "SWP: порядок числа двойной точности 2^" + Показатель + " вне диапазона Число";
	КонецЕсли;
	Результат = 1;
	Для Сч = 1 По ?(Показатель < 0, -Показатель, Показатель) Цикл
		Результат = Результат * 2;
	КонецЦикла;
	Возврат ?(Показатель < 0, 1 / Результат, Результат);
КонецФункции

// Параметры:
//   Данные - ДвоичныеДанные, БуферДвоичныхДанных - принятые байты.
Процедура ПриСозданииОбъекта(Знач Данные = Неопределено)
	Если ТипЗнч(Данные) = Тип("БуферДвоичныхДанных") Тогда
		_Буфер = Данные;
	ИначеЕсли Данные = Неопределено Тогда
		_Буфер = Новый БуферДвоичныхДанных(0);
	Иначе
		_Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	КонецЕсли;
	_Размер = _Буфер.Размер;
	_Позиция = 0;
	_Порядок = ПорядокБайтов.BigEndian;
КонецПроцедуры
