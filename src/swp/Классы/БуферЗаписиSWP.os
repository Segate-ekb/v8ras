// Сборка тела сообщения SWP: целые от старшего байта, две схемы varint, строки UTF-8, UUID, даты,
// числа двойной точности и сущности по описанию (ОписаниеСущностиSWP). Накопитель растёт удвоением.
#native

Перем _Буфер;   // БуферДвоичныхДанных — накопитель
Перем _Длина;   // Число — занято байтов
Перем _Порядок; // ПорядокБайтов — от старшего байта

// Добавляет байт; старшие разряды отбрасываются.
//
// Параметры:
//   Значение - Число - 0..255.
//
// Возвращаемое значение:
//   БуферЗаписиSWP - этот объект для построения цепочкой.
Функция Байт(Знач Значение) Экспорт
	Обеспечить(1);
	_Буфер[_Длина] = Значение % 256;
	_Длина = _Длина + 1;
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет 16-битное целое; отрицательное — в дополнительном коде.
Функция Короткое(Знач Значение) Экспорт
	Обеспечить(2);
	_Буфер.ЗаписатьЦелое16(_Длина, Беззнаковое(Значение, 65536), _Порядок);
	_Длина = _Длина + 2;
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет 32-битное целое; отрицательное — в дополнительном коде.
Функция Целое(Знач Значение) Экспорт
	Обеспечить(4);
	_Буфер.ЗаписатьЦелое32(_Длина, Беззнаковое(Значение, 4294967296), _Порядок);
	_Длина = _Длина + 4;
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет 64-битное целое; отрицательное — в дополнительном коде.
Функция Длинное(Знач Значение) Экспорт
	Обеспечить(8);
	_Буфер.ЗаписатьЦелое64(_Длина, Беззнаковое(Значение, 18446744073709551616), _Порядок);
	_Длина = _Длина + 8;
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет число двойной точности IEEE 754.
Функция Двойное(Знач Значение) Экспорт
	Возврат Длинное(БитыДвойного(Значение));
КонецФункции

// Добавляет размер по схеме Size (длина пакета, число элементов списка).
Функция Размер(Знач Значение) Экспорт
	Пока Значение >= 128 Цикл
		Байт(128 + Значение % 128);
		Значение = Цел(Значение / 128);
	КонецЦикла;
	Возврат Байт(Значение);
КонецФункции

// Добавляет размер по схеме NullableSize (длина строки, идентификатор конечной точки).
Функция РазмерNull(Знач Значение) Экспорт
	Если Значение < 64 Тогда
		Возврат Байт(Значение);
	КонецЕсли;
	Байт(64 + Значение % 64);
	Возврат Размер(Цел(Значение / 64));
КонецФункции

// Добавляет строку: пустая — нулевым байтом, иначе длина NullableSize и байты UTF-8.
Функция Текст(Знач Значение) Экспорт
	Если ПустаяСтрока(Значение) Тогда
		Возврат Байт(0);
	КонецЕсли;
	Байты = ПолучитьБуферДвоичныхДанныхИзСтроки(Значение, "UTF-8");
	РазмерNull(Байты.Размер);
	Возврат ДописатьБуфер(Байты);
КонецФункции

// Добавляет булево байтом 1/0.
Функция Флаг(Знач Значение) Экспорт
	Возврат Байт(?(Значение, 1, 0));
КонецФункции

// Добавляет значение с типом LONG (TypedValue): байт типа 5 и 64-битное целое.
Функция ТипизированноеДлинное(Знач Значение) Экспорт
	Байт(5);
	Возврат Длинное(Значение);
КонецФункции

// Добавляет UUID 16 байтами; принимает вид с дефисами и без.
Функция УИД(Знач Значение) Экспорт
	Шестнадцатеричное = СтрЗаменить("" + Значение, "-", "");
	Если СтрДлина(Шестнадцатеричное) <> 32 Тогда
		ВызватьИсключение "SWP: неверный UUID " + Значение;
	КонецЕсли;
	Возврат ДописатьБуфер(ПолучитьБуферДвоичныхДанныхИзHexСтроки(Шестнадцатеричное));
КонецФункции

// Добавляет дату как 64-битные тики по 100 мкс от 0001-01-01; пустая дата — нулевые тики.
Функция Время(Знач Значение) Экспорт
	Возврат Длинное((Значение - '00010101000000') * 10000);
КонецФункции

// Добавляет двоичные данные как есть.
Функция Двоичные(Знач Данные) Экспорт
	Возврат ДописатьБуфер(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные));
КонецФункции

// Добавляет сущность по описанию. Незаданные поля пишутся значением по умолчанию,
// поля новее версии сервиса пропускаются.
//
// Параметры:
//   Описание - ОписаниеСущностиSWP - порядок и типы полей.
//   Значение - Структура           - поля сущности.
//   Версия   - Число               - версия сервиса.
//
// Возвращаемое значение:
//   БуферЗаписиSWP - этот объект.
Функция Сущность(Знач Описание, Знач Значение, Знач Версия) Экспорт
	Имена = Описание.Имена();
	Типы = Описание.Типы();
	Версии = Описание.Версии();
	Вложенные = Описание.Вложенные();
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Если Версии[Индекс] > Версия Тогда
			Продолжить;
		КонецЕсли;
		Если Значение.Свойство(Имена[Индекс]) Тогда
			Поле = Значение[Имена[Индекс]];
		Иначе
			Поле = Описание.Умолчание(Индекс);
		КонецЕсли;
		ЗаписатьПоле(Типы[Индекс], Вложенные[Индекс], Поле, Версия);
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет список сущностей: размер Size и элементы подряд.
Функция Список(Знач Описание, Знач Значения, Знач Версия) Экспорт
	Размер(Значения.Количество());
	Для Каждого Значение Из Значения Цикл
		Сущность(Описание, Значение, Версия);
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет список UUID: размер Size и идентификаторы подряд.
Функция СписокУИД(Знач Значения) Экспорт
	Размер(Значения.Количество());
	Для Каждого Значение Из Значения Цикл
		УИД(Значение);
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// Собранные байты.
//
// Возвращаемое значение:
//   ДвоичныеДанные - накопленное тело.
Функция ДвоичныеДанные() Экспорт
	Если _Длина = 0 Тогда
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(0));
	КонецЕсли;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(_Буфер.Прочитать(0, _Длина));
КонецФункции

// Число накопленных байтов.
Функция Длина() Экспорт
	Возврат _Длина;
КонецФункции

Процедура ЗаписатьПоле(Знач Тип, Знач Вложенное, Знач Значение, Знач Версия)
	Если Тип = 4 Тогда
		Целое(Значение);
	ИначеЕсли Тип = 5 Тогда
		Длинное(Значение);
	ИначеЕсли Тип = 7 Тогда
		Текст(Значение);
	ИначеЕсли Тип = 8 Тогда
		УИД(Значение);
	ИначеЕсли Тип = 2 Тогда
		Флаг(Значение);
	ИначеЕсли Тип = 9 Тогда
		Время(Значение);
	ИначеЕсли Тип = 3 Тогда
		Короткое(Значение);
	ИначеЕсли Тип = 6 Тогда
		Двойное(Значение);
	ИначеЕсли Тип = 10 Тогда
		Целое(?(Значение, 1, 0));
	ИначеЕсли Тип = 11 Тогда
		Список(Вложенное, Значение, Версия);
	ИначеЕсли Тип = 12 Тогда
		СписокУИД(Значение);
	ИначеЕсли Тип = 1 Тогда
		Байт(Значение);
	Иначе
		ВызватьИсключение "SWP: неизвестный код типа поля " + Тип;
	КонецЕсли;
КонецПроцедуры

Функция ДописатьБуфер(Знач Байты)
	Обеспечить(Байты.Размер);
	_Буфер.Записать(_Длина, Байты, Байты.Размер);
	_Длина = _Длина + Байты.Размер;
	Возврат ЭтотОбъект;
КонецФункции

Процедура Обеспечить(Знач Количество)
	Если _Длина + Количество <= _Буфер.Размер Тогда
		Возврат;
	КонецЕсли;
	Больший = Новый БуферДвоичныхДанных(Макс(_Буфер.Размер * 2, _Длина + Количество));
	Больший.Записать(0, _Буфер, _Длина);
	_Буфер = Больший;
КонецПроцедуры

Функция Беззнаковое(Знач Значение, Знач Модуль)
	Если Значение < 0 Тогда
		Возврат Значение + Модуль;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Раскладка IEEE 754: знак, смещённый порядок, 52 бита мантиссы.
Функция БитыДвойного(Знач Значение)
	Если Значение = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Знак = 0;
	Если Значение < 0 Тогда
		Знак = 9223372036854775808;
		Значение = -Значение;
	КонецЕсли;
	Порядок = 0;
	Пока Значение >= 2 Цикл
		Значение = Значение / 2;
		Порядок = Порядок + 1;
	КонецЦикла;
	Пока Значение < 1 Цикл
		Значение = Значение * 2;
		Порядок = Порядок - 1;
	КонецЦикла;
	Мантисса = Окр((Значение - 1) * 4503599627370496);
	Если Мантисса = 4503599627370496 Тогда
		Мантисса = 0;
		Порядок = Порядок + 1;
	КонецЕсли;
	Возврат Знак + (Порядок + 1023) * 4503599627370496 + Мантисса;
КонецФункции

Процедура ПриСозданииОбъекта()
	_Буфер = Новый БуферДвоичныхДанных(64);
	_Длина = 0;
	_Порядок = ПорядокБайтов.BigEndian;
КонецПроцедуры
