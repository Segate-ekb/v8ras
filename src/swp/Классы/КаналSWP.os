// Кадры SWP поверх TCP: пакет — [байт типа][длина Size][тело]. NEGOTIATE (тип 0) идёт без кадра.
#native

Перем _Сокет; // TCPСоединение или объект с ОтправитьДвоичныеДанные, ПрочитатьДвоичныеДанные, Закрыть

// Отправляет пакет одним вызовом сокета.
//
// Параметры:
//   Тип  - Число          - тип пакета (ПакетыSWP).
//   Тело - ДвоичныеДанные - тело пакета, может быть пустым.
Процедура ОтправитьПакет(Знач Тип, Знач Тело) Экспорт
	Если Тип = ПакетыSWP.NEGOTIATE() Тогда
		_Сокет.ОтправитьДвоичныеДанные(Тело);
		Возврат;
	КонецЕсли;
	Кадр = Новый БуферЗаписиSWP();
	Кадр.Байт(Тип).Размер(Тело.Размер()).Двоичные(Тело);
	_Сокет.ОтправитьДвоичныеДанные(Кадр.ДвоичныеДанные());
КонецПроцедуры

// Читает пакет целиком.
//
// Возвращаемое значение:
//   Структура - Тип (Число), Данные (ДвоичныеДанные) — тело пакета.
Функция ПрочитатьПакет() Экспорт
	Тип = ПрочитатьБайт();
	Длина = ПрочитатьДлинуКадра();
	Результат = Новый Структура;
	Результат.Вставить("Тип", Тип);
	Результат.Вставить("Данные", ПрочитатьРовно(Длина));
	Возврат Результат;
КонецФункции

// Закрывает сокет.
Процедура Закрыть() Экспорт
	_Сокет.Закрыть();
КонецПроцедуры

Функция ПрочитатьБайт()
	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ПрочитатьРовно(1))[0];
КонецФункции

// Длина кадра по схеме Size, байт за байтом прямо из сокета.
Функция ПрочитатьДлинуКадра()
	Текущий = ПрочитатьБайт();
	Значение = Текущий % 128;
	Множитель = 128;
	Пока Текущий >= 128 Цикл
		Текущий = ПрочитатьБайт();
		Значение = Значение + (Текущий % 128) * Множитель;
		Множитель = Множитель * 128;
	КонецЦикла;
	Возврат Значение;
КонецФункции

// Сокет может отдать меньше запрошенного — дочитываем и склеиваем порции без побайтового копирования.
Функция ПрочитатьРовно(Знач Количество)
	Если Количество = 0 Тогда
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Новый БуферДвоичныхДанных(0));
	КонецЕсли;
	Порции = Новый Массив;
	Собрано = 0;
	Пока Собрано < Количество Цикл
		Порция = ПрочитатьИзСокета(Количество - Собрано);
		РазмерПорции = Порция.Размер();
		Если РазмерПорции = 0 Тогда
			ВызватьИсключение "SWP: сервер закрыл соединение — получено " + Собрано + " из " + Количество + " байт";
		КонецЕсли;
		Порции.Добавить(Порция);
		Собрано = Собрано + РазмерПорции;
	КонецЦикла;
	Если Порции.Количество() = 1 Тогда
		Возврат Порции[0];
	КонецЕсли;
	Возврат СоединитьДвоичныеДанные(Порции);
КонецФункции

Функция ПрочитатьИзСокета(Знач Количество)
	Попытка
		Возврат _Сокет.ПрочитатьДвоичныеДанные(Количество);
	Исключение
		ВызватьИсключение "SWP: нет ответа от сервера — " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

// Параметры:
//   Сокет - TCPСоединение - открытое соединение.
Процедура ПриСозданииОбъекта(Знач Сокет = Неопределено)
	_Сокет = Сокет;
КонецПроцедуры
