// Обмен сообщениями с открытой конечной точкой SWP в кадрах ENDPOINT_MESSAGE.
// Запрос — [ид точки][формат 0][вид 1][код][тело]; ответ вида 1 несёт данные, вида 0 пуст,
// вид 0xFF и пакет ENDPOINT_FAILURE — ошибка сервиса.
#native

Перем _Канал;  // КаналSWP
Перем _Ид;     // Число — идентификатор конечной точки
Перем _Версия; // Число — версия сериализации сущностей

// Версия сериализации, согласованная при открытии точки.
Функция Версия() Экспорт
	Возврат _Версия;
КонецФункции

// Отправляет запрос и возвращает читатель полезной нагрузки ответа.
//
// Параметры:
//   Код            - Число                      - код запроса сервиса.
//   Тело           - БуферЗаписиSWP, Неопределено - тело запроса; Неопределено — пустое.
//   ОжидаемыйОтвет - Число, Неопределено          - код ответа, который должен прийти; Неопределено — не проверять.
//
// Возвращаемое значение:
//   БуферЧтенияSWP, Неопределено - читатель, установленный на данные ответа; Неопределено — пустой ответ.
Функция Запрос(Знач Код, Знач Тело = Неопределено, Знач ОжидаемыйОтвет = Неопределено) Экспорт
	Кадр = Новый БуферЗаписиSWP();
	Кадр.РазмерNull(_Ид).Короткое(0).Байт(1).Байт(Код);
	Если Тело <> Неопределено Тогда
		Кадр.Двоичные(Тело.ДвоичныеДанные());
	КонецЕсли;
	_Канал.ОтправитьПакет(ПакетыSWP.ENDPOINT_MESSAGE(), Кадр.ДвоичныеДанные());

	Ответ = _Канал.ПрочитатьПакет();
	Если Ответ.Тип = ПакетыSWP.ENDPOINT_FAILURE() Тогда
		ВызватьИсключение "SWP: отказ конечной точки на запрос " + Код + ": " + ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, "UTF-8");
	ИначеЕсли Ответ.Тип <> ПакетыSWP.ENDPOINT_MESSAGE() Тогда
		ВызватьИсключение "SWP: на запрос " + Код + " получен пакет типа " + Ответ.Тип;
	КонецЕсли;

	Читатель = Новый БуферЧтенияSWP(Ответ.Данные);
	Читатель.ПрочитатьРазмерNull(); // ид конечной точки
	Читатель.ПрочитатьКороткое();   // формат
	Вид = Читатель.ПрочитатьБайт();
	Если Вид = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Вид = 255 Тогда
		Сервис = Читатель.ПрочитатьТекст();
		ВызватьИсключение "SWP: исключение сервиса на запрос " + Код + ": " + Сервис + ": " + Читатель.ПрочитатьТекст();
	ИначеЕсли Вид <> 1 Тогда
		ВызватьИсключение "SWP: неизвестный вид сообщения " + Вид + " в ответе на запрос " + Код;
	КонецЕсли;

	КодОтвета = Читатель.ПрочитатьБайт();
	Если ОжидаемыйОтвет <> Неопределено И КодОтвета <> ОжидаемыйОтвет Тогда
		ВызватьИсключение "SWP: на запрос " + Код + " ожидался ответ " + ОжидаемыйОтвет + ", получен " + КодОтвета;
	КонецЕсли;
	Возврат Читатель;
КонецФункции

// Параметры:
//   Канал  - КаналSWP - канал с выполненным рукопожатием.
//   Ид     - Число    - идентификатор открытой конечной точки.
//   Версия - Число    - версия сериализации сущностей.
Процедура ПриСозданииОбъекта(Знач Канал = Неопределено, Знач Ид = 0, Знач Версия = 0)
	_Канал = Канал;
	_Ид = Ид;
	_Версия = Версия;
КонецПроцедуры
