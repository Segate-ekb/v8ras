// Открытие TCP-соединения с пределом времени: TCPСоединение подключается без таймаута, поэтому
// подключение идёт в фоновом задании, а вызывающий ждёт не дольше заданного.
#native

Перем _Открыватель; // Объект с методом ОткрытьБезПредела(Хост, Порт) — подменяется в тестах

// Открывает TCP-соединение к Хост:Порт не дольше ТаймаутМс.
//
// Параметры:
//   Хост      - Строка - адрес сервера.
//   Порт      - Число  - порт.
//   ТаймаутМс - Число  - предел установления соединения, миллисекунд.
//
// Возвращаемое значение:
//   TCPСоединение - открытое соединение; таймауты чтения и отправки не установлены.
//
Функция Открыть(Знач Хост, Знач Порт, Знач ТаймаутМс) Экспорт
	Параметры = Новый Массив;
	Параметры.Добавить(Хост);
	Параметры.Добавить(Порт);
	Задание = ФоновыеЗадания.Выполнить(_Открыватель, "ОткрытьБезПредела", Параметры);
	Попытка
		Задание.ОжидатьЗавершения(ТаймаутМс);
	Исключение
		ВызватьИсключение СтрШаблон("%1:%2: %3", Хост, Порт, ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		// задание останется ждать ответа ОС, его результат никому не нужен
		ВызватьИсключение СтрШаблон("%1:%2: TCP-соединение не установлено за %3 мс", Хост, Порт, ТаймаутМс);
	КонецЕсли;
	Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		ВызватьИсключение СтрШаблон("%1:%2: %3", Хост, Порт, Задание.ИнформацияОбОшибке.Описание);
	КонецЕсли;
	Возврат Задание.Результат;
КонецФункции

// Тело фонового задания: подключение без предела времени. Ошибку ОС переводит в исключение скрипта —
// иначе ОжидатьЗавершения бросает её обёрнутой в AggregateException.
Функция ОткрытьБезПредела(Знач Хост, Знач Порт) Экспорт
	Попытка
		Возврат Новый TCPСоединение(Хост, Порт);
	Исключение
		ВызватьИсключение ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Открыватель = Неопределено)
	_Открыватель = ?(Открыватель = Неопределено, ЭтотОбъект, Открыватель);
КонецПроцедуры
