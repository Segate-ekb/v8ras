// Константы транспорта SWP: магия первого пакета, версии протокола и кодека, типы пакетов.
#native

// Магическое число пакета NEGOTIATE (0x1c535750).
Функция Магия() Экспорт
	Возврат 475223888;
КонецФункции

// Версия транспортного протокола.
Функция ВерсияПротокола() Экспорт
	Возврат 256;
КонецФункции

// Версия кодека значений.
Функция ВерсияКодека() Экспорт
	Возврат 256;
КонецФункции

Функция NEGOTIATE() Экспорт
	Возврат 0;
КонецФункции

Функция CONNECT() Экспорт
	Возврат 1;
КонецФункции

Функция CONNECT_ACK() Экспорт
	Возврат 2;
КонецФункции

Функция ENDPOINT_OPEN() Экспорт
	Возврат 11;
КонецФункции

Функция ENDPOINT_OPEN_ACK() Экспорт
	Возврат 12;
КонецФункции

Функция ENDPOINT_MESSAGE() Экспорт
	Возврат 14;
КонецФункции

Функция ENDPOINT_FAILURE() Экспорт
	Возврат 15;
КонецФункции
