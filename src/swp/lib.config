<?xml version="1.0" encoding="utf-8"?>
<!-- Транспорт SWP — бинарный протокол сервисов 1С: кодек значений, кадры, рукопожатие,
     обмен с конечной точкой и сериализация сущностей по описанию. О кластере не знает:
     сервис, его версии, коды сообщений и описания сущностей задаёт вызывающая сторона. -->
<package-def xmlns="http://oscript.io/schemas/lib-config/1.0">
    <class name="БуферЗаписиSWP" file="Классы/БуферЗаписиSWP.os"/>
    <class name="БуферЧтенияSWP" file="Классы/БуферЧтенияSWP.os"/>
    <class name="ОписаниеСущностиSWP" file="Классы/ОписаниеСущностиSWP.os"/>
    <class name="КаналSWP" file="Классы/КаналSWP.os"/>
    <class name="РукопожатиеSWP" file="Классы/РукопожатиеSWP.os"/>
    <class name="КонечнаяТочкаSWP" file="Классы/КонечнаяТочкаSWP.os"/>
    <module name="ПакетыSWP" file="Модули/ПакетыSWP.os"/>
</package-def>
