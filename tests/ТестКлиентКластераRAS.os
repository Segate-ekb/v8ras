&Тест
Процедура НаВерсии15КластерЧитаетсяСАудитомПингомИРасписанием() Экспорт
	// GET_CLUSTERS: allow-access-right-audit-events-recording=yes, ping-period=1234, ping-timeout=5678, restart-schedule="0 3 * * *"
	Снимок = "01973B4968212540E9AFBE5A436AD09CFF0000003C0C663536366433363134626264000000000605000000000000000021D09BD0BED0BAD0B0D0BBD18CD0BDD18BD0B920D0BAD0BBD0B0D181D182D0B5D1800000000000000000000000000000000001010000000101000004D20000162E09302033202A202A202A";
	Клиент = Подключить(ОтветСнимок(12, Снимок), "15.0");

	Кластер = Клиент.Кластеры()[0];
	Ожидаем.Что(Кластер.Хост).Равно("f566d3614bbd");
	Ожидаем.Что(Кластер.ДампПриПревышенииПамяти).Равно(Истина);
	Ожидаем.Что(Кластер.НеизвестноеЦелое14).Равно(1);
	Ожидаем.Что(Кластер.АудитПравДоступа).Равно(Истина);
	Ожидаем.Что(Кластер.ПериодПинга).Равно(1234);
