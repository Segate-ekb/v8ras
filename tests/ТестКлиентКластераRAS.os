&Тест
Процедура СервисыЧитаютсяСМенеджерамиИПризнакомГлавного() Экспорт
	// GET_CLUSTER_SERVICES: три сервиса из снимка — DebugService только на главном менеджере, SpeechToTextService без менеджеров
	Снимок = "";
	Клиент = Подключить(ОтветСнимок(36, Снимок), "16.0");

	Сервисы = Клиент.Сервисы("6d6958e1-a96c-4999-a995-698a0298161e");
	Ожидаем.Что(Сервисы.Количество()).Равно(3);
	Ожидаем.Что(Сервисы[0].Имя).Равно("LicenseService");
	Ожидаем.Что(Сервисы[0].Описание).Равно("Сервис лицензирования");
	Ожидаем.Что(Сервисы[0].ТолькоГлавныйМенеджер).Равно(Ложь);
	Ожидаем.Что(Сервисы[0].Менеджеры[0]).Равно("2654a056-1093-465d-876e-1fb33d11d8d0");
	Ожидаем.Что(Сервисы[1].Имя).Равно("DebugService");
	Ожидаем.Что(Сервисы[1].ТолькоГлавныйМенеджер).Равно(Истина);
	Ожидаем.Что(Сервисы[2].Менеджеры.Количество()).Равно(0);
	// вид=01 код=35 (0x23) + UUID кластера
