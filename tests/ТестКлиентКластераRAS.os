	Ожидаем.Что(Процесс.СредняяДлительностьВызова).Равно(1.5);
	Ожидаем.Что(Процесс.СреднееЧислоПотоков).Равно(2.5);
	Ожидаем.Что(Процесс.Включён).Равно(Истина);
	Ожидаем.Что(Процесс.Запущен).Равно(Истина);
	Ожидаем.Что(Процесс.Используется).Равно(Истина);
