// BSLLS:LineLength-off
// Клиент кластера на сокете-сценарии: путь подключение → запрос → разбор для чтения и байты
// запроса для управления. Ответы собираются тем же кодеком по описаниям СхемыRAS.

&Тест
Процедура КлиентПодключаетсяИЧитаетКластеры() Экспорт
	Кластер = Новый Структура("Ид,Хост,Порт,Имя", "6d6958e1-a96c-4999-a995-698a0298161e", "app-srv", 1541, "Главный кластер");
	Клиент = Подключить(ОтветСписок(12, СхемыRAS.Кластер(), Кластер));

	Кластеры = Клиент.Кластеры();
	Ожидаем.Что(Кластеры.Количество()).Равно(1);
	Ожидаем.Что(Кластеры[0].Хост).Равно("app-srv");
	Ожидаем.Что(Кластеры[0].Порт).Равно(1541);
	Ожидаем.Что(Кластеры[0].Имя).Равно("Главный кластер");
КонецПроцедуры

&Тест
Процедура КлиентЧитаетСеансСМетрикамиИЛицензией() Экспорт
	Лицензия = Новый Структура("Серия,МаксПользователейВсего,МаксПользователейТекущее", "ORG1234567", 50, 1);
	Лицензии = Новый Массив; Лицензии.Добавить(Лицензия);
	Сеанс = Новый Структура("Приложение,ИмяПользователя,Номер,ВызововВсего,ПамятьВсего,ПроцессорноеВремяВсего,АдресКлиента",
		"1CV8C", "Иванов", 42, 119052, 23178863, 6832, "10.0.0.15");
	Сеанс.Вставить("Лицензии", Лицензии);
	Клиент = Подключить(ОтветСписок(66, СхемыRAS.Сеанс(), Сеанс));

	Результат = Клиент.Сеансы("6d6958e1-a96c-4999-a995-698a0298161e")[0];
	Ожидаем.Что(Результат.ИмяПользователя).Равно("Иванов");
	Ожидаем.Что(Результат.ВызововВсего).Равно(119052);
	Ожидаем.Что(Результат.ПамятьВсего).Равно(23178863);
	Ожидаем.Что(Результат.ПроцессорноеВремяВсего).Равно(6832);
	Ожидаем.Что(Результат.АдресКлиента).Равно("10.0.0.15");
	Ожидаем.Что(Результат.Лицензии[0].Серия).Равно("ORG1234567");
	Ожидаем.Что(Результат.Лицензии[0].МаксПользователейВсего).Равно(50);
КонецПроцедуры

&Тест
Процедура КлиентЧитаетРабочийПроцессСДробнымиПолями() Экспорт
	Процесс = Новый Структура("Хост,Порт,Pid,Соединений,ПамятьКБ,ДоступнаяПроизводительность,СредняяДлительностьВызова,Включен",
		"app-srv", 1562, "12345", 5, 2048000, 100, 1.5, Истина);
	Клиент = Подключить(ОтветСписок(30, СхемыRAS.Процесс(), Процесс));

	Результат = Клиент.РабочиеПроцессы("6d6958e1-a96c-4999-a995-698a0298161e")[0];
	Ожидаем.Что(Результат.Порт).Равно(1562);
	Ожидаем.Что(Результат.ПамятьКБ).Равно(2048000);
	Ожидаем.Что(Результат.СредняяДлительностьВызова).Равно(1.5);
	Ожидаем.Что(Результат.Включен).Равно(Истина);
КонецПроцедуры

&Тест
Процедура КлиентЧитаетРабочийСерверСКороткимиПортами() Экспорт
	Сервер = Новый Структура("ХостАгента,ПортАгента,Имя,ПортКластера,СоединенийНаПроцесс,Центральный",
		"srv-host", 1540, "Центральный", 1541, 100, Истина);
	Клиент = Подключить(ОтветСписок(23, СхемыRAS.Сервер(), Сервер));

	Результат = Клиент.РабочиеСерверы("6d6958e1-a96c-4999-a995-698a0298161e")[0];
	Ожидаем.Что(Результат.ПортАгента).Равно(1540);
	Ожидаем.Что(Результат.ПортКластера).Равно(1541);
	Ожидаем.Что(Результат.СоединенийНаПроцесс).Равно(100);
КонецПроцедуры

&Тест
Процедура КлиентЧитаетАдминистратора() Экспорт
	Админ = Новый Структура("Имя,ПользовательОС", "Админ", "os-user");
	Клиент = Подключить(ОтветСписок(3, СхемыRAS.Администратор(), Админ));

	Результат = Клиент.АдминистраторыКластера("6d6958e1-a96c-4999-a995-698a0298161e")[0];
	Ожидаем.Что(Результат.Имя).Равно("Админ");
	Ожидаем.Что(Результат.ПользовательОС).Равно("os-user");
КонецПроцедуры

&Тест
Процедура ЗавершениеСеансаОтправляетВерныйЗапрос() Экспорт
	Сокет = Новый СокетСценарий(Склеить2(CONNECT_ACK(), OPEN_ACK(3), Пусто()));
	Клиент = Новый КлиентКластераRAS("127.0.0.1", 1545);
	Клиент.Подключить(Сокет);
	Клиент.ЗавершитьСеанс("6d6958e1-a96c-4999-a995-698a0298161e", "1fb5f037-99e8-4924-a99d-a9e687522d32", "стоп");
	// вид=01 код=47(71) + UUID кластера + UUID сеанса
	Ожидаем.Что(Сокет.ОтправленноеHex()).Содержит(
		"01476d6958e1a96c4999a995698a0298161e1fb5f03799e84924a99da9e687522d32");
КонецПроцедуры

&Тест
Процедура РегистрацияКластераПишетОписаниеИЧитаетИд() Экспорт
	Ответ = Новый БуферЗаписиSWP().РазмерNull(3).Короткое(0).Байт(1).Байт(16).УИД("0e588a25-8354-4344-b935-53442312aa30");
	Сокет = Новый СокетСценарий(Склеить2(CONNECT_ACK(), OPEN_ACK(3), Кадр(14, Ответ)));
	Клиент = Новый КлиентКластераRAS("127.0.0.1", 1545);
	Клиент.Подключить(Сокет);

	Ид = Клиент.ЗарегистрироватьКластер(Новый Структура("Хост,Порт,Имя", "app-srv", 1541, "Новый кластер"));
	Ожидаем.Что(Ид).Равно("0e588a25-8354-4344-b935-53442312aa30");
	Ожидаем.Что(Сокет.ОтправленноеHex()).Содержит(НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки("Новый кластер", "UTF-8"))));
КонецПроцедуры

#Область СнимкиЖивогоСервера

// Байты ответов сервера 8.3.27 на разных версиях сервиса; имена хостов заменены строками той же длины.

&Тест
Процедура НаВерсии8КластерЧитаетсяСФлагомДампаПриПревышенииПамяти() Экспорт
	// GET_CLUSTERS, kill-problem-processes=yes, kill-by-memory-with-dump=yes
	Снимок = "01973B4968212540E9AFBE5A436AD09CFF0000003C0C663536366433363134626264000000000605000000000000000021D09BD0BED0BAD0B0D0BBD18CD0BDD18BD0B920D0BAD0BBD0B0D181D182D0B5D180000000000000000000000000000000000101";
	Клиент = Подключить(ОтветСнимок(12, Снимок), "8.0");

	Кластер = Клиент.Кластеры()[0];
	Ожидаем.Что(Кластер.Хост).Равно("f566d3614bbd");
	Ожидаем.Что(Кластер.Порт).Равно(1541);
	Ожидаем.Что(Кластер.ЗавершатьПроблемныеПроцессы).Равно(Истина);
	Ожидаем.Что(Кластер.ДампПриПревышенииПамяти).Равно(Истина);
	ОжидаемРазборБезОстатка(Снимок, СхемыRAS.Кластер(), 8);
КонецПроцедуры

&Тест
Процедура НаВерсии11СерверЧитаетсяСИменемСервисногоПринципала() Экспорт
	// GET_WORKING_SERVERS: service-principal-name не задан, восемь байт на три лимита памяти с версии 8
	Снимок = "01CE5EC63F0D9D4D098FB42EF8BAA1C1EF0B31632E746573742E6C616E060423D0A6D0B5D0BDD182D180D0B0D0BBD18CD0BDD18BD0B920D181D0B5D180D0B2D0B5D18001000000000000000000000000000000000000000800000000000000000000010006050001061D061800000000000000000000000000000000000000000000012C00";
	Клиент = Подключить(ОтветСнимок(23, Снимок), "11.0");

	Сервер = Клиент.РабочиеСерверы("6d6958e1-a96c-4999-a995-698a0298161e")[0];
	Ожидаем.Что(Сервер.ХостАгента).Равно("1c.test.lan");
	Ожидаем.Что(Сервер.Имя).Равно("Центральный сервер");
	Ожидаем.Что(Сервер.СоединенийНаПроцесс).Равно(256);
	Ожидаем.Что(Сервер.ДиапазоныПортов[0].Верхний).Равно(1565);
	Ожидаем.Что(Сервер.ИнтервалВременногоПревышенияПамяти).Равно(300);
	Ожидаем.Что(Сервер.ИмяСервисногоПринципала).Равно("");
	ОжидаемРазборБезОстатка(Снимок, СхемыRAS.Сервер(), 11);
КонецПроцедуры

