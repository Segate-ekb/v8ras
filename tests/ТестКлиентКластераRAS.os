	Клиент = Новый КлиентКластераRAS("127.0.0.1", 1545);
	Клиент.Подключить(Сокет);
	Сеансы = Клиент.Сеансы("6d6958e1-a96c-4999-a995-698a0298161e");

	Ожидаем.Что(Сеансы.Количество()).Равно(1);
	Сеанс = Сеансы[0];
	Ожидаем.Что(Сеанс.Приложение).Равно("1CV8C");
	Ожидаем.Что(Сеанс.ИмяПользователя).Равно("Админ");
	Ожидаем.Что(Сеанс.Номер).Равно(42);
	Ожидаем.Что(Сеанс.ВызововВсего).Равно(119052);
	Ожидаем.Что(Сеанс.ПамятьВсего).Равно(23178863);
	Ожидаем.Что(Сеанс.ПроцессорноеВремяВсего).Равно(6832);
	Ожидаем.Что(Сеанс.ЧислоЛицензий).Равно(1);
	Ожидаем.Что(Сеанс.Лицензии[0].Серия).Равно("ABC");
	Ожидаем.Что(Сеанс.Лицензии[0].ВсегоЛицензий).Равно(100);
	Ожидаем.Что(Сеанс.Лицензии[0].ЗанятоЛицензий).Равно(1);
	Ожидаем.Что(Сеанс.АдресКлиента).Равно("127.0.0.1");
КонецПроцедуры

&Тест
Процедура КлиентЧитаетРабочиеПроцессы() Экспорт
