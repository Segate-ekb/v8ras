&Тест
Процедура ТребованияНазначенияНовогоСервераЧитаютсяСПолямиВерсий17И21() Экспорт
	// GET_ASSIGNMENT_RULES с сервера 8.5.1 (версия сервиса 22): после приоритета байт (с 17) и длинное -1 (с 21);
	// за списком сервер 21+ шлёт ещё один байт, который к сущности не относится
	Снимок = "0136b336f1c8f54594b6a575a2640cdc6e000369623100000002000000000500ffffffffffffffff00";
	Клиент = Подключить(ОтветСнимок(86, Снимок), "22.0");

	Требование = Клиент.ТребованияНазначения("6d6958e1-a96c-4999-a995-698a0298161e", "1fb5f037-99e8-4924-a99d-a9e687522d32")[0];
	Ожидаем.Что(Требование.Ид).Равно("36b336f1-c8f5-4594-b6a5-75a2640cdc6e");
	Ожидаем.Что(Требование.ИмяБазы).Равно("ib1");
	Ожидаем.Что(Требование.ТипПравила).Равно(2);
	Ожидаем.Что(Требование.Приоритет).Равно(5);

	Буфер = Новый БуферЧтенияSWP(ПолучитьДвоичныеДанныеИзHexСтроки(Снимок));
	Буфер.ПрочитатьСписок(СхемыRAS.ТребованиеНазначения(), 22);
	Ожидаем.Что(Буфер.Остаток(), "за списком требований остаётся только хвостовой байт сервера").Равно(1);
КонецПроцедуры

&Тест
Процедура ТребованиеНазначенияВставляетсяСПозициейИЧитаетИд() Экспорт
	Ответ = Новый БуферЗаписиSWP().РазмерNull(3).Короткое(0).Байт(1).Байт(83).УИД("0e588a25-8354-4344-b935-53442312aa30");
	Клиент = Подключить(Кадр(14, Ответ));

	Инфо = Новый Структура("ИмяБазы,ТипПравила,Приоритет", "trade", 2, 5);
	Ид = Клиент.ДобавитьТребованиеНазначения("6d6958e1-a96c-4999-a995-698a0298161e", "1fb5f037-99e8-4924-a99d-a9e687522d32", Инфо, 1);
	Ожидаем.Что(Ид).Равно("0e588a25-8354-4344-b935-53442312aa30");
	// вид=01 код=82 (0x52) + UUID кластера + UUID сервера + нулевой UUID требования + тип объекта "" + "trade" + тип 2 + приложение "" + приоритет 5 + позиция 1
	Ожидаем.Что(Сокет(Клиент).ОтправленноеHex()).Содержит("01526d6958e1a96c4999a995698a0298161e1fb5f03799e84924a99da9e687522d32"
		+ "00000000000000000000000000000000" + "00" + "057472616465" + "00000002" + "00" + "00000005" + "00000001");
