#Использовать "fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Клиент кластера на сокете-сценарии: полный путь подключение → запрос → разбор.
// Ответы сервера собираются тем же кодеком в точном порядке полей протокола.

&Тест
Процедура КлиентПодключаетсяИЧитаетКластеры() Экспорт
	Поток = Склеить(ПакетCONNECT_ACK(), ПакетOPEN_ACK("10.0", 3), КадрОтвета(12, ТелоКластеров()));
	Сокет = Новый СокетСценарий(Поток);

	Клиент = Новый КлиентКластераRAS("127.0.0.1", 1545);
	Клиент.Подключить(Сокет);

	Ожидаем.Что(Клиент.ВерсияСервиса()).Равно("10.0");

	Кластеры = Клиент.Кластеры();
	Ожидаем.Что(Кластеры.Количество()).Равно(1);
	Ожидаем.Что(Кластеры[0].Ид).Равно("6d6958e1-a96c-4999-a995-698a0298161e");
	Ожидаем.Что(Кластеры[0].Хост).Равно("app-srv");
	Ожидаем.Что(Кластеры[0].Порт).Равно(1541);
	Ожидаем.Что(Кластеры[0].Имя).Равно("Главный кластер");
КонецПроцедуры

&Тест
Процедура КлиентЧитаетСеансыСМетриками() Экспорт
	Поток = Склеить(ПакетCONNECT_ACK(), ПакетOPEN_ACK("10.0", 3), КадрОтвета(66, ТелоСеансов()));
