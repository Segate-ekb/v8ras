&Тест
Процедура ИнформацияОБазеПишетсяИЧитаетсяСимметрично() Экспорт
	Инфо = Новый Структура();
	Инфо.Вставить("Ид", "aea71760-15b3-485a-9a35-506eb8a0b04a");
	Инфо.Вставить("СУБД", "PostgreSQL");
	Инфо.Вставить("ИмяБД", "acc");
	Инфо.Вставить("СерверБД", "pg-host");
	Инфо.Вставить("Имя", "accounting");
	Инфо.Вставить("Описание", "Бухгалтерия");
	Инфо.Вставить("ЗапретСеансов", Истина);
	Инфо.Вставить("УровеньБезопасности", 1);
	Инфо.Вставить("РезервироватьРабочиеПроцессы", Истина);

	Буфер = Новый БуферЗаписи();
	СущностиRAS.ФорматироватьИнформациюОБазы(Буфер, Инфо, 10);
	Прочитано = СущностиRAS.РазобратьИнформациюОБазы(Новый БуферЧтения(Буфер.ДвоичныеДанные()), 10);

	Ожидаем.Что(Прочитано.Ид).Равно("aea71760-15b3-485a-9a35-506eb8a0b04a");
	Ожидаем.Что(Прочитано.СУБД).Равно("PostgreSQL");
	Ожидаем.Что(Прочитано.ИмяБД).Равно("acc");
	Ожидаем.Что(Прочитано.СерверБД).Равно("pg-host");
	Ожидаем.Что(Прочитано.Имя).Равно("accounting");
	Ожидаем.Что(Прочитано.ЗапретСеансов).Равно(Истина);
	Ожидаем.Что(Прочитано.УровеньБезопасности).Равно(1);
	Ожидаем.Что(Прочитано.РезервироватьРабочиеПроцессы).Равно(Истина);
КонецПроцедуры

#Область Сборка

Функция ТелоБлокировок()
	Тело = Новый БуферЗаписи();
	Тело.Размер(1);
	Тело.УИД("8adf4514-0379-4333-a153-0b2689edc415"); // connection
	Тело.Текст("Ожидание на объекте");
	Тело.Длинное(0);                                   // locked_at
	Тело.УИД("1af2e54f-d95a-4370-9b45-8277280cad23"); // object
	Тело.УИД("1fb5f037-99e8-4924-a99d-a9e687522d32"); // session
	Возврат Тело;
КонецФункции

Функция ТелоСерверов()
	Тело = Новый БуферЗаписи();
	Тело.Размер(1);
	Тело.УИД("2b5f037f-99e8-4924-a99d-a9e687522d32");
	Тело.Текст("srv-host");   // agent_host
	Тело.Короткое(1540);      // agent_port
	Тело.Текст("Центральный"); // name
	Тело.Флаг(Истина);        // main_server
	Тело.Длинное(0);          // safe_working_processes_memory_limit
	Тело.Длинное(0);          // safe_call_memory_limit
	Тело.Целое(8);            // infobases_limit
	Тело.Длинное(4096000000); // memory_limit
	Тело.Целое(100);          // connections_limit
	Тело.Короткое(1541);      // cluster_port
	Тело.Флаг(Ложь);          // dedicate_managers
	Тело.Размер(1);           // один диапазон портов
	Тело.Короткое(1591);      // верхняя
	Тело.Короткое(1560);      // нижняя
	Тело.Длинное(0).Длинное(0).Длинное(0); // версия 8: критическая/временная память
	Возврат Тело;
КонецФункции

Функция ТелоИнфобаз()
	Тело = Новый БуферЗаписи();
	Тело.Размер(1);
	Тело.УИД("aea71760-15b3-485a-9a35-506eb8a0b04a");
	Тело.Текст("Бухгалтерия"); // description
	Тело.Текст("accounting");  // name
	Возврат Тело;
КонецФункции

Функция ТелоКластеров()
	Тело = Новый БуферЗаписи();
	Тело.Размер(1); // один кластер
	Тело.УИД("6d6958e1-a96c-4999-a995-698a0298161e");
	Тело.Целое(0);              // expiration_timeout
	Тело.Текст("app-srv");      // host
	Тело.Целое(0);              // life_time_limit
	Тело.Короткое(1541);        // port
	Тело.Целое(0);              // max_memory_size
	Тело.Целое(0);              // max_memory_time_limit
	Тело.Текст("Главный кластер"); // name
	Тело.Целое(0);              // security_level
	Тело.Целое(0);              // session_fault_tolerance_level
	Тело.Целое(0);              // load_balancing_mode
	Тело.Целое(0);              // errors_count_threshold
	Тело.Флаг(Ложь);            // kill_problem_processes
	Тело.Флаг(Ложь);            // kill_by_memory_with_dump (версия 10 > 8)
	Возврат Тело;
КонецФункции

Функция ТелоСеансов()
	Тело = Новый БуферЗаписи();
	Тело.Размер(1); // один сеанс
	Тело.УИД("1fb5f037-99e8-4924-a99d-a9e687522d32");
	Тело.Текст("1CV8C");        // app_id
	Тело.Целое(0);              // blocked_by_dbms
	Тело.Целое(0);              // blocked_by_ls
	Тело.Длинное(105972550);    // bytes_all
	Тело.Длинное(0);            // bytes_last5min
	Тело.Целое(119052);         // calls_all
	Тело.Длинное(0);            // calls_last5min
	Тело.УИД("8adf4514-0379-4333-a153-0b2689edc415"); // connection_id
	Тело.Длинное(0);            // dbms_bytes_all
	Тело.Длинное(0);            // dbms_bytes_last5min
	Тело.Текст("");             // db_proc_info
	Тело.Целое(0);              // db_proc_took
	Тело.Длинное(0);            // db_proc_took_at (ticks)
	Тело.Целое(66184);          // duration_all
	Тело.Целое(43242);          // duration_all_dbms
	Тело.Целое(0);              // duration_current
	Тело.Целое(0);              // duration_current_dbms
	Тело.Длинное(0);            // duration_last5min
	Тело.Длинное(0);            // duration_last5min_dbms
	Тело.Текст("app-srv");      // host
	Тело.УИД("aea71760-15b3-485a-9a35-506eb8a0b04a"); // infobase_id
	Тело.Длинное(0);            // last_active_at
	Тело.Флаг(Ложь);            // hibernate
	Тело.Целое(0);              // passive_session_hibernate_time
	Тело.Целое(0);              // hibernate_session_terminate_time
	Тело.Размер(1);             // licenses: одна лицензия
	ТелоЛицензии(Тело);
	Тело.Текст("ru_RU");        // locale
	Тело.УИД("1af2e54f-d95a-4370-9b45-8277280cad23"); // process_id
	Тело.Целое(42);             // session id
	Тело.Длинное(0);            // started_at
	Тело.Текст("Админ");        // user_name
	// версия >= 4
	Тело.Длинное(0).Длинное(416379).Длинное(23178863); // memory current/5min/total
	Тело.Длинное(156162).Длинное(156162).Длинное(15616); // read current/5min/total
	Тело.Длинное(0).Длинное(123).Длинное(1071457);      // write current/5min/total
	// версия >= 5
	Тело.Целое(0).Длинное(30).Целое(515).Текст("name");
	// версия >= 6
	Тело.Длинное(0).Длинное(280).Длинное(6832);         // cpu current/5min/total
	// версия >= 7
	Тело.Текст("sep=0");
	// версия >= 10
	Тело.Текст("127.0.0.1");
	Возврат Тело;
КонецФункции

Процедура ТелоЛицензии(ЦельБуфер)
	ЦельБуфер.Текст("full").Текст("full-presentation").Флаг(Истина).Целое(1);
	ЦельБуфер.Целое(100).Целое(1).Флаг(Истина).Текст("addr").Текст("pid").Целое(1562);
	ЦельБуфер.Текст("ABC").Текст("short");
КонецПроцедуры

Функция ТелоПроцессов()
	Тело = Новый БуферЗаписи();
	Тело.Размер(1); // один процесс
	Тело.УИД("1af2e54f-d95a-4370-9b45-8277280cad23");
	ДописатьHex(Тело, "0000000000000000"); // avg_back_call_time 0.0
	ДописатьHex(Тело, "3ff8000000000000"); // avg_call_time 1.5
	ДописатьHex(Тело, "0000000000000000"); // avg_db_call_time
	ДописатьHex(Тело, "0000000000000000"); // avg_lock_call_time
	ДописатьHex(Тело, "3fe0000000000000"); // avg_server_call_time 0.5
	ДописатьHex(Тело, "4004000000000000"); // avg_threads 2.5
	Тело.Целое(1000);        // capacity
	Тело.Целое(5);           // connections
	Тело.Текст("app-srv");   // host
	Тело.Флаг(Истина);       // enable
	Тело.Размер(1);          // licenses
	ТелоЛицензии(Тело);
	Тело.Короткое(1562);     // port
	Тело.Целое(0);           // memory_excess_time
	Тело.Целое(2048000);     // memory_size
	Тело.Текст("12345");     // pid
	Тело.Целое(1);           // running
	Тело.Целое(0);           // selection_size
	Тело.Длинное(0);         // started_at
	Тело.Целое(1);           // use
	Тело.Целое(100);         // available_perfomance
	Тело.Флаг(Ложь);         // reverse (версия 10 >= 9)
	Возврат Тело;
КонецФункции

Процедура ДописатьHex(ЦельБуфер, Знач Hex)
	Индекс = 1;
	Пока Индекс <= СтрДлина(Hex) Цикл
		Разряды = "0123456789abcdef";
		Значение = (Найти(Разряды, Сред(Hex, Индекс, 1)) - 1) * 16 + (Найти(Разряды, Сред(Hex, Индекс + 1, 1)) - 1);
		ЦельБуфер.Байт(Значение);
		Индекс = Индекс + 2;
	КонецЦикла;
КонецПроцедуры

// Кадр ENDPOINT_MESSAGE с полезной нагрузкой: [ид точки][формат=0][вид=1][код ответа][тело].
Функция КадрОтвета(Знач КодОтвета, Знач ТелоБуфер)
	Конверт = Новый БуферЗаписи();
	Конверт.РазмерNull(3).Короткое(0).Байт(1).Байт(КодОтвета);
	ДобавитьБайты(Конверт, ТелоБуфер);
	Возврат Кадр(14, Конверт);
КонецФункции

Функция Склеить(Знач Буфер1, Знач Буфер2, Знач Буфер3)
	Итог = Новый БуферЗаписи();
	ДобавитьБайты(Итог, Буфер1);
	ДобавитьБайты(Итог, Буфер2);
	ДобавитьБайты(Итог, Буфер3);
	Возврат Итог.ДвоичныеДанные();
КонецФункции

Процедура ДобавитьБайты(ЦельБуфер, Знач ИсточникБуфер)
	Если ИсточникБуфер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ИсточникБуфер.ДвоичныеДанные());
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		ЦельБуфер.Байт(Буфер[Индекс]);
	КонецЦикла;
КонецПроцедуры

Функция Кадр(Знач Тип, Знач ТелоБуфер)
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ТелоБуфер.ДвоичныеДанные());
	Рамка = Новый БуферЗаписи();
	Рамка.Байт(Тип).Размер(Буфер.Размер);
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Рамка.Байт(Буфер[Индекс]);
	КонецЦикла;
	Возврат Рамка;
КонецФункции

Функция ПакетCONNECT_ACK()
	Возврат Кадр(2, Новый БуферЗаписи());
КонецФункции

Функция ПакетOPEN_ACK(Знач Версия, Знач ИдКонечнойТочки)
	Тело = Новый БуферЗаписи();
	Тело.Текст("v8.service.Admin.Cluster").Текст(Версия).РазмерNull(ИдКонечнойТочки);
	Возврат Кадр(12, Тело);
КонецФункции

#КонецОбласти
