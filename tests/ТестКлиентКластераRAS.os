	Процессы = Клиент.РабочиеПроцессы("6d6958e1-a96c-4999-a995-698a0298161e");

	Ожидаем.Что(Процессы.Количество()).Равно(1);
	Процесс = Процессы[0];
	Ожидаем.Что(Процесс.Хост).Равно("app-srv");
	Ожидаем.Что(Процесс.Порт).Равно(1562);
	Ожидаем.Что(Процесс.Pid).Равно("12345");
	Ожидаем.Что(Процесс.Соединения).Равно(5);
