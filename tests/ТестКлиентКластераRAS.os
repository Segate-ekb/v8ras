#КонецОбласти

#Область Сборка

Функция Подключить(Знач ХвостОтвета, Знач Версия = "10.0")
	Сокет = Новый СокетСценарий(Склеить2(CONNECT_ACK(), OPEN_ACK(3, Версия), ХвостОтвета));
	Клиент = Новый КлиентКластераRAS("127.0.0.1", 1545).Подключить(Сокет);
	Сокеты.Вставить(Клиент, Сокет);
	Возврат Клиент;
КонецФункции

// Сокет-сценарий, на котором подключён клиент из Подключить(): чтобы проверить отправленные байты.
Функция Сокет(Знач Клиент)
	Возврат Сокеты.Получить(Клиент);
КонецФункции

// Ответ из снимка: конверт [ид точки][формат][вид 1][код] + байты тела, снятые с живого сервера.
Функция ОтветСнимок(Знач КодОтвета, Знач Hex)
	Конверт = Новый БуферЗаписиSWP().РазмерNull(3).Короткое(0).Байт(1).Байт(КодОтвета);
	Возврат Кадр(14, Конверт.Двоичные(ПолучитьДвоичныеДанныеИзHexСтроки(Hex)));
КонецФункции

// Список снимка разбирается описанием на версии целиком: лишних байтов в схеме нет.
Процедура ОжидаемРазборБезОстатка(Знач Hex, Знач Описание, Знач Версия)
	Буфер = Новый БуферЧтенияSWP(ПолучитьДвоичныеДанныеИзHexСтроки(Hex));
	Буфер.ПрочитатьСписок(Описание, Версия);
	Ожидаем.Что(Буфер.Остаток(), "остаток байтов после разбора " + Описание.Имя() + " на версии " + Версия).Равно(0);
КонецПроцедуры

// Ответ-список из одной сущности: конверт [ид точки][формат][вид 1][код] + Size(1) + сущность.
Функция ОтветСписок(Знач КодОтвета, Знач Описание, Знач Сущность)
	Конверт = Новый БуферЗаписиSWP().РазмерNull(3).Короткое(0).Байт(1).Байт(КодОтвета);
	Конверт.Размер(1).Сущность(Описание, Сущность, 10);
	Возврат Кадр(14, Конверт);
КонецФункции

Функция Пусто()
	Возврат Кадр(14, Новый БуферЗаписиSWP().РазмерNull(3).Короткое(0).Байт(0));
КонецФункции

Функция Склеить2(Знач Б1, Знач Б2, Знач Б3)
	Части = Новый Массив; Части.Добавить(Б1); Части.Добавить(Б2); Части.Добавить(Б3);
	Возврат СоединитьДвоичныеДанные(Части);
КонецФункции

Функция Кадр(Знач Тип, Знач ТелоБуфер)
	Возврат Новый БуферЗаписиSWP().Байт(Тип).Размер(ТелоБуфер.Длина()).Двоичные(ТелоБуфер.ДвоичныеДанные()).ДвоичныеДанные();
КонецФункции

Функция CONNECT_ACK()
	Возврат Кадр(2, Новый БуферЗаписиSWP());
КонецФункции

Функция OPEN_ACK(Знач Ид, Знач Версия = "10.0")
	Возврат Кадр(12, Новый БуферЗаписиSWP().Текст("v8.service.Admin.Cluster").Текст(Версия).РазмерNull(Ид));
КонецФункции

#КонецОбласти

Сокеты = Новый Соответствие;
