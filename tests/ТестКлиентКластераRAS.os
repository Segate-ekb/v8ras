&Тест
Процедура СчётчикиЧитаютсяИзСнимкаСервера() Экспорт
	// GET_RESOURCE_COUNTERS: два счётчика — по пользователям за 10 минут и по разделителям за текущий вызов
	Снимок = "";
	Клиент = Подключить(ОтветСнимок(119, Снимок), "16.0");

	Счётчики = Клиент.Счётчики("6d6958e1-a96c-4999-a995-698a0298161e");
	Ожидаем.Что(Счётчики.Количество()).Равно(2);
	Ожидаем.Что(Счётчики[0].Имя).Равно("otel-users-10min");
	Ожидаем.Что(Счётчики[0].ПериодСбора).Равно(600);
	Ожидаем.Что(Счётчики[0].Группа).Равно(0);
	Ожидаем.Что(Счётчики[0].ТипОтбора).Равно(2);
	Ожидаем.Что(Счётчики[0].Отбор).Равно("");
	Ожидаем.Что(Счётчики[0].АнализироватьДлительность).Равно(Истина);
	Ожидаем.Что(Счётчики[0].АнализироватьСеансы).Равно(Истина);
	Ожидаем.Что(Счётчики[0].Описание).Равно("otel: все ресурсы по пользователям, 10 мин");
	Ожидаем.Что(Счётчики[1].Имя).Равно("otel-call");
	Ожидаем.Что(Счётчики[1].ПериодСбора).Равно(0);
	Ожидаем.Что(Счётчики[1].Группа).Равно(1);
	// вид=01 код=118 (0x76) + UUID кластера
	Ожидаем.Что(Сокет(Клиент).ОтправленноеHex()).Содержит("01766d6958e1a96c4999a995698a0298161e");
	ОжидаемРазборБезОстатка(Снимок, СхемыRAS.Счётчик(), 16);
КонецПроцедуры

