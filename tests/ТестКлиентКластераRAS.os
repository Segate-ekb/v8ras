&Тест
Процедура НаВерсии13БазаЧитаетсяСЗапретомЛокальногоРаспознаванияРечи() Экспорт
	// GET_INFOBASE_INFO одной базы и GET_INFOBASES двух баз того же кластера
	Снимок = "7E4C9721E8F14EE2A110CF1D7D8C89FB000000000A506F737467726553514C0870726F647563657203EFBFBD0B70672E746573742E6C616E08706F7374677265730000000000000000000000000000000000000A746573742D7374616E640572755F52550870726F64756365720000000000000000000001000000000000";
	Список = "";
	Клиент = Подключить(ОтветСнимок(49, Снимок), "13.0");

	База = Клиент.ИнформацияОБазе("6d6958e1-a96c-4999-a995-698a0298161e", "7e4c9721-e8f1-4ee2-a110-cf1d7d8c89fb");
	Ожидаем.Что(База.Имя).Равно("producer");
	Ожидаем.Что(База.СУБД).Равно("PostgreSQL");
	Ожидаем.Что(База.СерверБД).Равно("pg.test.lan");
	Ожидаем.Что(База.Описание).Равно("test-stand");
	Ожидаем.Что(База.ВыдачаЛицензийСервером).Равно(1);
	Ожидаем.Что(База.ЗапретЛокальногоРаспознаванияРечи).Равно(Ложь);
	ОжидаемРазборБезОстатка(Список, СхемыRAS.База(), 13);
КонецПроцедуры

