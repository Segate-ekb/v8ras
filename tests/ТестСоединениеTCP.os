#Использовать "../src/swp"
#Использовать "fixtures"
#Использовать asserts

// Открытие TCP-соединения с пределом времени: подключение дольше предела прерывается, быстрое
// отдаёт сокет, отказ сервера пробрасывается с адресом.

&Тест
Процедура ПодключениеДольшеПределаПрерывается() Экспорт
	Открыватель = Новый ОткрывательСценарий(3000, "сокет");
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Сокет = Новый СоединениеTCP(Открыватель).Открыть("ras-host", 1545, 200);
		ВызватьИсключение "ожидали исключение по пределу времени, получили " + Сокет;
	Исключение
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("ras-host:1545: TCP-соединение не установлено за 200 мс");
	КонецПопытки;
	Ожидаем.Что(ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт).Меньше(2000);
КонецПроцедуры

&Тест
Процедура БыстроеПодключениеОтдаётСокет() Экспорт
	Открыватель = Новый ОткрывательСценарий(0, "сокет");
	Сокет = Новый СоединениеTCP(Открыватель).Открыть("ras-host", 1545, 1000);
	Ожидаем.Что(Сокет).Равно("сокет");
КонецПроцедуры

&Тест
Процедура ОтказСервераПробрасываетсяСАдресом() Экспорт
	Открыватель = Новый ОткрывательСценарий(0, Неопределено, "Connection refused");
	Попытка
		Сокет = Новый СоединениеTCP(Открыватель).Открыть("ras-host", 1545, 1000);
		ВызватьИсключение "ожидали исключение отказа, получили " + Сокет;
	Исключение
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("ras-host:1545: ");
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("Connection refused");
	КонецПопытки;
КонецПроцедуры

&Тест
Процедура ОтказНастоящегоСокетаПробрасываетсяСАдресом() Экспорт
	// порт 1 на localhost никто не слушает: ОС отвечает отказом сразу
	Попытка
		Сокет = Новый СоединениеTCP().Открыть("127.0.0.1", 1, 5000);
		ВызватьИсключение "ожидали исключение отказа, получили " + Сокет;
	Исключение
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("127.0.0.1:1: ");
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Не_().Содержит("AggregateException");
	КонецПопытки;
КонецПроцедуры
