#Использовать "../src/internal"
#Использовать asserts

// BSLLS:LineLength-off
// Кодек чтения: обратная сторона записи. Прогоняем значения туда-обратно и
// отдельно разбираем эталонные байты протокола.

&Тест
Процедура ЦелыеЧитаютсяОбратноЗаписи() Экспорт
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Короткое(256)).ПрочитатьКороткое()).Равно(256);
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Целое(2000)).ПрочитатьЦелое()).Равно(2000);
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Целое(475223888)).ПрочитатьЦелое()).Равно(475223888);
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Длинное(9000000000)).ПрочитатьДлинное()).Равно(9000000000);
КонецПроцедуры

&Тест
Процедура РазмерЧитаетсяОбратноЗаписи() Экспорт
	Значения = СтрРазделить("0,1,63,64,127,128,255,256,16383,16384,100000", ",");
	Для Каждого Текст Из Значения Цикл
		Значение = Число(Текст);
		Прочитано = Читатель(Новый БуферЗаписи().Размер(Значение)).ПрочитатьРазмер();
		Ожидаем.Что(Прочитано, "Size " + Значение).Равно(Значение);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура РазмерNullЧитаетсяОбратноЗаписи() Экспорт
	Значения = СтрРазделить("0,1,63,64,127,128,255,256,4095,4096,100000", ",");
	Для Каждого Текст Из Значения Цикл
		Значение = Число(Текст);
		Прочитано = Читатель(Новый БуферЗаписи().РазмерNull(Значение)).ПрочитатьРазмерNull();
		Ожидаем.Что(Прочитано, "NullableSize " + Значение).Равно(Значение);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура СтрокаЧитаетсяОбратноЗаписи() Экспорт
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Текст("")).ПрочитатьТекст()).Равно("");
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Текст("Привет")).ПрочитатьТекст()).Равно("Привет");
	Длинная = "v8.service.Admin.Cluster";
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Текст(Длинная)).ПрочитатьТекст()).Равно(Длинная);
КонецПроцедуры

&Тест
Процедура UUIDЧитаетсяОбратноЗаписи() Экспорт
	Идентификатор = "6d6958e1-a96c-4999-a995-698a0298161e";
	Ожидаем.Что(Читатель(Новый БуферЗаписи().УИД(Идентификатор)).ПрочитатьУИД()).Равно(Идентификатор);
КонецПроцедуры

&Тест
Процедура ДвойноеЧитаетсяПоIEEE754() Экспорт
	Ожидаем.Что(Двойное("3ff0000000000000")).Равно(1);
	Ожидаем.Что(Двойное("3fe0000000000000")).Равно(0.5);
	Ожидаем.Что(Двойное("4004000000000000")).Равно(2.5);
	Ожидаем.Что(Двойное("c004000000000000")).Равно(-2.5);
	Ожидаем.Что(Двойное("0000000000000000")).Равно(0);
КонецПроцедуры

&Тест
Процедура ФлагЧитаетсяОбратноЗаписи() Экспорт
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Флаг(Истина)).ПрочитатьФлаг()).Равно(Истина);
	Ожидаем.Что(Читатель(Новый БуферЗаписи().Флаг(Ложь)).ПрочитатьФлаг()).Равно(Ложь);
КонецПроцедуры

&Тест
Процедура ПозицияИОстатокДвигаютсяПриЧтении() Экспорт
	Читал = Читатель(Новый БуферЗаписи().Целое(1).Целое(2));
	Ожидаем.Что(Читал.Остаток()).Равно(8);
	Читал.ПрочитатьЦелое();
	Ожидаем.Что(Читал.Остаток()).Равно(4);
	Ожидаем.Что(Читал.ПрочитатьЦелое()).Равно(2);
	Ожидаем.Что(Читал.ЕстьДанные()).Равно(Ложь);
КонецПроцедуры

&Тест
Процедура ЧтениеЗаГраницейБуфераБросаетИсключение() Экспорт
	Читал = Читатель(Новый БуферЗаписи().Байт(7));
	Читал.ПрочитатьБайт();
	Ожидаем.Что(ТекстИсключения(Читал)).Содержит("границей");
КонецПроцедуры

Функция Читатель(Знач Буфер)
	Возврат Новый БуферЧтения(Буфер.ДвоичныеДанные());
КонецФункции

Функция Двойное(Знач Hex)
	Строитель = Новый БуферЗаписи();
	Индекс = 1;
	Пока Индекс <= СтрДлина(Hex) Цикл
		Строитель.Байт(ЧислоИзHex(Сред(Hex, Индекс, 2)));
		Индекс = Индекс + 2;
	КонецЦикла;
	Возврат Новый БуферЧтения(Строитель.ДвоичныеДанные()).ПрочитатьДвойное();
КонецФункции

Функция ЧислоИзHex(Знач Пара)
	Разряды = "0123456789abcdef";
	Возврат (Найти(Разряды, Сред(Пара, 1, 1)) - 1) * 16 + (Найти(Разряды, Сред(Пара, 2, 1)) - 1);
КонецФункции

Функция ТекстИсключения(Знач Читал)
	Попытка
		Читал.ПрочитатьБайт();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции
