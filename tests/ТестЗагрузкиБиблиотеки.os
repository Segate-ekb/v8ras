#Использовать asserts
#Использовать tempfiles

// BSLLS:LineLength-off
// Загрузка библиотеки рядом с чужими глобальными модулями. Библиотеки поставки OneScript (semver — «Версии»,
// logos — «Логирование», fs — «ФС» …) регистрируют глобальные модули, и в #native-модуле локальная переменная
// с таким же именем ломает компиляцию (EvilBeaver/OneScript#1800). Поэтому библиотека грузится в отдельном
// процессе oscript после подключения этих библиотек.

&Тест
Процедура БиблиотекаГрузитсяПослеSemver() Экспорт
	ПроверитьЗагрузкуПосле("semver");
КонецПроцедуры

&Тест
Процедура БиблиотекаГрузитсяПослеБиблиотекПоставки() Экспорт
	ПроверитьЗагрузкуПосле("semver logos fs tempfiles strings json cmdline 1commands");
КонецПроцедуры

Процедура ПроверитьЗагрузкуПосле(Знач Библиотеки)
	Сценарий = ВременныеФайлы.НовоеИмяФайла("os");
	Запись = Новый ЗаписьТекста(Сценарий, КодировкаТекста.UTF8);
	Для Каждого Библиотека Из СтрРазделить(Библиотеки, " ", Ложь) Цикл
		Запись.ЗаписатьСтроку("#Использовать " + Библиотека);
	КонецЦикла;
	Запись.ЗаписатьСтроку("#Использовать """ + КореньБиблиотеки() + """");
	Запись.ЗаписатьСтроку("Клиент = Новый КлиентКластераRAS(""localhost"", 1545);");
	Запись.ЗаписатьСтроку("Сообщить(""OK"");");
	Запись.Закрыть();

	Процесс = СоздатьПроцесс("oscript """ + Сценарий + """", , Истина, Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	Вывод = Процесс.ПотокВывода.Прочитать() + Процесс.ПотокОшибок.Прочитать();
	ВременныеФайлы.УдалитьФайл(Сценарий);

	Ожидаем.Что(Процесс.КодВозврата, "после «" + Библиотеки + "»: " + Вывод).Равно(0);
	Ожидаем.Что(СокрЛП(Вывод), "после «" + Библиотеки + "»").Равно("OK");
КонецПроцедуры

Функция КореньБиблиотеки()
	Корень = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	Возврат Корень.ПолноеИмя;
КонецФункции
