#Использовать "../src/swp"
#Использовать "fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Транспорт SWP: кадрирование пакетов по TCP-петле, рукопожатие с автоопределением версии
// на сокете-сценарии, обход сущности по описанию туда-обратно.

Перем Сервер;
Перем СокетСервера;
Перем КлиентскийКанал;
Перем СерверныйКанал;

#Область Кадрирование

&Тест
Процедура ПакетСТеломПроходитПоПетлеЦелым() Экспорт
	Тело = Новый БуферЗаписиSWP().Текст("v8.service.Admin.Cluster").Текст("10.0").ДвоичныеДанные();
	КлиентскийКанал.ОтправитьПакет(11, Тело);
	Пакет = СерверныйКанал.ПрочитатьПакет();
	Ожидаем.Что(Пакет.Тип).Равно(11);
	Ожидаем.Что(Пакет.Данные.Размер()).Равно(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Тело).Размер);
КонецПроцедуры

&Тест
Процедура ДлинныйПакетКадрируетсяМногобайтовойДлиной() Экспорт
	Строитель = Новый БуферЗаписиSWP();
	Для Сч = 1 По 300 Цикл Строитель.Байт(Сч % 256); КонецЦикла;
	КлиентскийКанал.ОтправитьПакет(14, Строитель.ДвоичныеДанные());
	Пакет = СерверныйКанал.ПрочитатьПакет();
	Ожидаем.Что(Пакет.Тип).Равно(14);
	Ожидаем.Что(Пакет.Данные.Размер()).Равно(300);
КонецПроцедуры

&Тест
Процедура NEGOTIATEПередаётсяБезКадраТипаИДлины() Экспорт
	Тело = Новый БуферЗаписиSWP().Целое(475223888).Короткое(256).Короткое(256).ДвоичныеДанные();
	КлиентскийКанал.ОтправитьПакет(0, Тело);
	Принято = СокетСервера.ПрочитатьДвоичныеДанные(8);
	Ожидаем.Что(НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Принято))).Равно("1c53575001000100");
КонецПроцедуры

#КонецОбласти

#Область Рукопожатие

&Тест
Процедура ОткрытиеНаПредпочитаемойВерсии() Экспорт
	Поток = Склеить(CONNECT_ACK(), OPEN_ACK("10.0", 7), Неопределено);
	Рукопожатие = Новый РукопожатиеSWP(Новый КаналSWP(Новый СокетСценарий(Поток)));
	Итог = Рукопожатие.ОткрытьСеанс("v8.service.Admin.Cluster", ИзвестныеВерсии(), Неопределено);
	Ожидаем.Что(Итог.ВерсияСервиса).Равно("10.0");
	Ожидаем.Что(Итог.ИдКонечнойТочки).Равно(7);
	Ожидаем.Что(Итог.ВерсияКонечнойТочки).Равно(10);
КонецПроцедуры

&Тест
Процедура ПриОтказеВыбираетсяВысшаяОбщаяВерсия() Экспорт
	Поток = Склеить(CONNECT_ACK(), FAILURE("supported=[8.0, 9.0]"), OPEN_ACK("9.0", 4));
	Рукопожатие = Новый РукопожатиеSWP(Новый КаналSWP(Новый СокетСценарий(Поток)));
	Итог = Рукопожатие.ОткрытьСеанс("v8.service.Admin.Cluster", ИзвестныеВерсии(), Неопределено);
	Ожидаем.Что(Итог.ВерсияСервиса).Равно("9.0");
КонецПроцедуры

&Тест
Процедура ВерсияВыбираетсяПоТочномуСовпадениюНеПодстроке() Экспорт
	// сервер поддерживает только 13.0; "3.0" не должна ложно совпасть как подстрока "13.0"
	Поток = Склеить(CONNECT_ACK(), FAILURE("supported=[13.0]"), Неопределено);
	Рукопожатие = Новый РукопожатиеSWP(Новый КаналSWP(Новый СокетСценарий(Поток)));
	Попытка
		Рукопожатие.ОткрытьСеанс("v8.service.Admin.Cluster", ИзвестныеВерсии(), Неопределено);
		Ожидаем.Что("без ошибки").Равно("ошибка");
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("13.0");
		Ожидаем.Что(ОписаниеОшибки()).Содержит("клиентской библиотеке");
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Сущности

&Тест
Процедура СущностьОбходитсяТудаОбратноСВложеннымСписком() Экспорт
	Элемент = Новый ОписаниеСущностиSWP("Элемент").Короткое("Верх").Короткое("Низ");
	Описание = Новый ОписаниеСущностиSWP("Проба")
		.УИД("Ид").Текст("Имя").Целое("Ч").Длинное("Д").Флаг("Ф").Двойное("Дв").Список("Список", Элемент);
	Значение = Новый Структура("Ид,Имя,Ч,Д,Ф,Дв", "6d6958e1-a96c-4999-a995-698a0298161e", "узел", -2000000000, 9000000000, Истина, 2.5);
	Вложенные = Новый Массив; Вложенные.Добавить(Новый Структура("Верх,Низ", 1591, 1560));
	Значение.Вставить("Список", Вложенные);

	Буфер = Новый БуферЗаписиSWP().Сущность(Описание, Значение, 10);
	Прочитано = Новый БуферЧтенияSWP(Буфер.ДвоичныеДанные()).ПрочитатьСущность(Описание, 10);

	Ожидаем.Что(Прочитано.Ид).Равно("6d6958e1-a96c-4999-a995-698a0298161e");
	Ожидаем.Что(Прочитано.Имя).Равно("узел");
	Ожидаем.Что(Прочитано.Ч).Равно(-2000000000);
	Ожидаем.Что(Прочитано.Д).Равно(9000000000);
	Ожидаем.Что(Прочитано.Ф).Равно(Истина);
	Ожидаем.Что(Прочитано.Дв).Равно(2.5);
	Ожидаем.Что(Прочитано.Список.Количество()).Равно(1);
	Ожидаем.Что(Прочитано.Список[0].Верх).Равно(1591);
КонецПроцедуры

&Тест
Процедура ПоляНовееВерсииПропускаютсяИПолучаютУмолчание() Экспорт
	Описание = Новый ОписаниеСущностиSWP("Проба").Целое("Старое").Текст("Новое", 10, "по умолчанию");
	// пишем для версии 9 — поле "Новое" (с версии 10) не записывается
	Буфер = Новый БуферЗаписиSWP().Сущность(Описание, Новый Структура("Старое", 42), 9);
	Ожидаем.Что(Буфер.Длина()).Равно(4);
	// читаем для версии 9 — поле "Новое" получает значение по умолчанию
	Прочитано = Новый БуферЧтенияSWP(Буфер.ДвоичныеДанные()).ПрочитатьСущность(Описание, 9);
	Ожидаем.Что(Прочитано.Старое).Равно(42);
	Ожидаем.Что(Прочитано.Новое).Равно("по умолчанию");
КонецПроцедуры

#КонецОбласти

#Область Сборка

Функция ИзвестныеВерсии()
	Возврат СтрРазделить("3.0,4.0,5.0,6.0,7.0,8.0,9.0,10.0", ",");
КонецФункции

Функция Склеить(Знач Б1, Знач Б2, Знач Б3)
	Части = Новый Массив;
	Части.Добавить(Б1);
	Если Б2 <> Неопределено Тогда Части.Добавить(Б2); КонецЕсли;
	Если Б3 <> Неопределено Тогда Части.Добавить(Б3); КонецЕсли;
	Возврат СоединитьДвоичныеДанные(Части);
КонецФункции

Функция Кадр(Знач Тип, Знач ТелоБуфер)
	Возврат Новый БуферЗаписиSWP().Байт(Тип).Размер(ТелоБуфер.Длина()).Двоичные(ТелоБуфер.ДвоичныеДанные()).ДвоичныеДанные();
КонецФункции

Функция CONNECT_ACK()
	Возврат Кадр(2, Новый БуферЗаписиSWP());
КонецФункции

Функция OPEN_ACK(Знач Версия, Знач Ид)
	Возврат Кадр(12, Новый БуферЗаписиSWP().Текст("v8.service.Admin.Cluster").Текст(Версия).РазмерNull(Ид));
КонецФункции

Функция FAILURE(Знач Сообщение)
	Тело = Новый БуферЗаписиSWP().Текст("v8.service.Admin.Cluster").Текст("10.0").РазмерNull(0).Текст("Rights").Текст(Сообщение);
	Возврат Кадр(15, Тело);
КонецФункции

#КонецОбласти

&ПередКаждым
Процедура Подготовить() Экспорт
	Порт = 20000 + ТекущаяУниверсальнаяДатаВМиллисекундах() % 20000;
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	Клиент = Новый TCPСоединение("127.0.0.1", Порт);
	СокетСервера = Сервер.ОжидатьСоединения();
	КлиентскийКанал = Новый КаналSWP(Клиент);
	СерверныйКанал = Новый КаналSWP(СокетСервера);
КонецПроцедуры

&ПослеКаждого
Процедура Завершить() Экспорт
	Попытка КлиентскийКанал.Закрыть(); Исключение КонецПопытки;
	Попытка СерверныйКанал.Закрыть(); Исключение КонецПопытки;
	Попытка Сервер.Остановить(); Исключение КонецПопытки;
КонецПроцедуры
