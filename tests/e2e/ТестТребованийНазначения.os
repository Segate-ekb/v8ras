#Использовать ".."
#Использовать "../fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты на живом RAS: требования назначения функциональности рабочего сервера.
// Набор идёт только при заданном стенде (V8RAS_E2E_RAS); тег набора — минимальная
// платформа, с которой доступно всё проверяемое. Требование для базы v8ras-e2e-base
// остаётся на одноразовом стенде: шаг workflow сверяет его выводом rac.

Перем Стенд;      // СтендRAS
Перем Клиент;     // КлиентКластераRAS — свежее подключение на каждый тест
Перем ИдКластера; // Строка — UUID первого кластера стенда
Перем ИдСервера;  // Строка — UUID первого рабочего сервера

&Тег("8.3")
&Порядок(4)
&ТестовыйНабор
&ВключенЕсли("() -> ЕстьСтенд()", Причина = "стенд не задан (V8RAS_E2E_RAS)")
Процедура ПриСозданииОбъекта()
	Стенд = Новый СтендRAS();
КонецПроцедуры

&Тест
Процедура СоздаётТребованиеИНаходитЕгоВСписке() Экспорт
	Инфо = Новый Структура("ИмяБазы,ТипПравила,Приоритет", "v8ras-e2e-base", 2, 5);

	ИдТребования = Клиент.ДобавитьТребованиеНазначения(ИдКластера, ИдСервера, Инфо, 0);
	Ожидаем.Что(ИдТребования).Заполнено();

	Требование = Клиент.ТребованиеНазначения(ИдКластера, ИдСервера, ИдТребования);
	Ожидаем.Что(Требование.Ид).Равно(ИдТребования);
	Ожидаем.Что(Требование.ИмяБазы).Равно("v8ras-e2e-base");
	Ожидаем.Что(Требование.ТипПравила).Равно(2);
	Ожидаем.Что(Требование.Приоритет).Равно(5);
	Ожидаем.Что(Иды(Клиент.ТребованияНазначения(ИдКластера, ИдСервера))).Содержит(ИдТребования);
КонецПроцедуры

&Тест
Процедура ПрименяетТребованияПолностьюИЧастично() Экспорт
	Клиент.ПрименитьТребованияНазначения(ИдКластера);
	Клиент.ПрименитьТребованияНазначения(ИдКластера, Ложь);
КонецПроцедуры

&Тест
Процедура УдаляетТребование() Экспорт
	Инфо = Новый Структура("ИмяБазы,ТипПравила", "v8ras-e2e-tmp", 0);
	ИдТребования = Клиент.ДобавитьТребованиеНазначения(ИдКластера, ИдСервера, Инфо, 0);

	Клиент.УдалитьТребованиеНазначения(ИдКластера, ИдСервера, ИдТребования);
	Ожидаем.Что(Иды(Клиент.ТребованияНазначения(ИдКластера, ИдСервера))).Не_().Содержит(ИдТребования);
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Клиент = Стенд.Подключить();
	ИдКластера = Стенд.ИдКластера();
	ИдСервера = Стенд.ИдПервогоСервера();
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Стенд.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Стенд.Доступен();
КонецФункции

Функция Иды(Знач Список)
	Иды = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Иды.Добавить(Элемент.Ид);
	КонецЦикла;
	Возврат Иды;
КонецФункции
