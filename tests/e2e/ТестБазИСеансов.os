#Использовать ".."
#Использовать "../fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты на живом RAS: информационные базы, сеансы, соединения, блокировки.
// Набор идёт только при заданном стенде (V8RAS_E2E_RAS); тег набора — минимальная
// платформа, с которой доступно всё проверяемое. Стенд пустой: баз и сеансов на нём
// нет, проверяется, что сервер отвечает списком.

Перем Стенд;      // СтендRAS
Перем Клиент;     // КлиентКластераRAS — свежее подключение на каждый тест
Перем ИдКластера; // Строка — UUID первого кластера стенда

&Тег("8.3")
&Порядок(3)
&ТестовыйНабор
&ВключенЕсли("() -> ЕстьСтенд()", Причина = "стенд не задан (V8RAS_E2E_RAS)")
Процедура ПриСозданииОбъекта()
	Стенд = Новый СтендRAS();
КонецПроцедуры

&Тест
Процедура ПолучаетСписокИнформационныхБаз() Экспорт
	Ожидаем.Что(Клиент.Инфобазы(ИдКластера)).ИмеетТип("Массив");
КонецПроцедуры

&Тест
Процедура ПолучаетСеансыКластера() Экспорт
	Ожидаем.Что(Клиент.Сеансы(ИдКластера)).ИмеетТип("Массив");
КонецПроцедуры

&Тест
Процедура ПолучаетСоединенияКластера() Экспорт
	Ожидаем.Что(Клиент.Соединения(ИдКластера)).ИмеетТип("Массив");
КонецПроцедуры

&Тест
Процедура ПрерываниеВызоваНесуществующегоСеансаОтклоняетсяСервером() Экспорт
	// сервер разобрал запрос и не нашёл сеанс — значит, код и тело ему понятны
	Текст = "";
	Попытка
		Клиент.ПрерватьСерверныйВызов(ИдКластера, Строка(Новый УникальныйИдентификатор()), "e2e");
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Текст).Содержит("SessionNotFound");
КонецПроцедуры

&Тест
Процедура ПолучаетБлокировкиКластера() Экспорт
	Ожидаем.Что(Клиент.Блокировки(ИдКластера)).ИмеетТип("Массив");
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Клиент = Стенд.Подключить();
	ИдКластера = Стенд.ИдКластера();
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Стенд.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Стенд.Доступен();
КонецФункции
