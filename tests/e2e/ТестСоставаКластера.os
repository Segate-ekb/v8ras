#Использовать ".."
#Использовать "../fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты на живом RAS: состав кластера — серверы, менеджеры, процессы, сервисы,
// регистрация кластера на агенте. Набор идёт только при заданном стенде (V8RAS_E2E_RAS);
// тег набора — минимальная платформа, с которой доступно всё проверяемое.

Перем Стенд;      // СтендRAS
Перем Клиент;     // КлиентКластераRAS — свежее подключение на каждый тест
Перем ИдКластера; // Строка — UUID первого кластера стенда

&Тег("8.3")
&Порядок(2)
&ТестовыйНабор
&ВключенЕсли("() -> ЕстьСтенд()", Причина = "стенд не задан (V8RAS_E2E_RAS)")
Процедура ПриСозданииОбъекта()
	Стенд = Новый СтендRAS();
КонецПроцедуры

&Тест
Процедура ПолучаетСписокКластеров() Экспорт
	Ожидаем.Что(Клиент.Кластеры().Количество() >= 1).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ПолучаетРабочиеСерверыКластера() Экспорт
	Серверы = Клиент.РабочиеСерверы(ИдКластера);
	Ожидаем.Что(Серверы.Количество() >= 1).Равно(Истина);
	Ожидаем.Что(Серверы[0].Ид).Заполнено();
КонецПроцедуры

&Тест
Процедура ПолучаетМенеджерыКластера() Экспорт
	Ожидаем.Что(Клиент.Менеджеры(ИдКластера).Количество() >= 1).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ПолучаетРабочиеПроцессыКластера() Экспорт
	Ожидаем.Что(Клиент.РабочиеПроцессы(ИдКластера).Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ПолучаетСервисыКластера() Экспорт
	Сервисы = Клиент.Сервисы(ИдКластера);
	Ожидаем.Что(Сервисы.Количество() >= 1).Равно(Истина);
	Ожидаем.Что(Сервисы[0].Имя).Заполнено();
КонецПроцедуры

&Тест
Процедура РегистрируетКластерНаАгентеИУдаляетЕго() Экспорт
	// регистрация и удаление кластера — операции уровня агента; на свежем агенте администраторов нет
	Клиент.АутентифицироватьАгент("", "");
	Инфо = Новый Структура("Хост,Порт,Имя", "localhost", 2741, "v8ras-e2e-temp");

	НовыйИд = Клиент.ЗарегистрироватьКластер(Инфо);
	Ожидаем.Что(НовыйИд).Заполнено();
	Ожидаем.Что(Иды(Клиент.Кластеры())).Содержит(НовыйИд);

	Клиент.АутентифицироватьКластер(НовыйИд, "", "");
	Клиент.УдалитьКластер(НовыйИд);
	Ожидаем.Что(Иды(Клиент.Кластеры())).Не_().Содержит(НовыйИд);
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Клиент = Стенд.Подключить();
	ИдКластера = Стенд.ИдКластера();
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Стенд.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Стенд.Доступен();
КонецФункции

Функция Иды(Знач Список)
	Иды = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Иды.Добавить(Элемент.Ид);
	КонецЦикла;
	Возврат Иды;
КонецФункции
