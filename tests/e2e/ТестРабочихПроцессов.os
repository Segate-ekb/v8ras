#Использовать ".."
#Использовать "../fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты на живом RAS: выключение рабочего процесса. Набор идёт последним, он
// перезапускает рабочий процесс стенда; тег - платформа, с которой доступно выключение.

Перем Стенд;      // СтендRAS
Перем Клиент;     // КлиентКластераRAS, свежее подключение на каждый тест
Перем ИдКластера; // Строка, UUID первого кластера стенда

&Тег("8.3.27")
&Порядок(7)
&ТестовыйНабор
&ВключенЕсли("() -> ЕстьСтенд()", Причина = "стенд не задан (V8RAS_E2E_RAS)")
Процедура ПриСозданииОбъекта()
	Стенд = Новый СтендRAS();
КонецПроцедуры

&Тест
Процедура ВыключенныйРабочийПроцессПомечаетсяВыключенным() Экспорт
	Ид = "";
	Для Каждого Процесс Из Клиент.РабочиеПроцессы(ИдКластера) Цикл
		Если Процесс.Запущен Тогда
			Ид = Процесс.Ид;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Ид, "на стенде нет запущенного рабочего процесса").Заполнено();

	Клиент.ВыключитьРабочийПроцесс(ИдКластера, Ид);

	// сервер выключает асинхронно: процесс помечается выключенным, затем останавливается
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + ОжиданиеВыключенияМс();
	Пока Не ПроцессВыключенИлиОстановлен(Ид) И ТекущаяУниверсальнаяДатаВМиллисекундах() < Предел Цикл
		Приостановить(ШагОжиданияМс());
	КонецЦикла;
	Ожидаем.Что(ПроцессВыключенИлиОстановлен(Ид), "процесс не выключился за 10 с").Равно(Истина);
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Клиент = Стенд.Подключить();
	ИдКластера = Стенд.ИдКластера();
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Стенд.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Стенд.Доступен();
КонецФункции

Функция ПроцессВыключенИлиОстановлен(Знач Ид)
	Для Каждого Процесс Из Клиент.РабочиеПроцессы(ИдКластера) Цикл
		Если Процесс.Ид = Ид Тогда
			Возврат Не Процесс.Включен Или Не Процесс.Запущен;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ОжиданиеВыключенияМс()
	Возврат 10000; // BSLLS:MagicNumber-off
КонецФункции

Функция ШагОжиданияМс()
	Возврат 500; // BSLLS:MagicNumber-off
КонецФункции
