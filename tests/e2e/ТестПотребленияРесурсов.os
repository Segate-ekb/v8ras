#Использовать ".."
#Использовать "../fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты на живом RAS: счётчики и ограничения потребления ресурсов. Набор идёт
// только при заданном стенде (V8RAS_E2E_RAS); тег набора — минимальная платформа, с которой
// доступно всё проверяемое (потребление ресурсов — с 8.3.11). Счётчик v8ras-e2e и
// ограничение v8ras-e2e-limit остаются на одноразовом стенде: шаг workflow сверяет их выводом rac.

Перем Стенд;      // СтендRAS
Перем Клиент;     // КлиентКластераRAS — свежее подключение на каждый тест
Перем ИдКластера; // Строка — UUID первого кластера стенда

&Тег("8.3.11")
&Порядок(5)
&ТестовыйНабор
&ВключенЕсли("() -> ЕстьСтенд()", Причина = "стенд не задан (V8RAS_E2E_RAS)")
Процедура ПриСозданииОбъекта()
	Стенд = Новый СтендRAS();
КонецПроцедуры

&Тест
Процедура СоздаётСчётчикИЧитаетЕгоСТемиЖеРесурсами() Экспорт
	ЗаписатьСчётчикПамятиИВызовов();

	Счётчик = Клиент.Счётчик(ИдКластера, "v8ras-e2e");
	Ожидаем.Что(Счётчик.ПериодСбора).Равно(600);
	Ожидаем.Что(Счётчик.Группа).Равно(0);
	Ожидаем.Что(Счётчик.ТипОтбора).Равно(2);
	Ожидаем.Что(Счётчик.АнализироватьПамять).Равно(Истина);
	Ожидаем.Что(Счётчик.АнализироватьВызовы).Равно(Истина);
	Ожидаем.Что(Счётчик.АнализироватьДлительность).Равно(Ложь);
	Ожидаем.Что(Счётчик.АнализироватьСеансы).Равно(Ложь);
	Ожидаем.Что(Счётчик.Описание).Равно("v8ras e2e");
	Ожидаем.Что(Имена(Клиент.Счётчики(ИдКластера))).Содержит("v8ras-e2e");
КонецПроцедуры

&Тест
Процедура ПолучаетЗначенияСчётчикаИОчищаетНакопленные() Экспорт
	ЗаписатьСчётчикПамятиИВызовов();

	Ожидаем.Что(Клиент.ЗначенияСчётчика(ИдКластера, "v8ras-e2e")).ИмеетТип("Массив");
	Ожидаем.Что(Клиент.НакопленныеЗначенияСчётчика(ИдКластера, "v8ras-e2e")).ИмеетТип("Массив");
	Клиент.ОчиститьЗначенияСчётчика(ИдКластера, "v8ras-e2e");
КонецПроцедуры

&Тест
Процедура УдаляетСчётчик() Экспорт
	Клиент.ЗаписатьСчётчик(ИдКластера, Новый Структура("Имя,ПериодСбора", "v8ras-e2e-tmp", 60));

	Клиент.УдалитьСчётчик(ИдКластера, "v8ras-e2e-tmp");
	Ожидаем.Что(Имена(Клиент.Счётчики(ИдКластера))).Не_().Содержит("v8ras-e2e-tmp");
КонецПроцедуры

&Тест
Процедура СоздаётОграничениеИЧитаетЕгоСТемиЖеПределами() Экспорт
	ЗаписатьСчётчикПамятиИВызовов();
	Инфо = Новый Структура("Имя,Счётчик,Действие,Длительность,Память,Вызовы,Сообщение,Описание",
		"v8ras-e2e-limit", "v8ras-e2e", 2, 1000, 2000, 3, "v8ras e2e: предел", "v8ras e2e");

	Клиент.ЗаписатьОграничение(ИдКластера, Инфо);

	Ограничение = Клиент.Ограничение(ИдКластера, "v8ras-e2e-limit");
	Ожидаем.Что(Ограничение.Счётчик).Равно("v8ras-e2e");
	Ожидаем.Что(Ограничение.Действие).Равно(2);
	Ожидаем.Что(Ограничение.Длительность).Равно(1000);
	Ожидаем.Что(Ограничение.Память).Равно(2000);
	Ожидаем.Что(Ограничение.Вызовы).Равно(3);
	Ожидаем.Что(Ограничение.ПроцессорноеВремя).Равно(0);
	Ожидаем.Что(Ограничение.Сообщение).Равно("v8ras e2e: предел");
	Ожидаем.Что(Имена(Клиент.Ограничения(ИдКластера))).Содержит("v8ras-e2e-limit");
КонецПроцедуры

&Тест
Процедура УдаляетОграничение() Экспорт
	Клиент.ЗаписатьОграничение(ИдКластера, Новый Структура("Имя,Действие,Сеансы", "v8ras-e2e-tmp", 0, 100));

	Клиент.УдалитьОграничение(ИдКластера, "v8ras-e2e-tmp");
	Ожидаем.Что(Имена(Клиент.Ограничения(ИдКластера))).Не_().Содержит("v8ras-e2e-tmp");
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Клиент = Стенд.Подключить();
	ИдКластера = Стенд.ИдКластера();
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Стенд.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Стенд.Доступен();
КонецФункции

// Счётчик v8ras-e2e только по памяти и вызовам — так видно, что флаги легли на сервере в свои поля.
Процедура ЗаписатьСчётчикПамятиИВызовов()
	Инфо = Новый Структура("Имя,ПериодСбора,АнализироватьПамять,АнализироватьВызовы,Описание", "v8ras-e2e", 600, Истина, Истина, "v8ras e2e");
	Клиент.ЗаписатьСчётчик(ИдКластера, Инфо);
КонецПроцедуры

Функция Имена(Знач Список)
	Имена = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Имена.Добавить(Элемент.Имя);
	КонецЦикла;
	Возврат Имена;
КонецФункции
