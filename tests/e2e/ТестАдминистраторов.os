#Использовать ".."
#Использовать "../fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты на живом RAS: администраторы кластера и агента. Набор идёт только при
// заданном стенде (V8RAS_E2E_RAS); тег набора — минимальная платформа, с которой доступно
// всё проверяемое. Идёт последним: регистрация администратора закрывает кластер для
// пустой аутентификации, которой пользуются остальные наборы.

Перем Стенд;      // СтендRAS
Перем Клиент;     // КлиентКластераRAS — свежее подключение на каждый тест
Перем ИдКластера; // Строка — UUID первого кластера стенда

&Тег("8.3")
&Порядок(6)
&ТестовыйНабор
&ВключенЕсли("() -> ЕстьСтенд()", Причина = "стенд не задан (V8RAS_E2E_RAS)")
Процедура ПриСозданииОбъекта()
	Стенд = Новый СтендRAS();
КонецПроцедуры

&Тест
Процедура ПолучаетАдминистраторовКластера() Экспорт
	Ожидаем.Что(Клиент.АдминистраторыКластера(ИдКластера)).ИмеетТип("Массив");
КонецПроцедуры

&Тест
Процедура ПолучаетАдминистраторовАгента() Экспорт
	// список администраторов агента требует аутентификации агента; на свежем агенте она пустая
	Клиент.АутентифицироватьАгент("", "");
	Ожидаем.Что(Клиент.АдминистраторыАгента()).ИмеетТип("Массив");
КонецПроцедуры

&Тест
Процедура РегистрируетАдминистратораКластераИУдаляетЕго() Экспорт
	Админ = Новый Структура("Имя,Пароль,Описание", "v8ras-e2e-admin", "v8ras-e2e-pass", "v8ras e2e");

	Клиент.ЗарегистрироватьАдминаКластера(ИдКластера, Админ);
	// после регистрации первого администратора кластер закрыт: дальше — только от его имени
	Клиент.АутентифицироватьКластер(ИдКластера, "v8ras-e2e-admin", "v8ras-e2e-pass");
	Ожидаем.Что(Имена(Клиент.АдминистраторыКластера(ИдКластера))).Содержит("v8ras-e2e-admin");

	Клиент.УдалитьАдминаКластера(ИдКластера, "v8ras-e2e-admin");
	Ожидаем.Что(Имена(Клиент.АдминистраторыКластера(ИдКластера))).Не_().Содержит("v8ras-e2e-admin");
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Клиент = Стенд.Подключить();
	ИдКластера = Стенд.ИдКластера();
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Стенд.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Стенд.Доступен();
КонецФункции

Функция Имена(Знач Список)
	Имена = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Имена.Добавить(Элемент.Имя);
	КонецЦикла;
	Возврат Имена;
КонецФункции
