#Использовать ".."
#Использовать "../fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты на живом RAS: подключение и версии. Набор идёт только при заданном стенде
// (V8RAS_E2E_RAS). Тег теста — минимальная платформа, с которой доступна проверяемая
// возможность; теги здесь у каждого теста свои, потому что версии разные.

Перем Стенд;  // СтендRAS
Перем Клиент; // КлиентКластераRAS — свежее подключение на каждый тест

&Порядок(1)
&ТестовыйНабор
&ВключенЕсли("() -> ЕстьСтенд()", Причина = "стенд не задан (V8RAS_E2E_RAS)")
Процедура ПриСозданииОбъекта()
	Стенд = Новый СтендRAS();
КонецПроцедуры

&Тест
&Тег("8.3")
Процедура СогласуетВерсиюСервисаССервером() Экспорт
	Ожидаем.Что(Клиент.ВерсияСервиса()).Заполнено();
КонецПроцедуры

&Тест
&Тег("8.3.27")
Процедура НаПлатформе8327ИНовееСогласуетВерсиюСервисаНеНиже16() Экспорт
	// ранние сборки 8.3.27 отдают 16.0, поздние и 8.5.1 — 22.0
	Версия = Клиент.ВерсияСервиса();
	Старшая = Число(Лев(Версия, СтрНайти(Версия, ".") - 1));
	Ожидаем.Что(Старшая >= 16).Равно(Истина);
КонецПроцедуры

&Тест
&Тег("8.3.16")
Процедура ВерсияАгентаРавнаВерсииПлатформыСтенда() Экспорт
	// стенд CI задаёт V8RAS_E2E_V8_VERSION; без неё проверяем только, что сервер ответил
	Если ПустаяСтрока(Стенд.ВерсияПлатформы()) Тогда
		Ожидаем.Что(Клиент.ВерсияАгента()).Заполнено();
	Иначе
		Ожидаем.Что(Клиент.ВерсияАгента()).Равно(Стенд.ВерсияПлатформы());
	КонецЕсли;
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Клиент = Стенд.Подключить();
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Стенд.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Стенд.Доступен();
КонецФункции
