#Использовать ".."
#Использовать asserts

// BSLLS:LineLength-off
// Сквозной тест против живого сервера RAS. Включается только при заданном
// V8RAS_E2E_RAS (адрес host:port), иначе пропускается — локальный прогон без
// стенда остаётся зелёным. В CI поднимается ragent + ras (workflow e2e).

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ПодключениеКЖивомуRASОткрываетСеансИЧитаетКластеры() Экспорт
	Адрес = СтрРазделить(АдресСтенда(), ":");
	Клиент = Новый КлиентКластераRAS(Адрес[0], Число(Адрес[1]));
	Клиент.Подключить();

	Ожидаем.Что(ПустаяСтрока(Клиент.ВерсияСервиса())).Равно(Ложь);
	Ожидаем.Что(Клиент.Кластеры().Количество() >= 1).Равно(Истина);

	Клиент.Отключить();
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ПолныйПутьЧтенияМетрикПротивЖивогоRAS() Экспорт
	Адрес = СтрРазделить(АдресСтенда(), ":");
	Клиент = Новый КлиентКластераRAS(Адрес[0], Число(Адрес[1]));
	Клиент.Подключить();

	Для Каждого Кластер Из Клиент.Кластеры() Цикл
		// на свежем кластере администратор не задан — пустая аутентификация принимается
		Клиент.АутентифицироватьКластер(Кластер.Ид, "", "");
		Ожидаем.Что(Клиент.Сеансы(Кластер.Ид).Количество() >= 0).Равно(Истина);
		Ожидаем.Что(Клиент.Соединения(Кластер.Ид).Количество() >= 0).Равно(Истина);
		Ожидаем.Что(Клиент.РабочиеПроцессы(Кластер.Ид).Количество() >= 0).Равно(Истина);
	КонецЦикла;

	Клиент.Отключить();
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Не ПустаяСтрока(АдресСтенда());
КонецФункции

Функция АдресСтенда()
	Значение = ПеременныеСреды().Получить("V8RAS_E2E_RAS");
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции
