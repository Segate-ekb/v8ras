#Использовать ".."
#Использовать asserts

// BSLLS:LineLength-off
// Сквозные тесты против живого сервера RAS, по одному на вид данных: имя упавшего
// теста прямо называет сломавшийся кусок (сеансы, серверы, блокировки…). Подключение
// и аутентификация кластера — в &ПередКаждым, общие для всех. Весь набор включается
// только при заданном V8RAS_E2E_RAS (адрес host:port), иначе пропускается — локальный
// прогон без стенда остаётся зелёным. В CI стенд поднимает workflow e2e и задаёт
// V8RAS_E2E_V8_VERSION (версия платформы) для проверок, зависящих от её возраста.

Перем Клиент;     // КлиентКластераRAS — свежее подключение на каждый тест
Перем ИдКластера; // Строка — UUID первого кластера, уже прошедшего аутентификацию

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ВерсияСервисаОпределяетсяАвтоматически() Экспорт
	Ожидаем.Что(ПустаяСтрока(Клиент.ВерсияСервиса())).Равно(Ложь);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ПлатформаНеНиже8327()")
Процедура НаПлатформе8327СогласуетсяВерсияНеНиже16() Экспорт
	// ранние сборки 8.3.27 отдают 16.0, поздние и 8.5.1 — 22.0; более старая платформа согласует меньшую
	Версия = Клиент.ВерсияСервиса();
	Ожидаем.Что(Число(Лев(Версия, СтрНайти(Версия, ".") - 1)) >= 16).Равно(Истина);
	Ожидаем.Что(Клиент.Кластеры().Количество() >= 1).Равно(Истина);
	Ожидаем.Что(Клиент.РабочиеСерверы(ИдКластера).Количество() >= 1).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ВерсияАгентаСовпадаетСПлатформойСтенда() Экспорт
	// стенд задаёт V8RAS_E2E_V8_VERSION; без неё проверяем только, что сервер ответил строкой
	Ожидаемая = ПеременнаяСреды("V8RAS_E2E_V8_VERSION");
	Если ПустаяСтрока(Ожидаемая) Тогда
		Ожидаем.Что(ПустаяСтрока(Клиент.ВерсияАгента())).Равно(Ложь);
	Иначе
		Ожидаем.Что(Клиент.ВерсияАгента()).Равно(Ожидаемая);
	КонецЕсли;
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаетсяСписокКластеров() Экспорт
	Ожидаем.Что(Клиент.Кластеры().Количество() >= 1).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяСеансы() Экспорт
	Ожидаем.Что(Клиент.Сеансы(ИдКластера).Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяСоединения() Экспорт
	Ожидаем.Что(Клиент.Соединения(ИдКластера).Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяРабочиеПроцессы() Экспорт
	Ожидаем.Что(Клиент.РабочиеПроцессы(ИдКластера).Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяРабочиеСерверы() Экспорт
	Ожидаем.Что(Клиент.РабочиеСерверы(ИдКластера).Количество() >= 1).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяМенеджерыКластера() Экспорт
	Ожидаем.Что(Клиент.Менеджеры(ИдКластера).Количество() >= 1).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаетсяСписокИнфобаз() Экспорт
	Ожидаем.Что(Клиент.Инфобазы(ИдКластера).Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяБлокировкиКластера() Экспорт
	Ожидаем.Что(Клиент.Блокировки(ИдКластера).Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяАдминистраторыКластера() Экспорт
	Ожидаем.Что(Клиент.АдминистраторыКластера(ИдКластера).Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяАдминистраторыАгента() Экспорт
	// операции уровня агента требуют аутентификации агента; на свежем агенте — пустой
	Клиент.АутентифицироватьАгент("", "");
	Ожидаем.Что(Клиент.АдминистраторыАгента().Количество() >= 0).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура РегистрацияКластераПринимаетсяЖивымАгентом() Экспорт
	// Проверяет ФорматироватьКластер против живого агента: сервер принимает описание
	// и возвращает UUID. Снятие — по возможности (нужны права администратора кластера);
	// остаток безвреден — стенд одноразовый. Регистрация — операция уровня агента.
	Клиент.АутентифицироватьАгент("", "");
	Инфо = Новый Структура();
	Инфо.Вставить("Хост", "localhost");
	Инфо.Вставить("Порт", 2741);
	Инфо.Вставить("Имя", "v8ras-e2e-temp");

	НовыйИд = Клиент.ЗарегистрироватьКластер(Инфо);
	Ожидаем.Что(ПустаяСтрока(НовыйИд)).Равно(Ложь);

	Попытка
		Клиент.АутентифицироватьКластер(НовыйИд, "", "");
		Клиент.УдалитьКластер(НовыйИд);
	Исключение
	КонецПопытки;
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ЧитаютсяСервисыКластера() Экспорт
	Сервисы = Клиент.Сервисы(ИдКластера);
	Ожидаем.Что(Сервисы.Количество() >= 1).Равно(Истина);
	Ожидаем.Что(ПустаяСтрока(Сервисы[0].Имя)).Равно(Ложь);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ТребованиеНазначенияВставляетсяЧитаетсяИПрименяется() Экспорт
	// Требование остаётся на одноразовом стенде: шаг workflow сверяет его через rac.
	ИдСервера = Клиент.РабочиеСерверы(ИдКластера)[0].Ид;
	Инфо = Новый Структура("ИмяБазы,ТипПравила,Приоритет", "v8ras-e2e-base", 2, 5);

	ИдТребования = Клиент.ДобавитьТребованиеНазначения(ИдКластера, ИдСервера, Инфо, 0);
	Ожидаем.Что(ПустаяСтрока(ИдТребования)).Равно(Ложь);
	Требование = Клиент.ТребованиеНазначения(ИдКластера, ИдСервера, ИдТребования);
	Ожидаем.Что(Требование.Ид).Равно(ИдТребования);
	Ожидаем.Что(Требование.ИмяБазы).Равно("v8ras-e2e-base");
	Ожидаем.Что(Требование.ТипПравила).Равно(2);
	Ожидаем.Что(Требование.Приоритет).Равно(5);
	Ожидаем.Что(Клиент.ТребованияНазначения(ИдКластера, ИдСервера).Количество() >= 1).Равно(Истина);
	Клиент.ПрименитьТребованияНазначения(ИдКластера);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ТребованиеНазначенияУдаляется() Экспорт
	ИдСервера = Клиент.РабочиеСерверы(ИдКластера)[0].Ид;
	ИдТребования = Клиент.ДобавитьТребованиеНазначения(ИдКластера, ИдСервера, Новый Структура("ИмяБазы,ТипПравила", "v8ras-e2e-tmp", 0), 0);
	Клиент.УдалитьТребованиеНазначения(ИдКластера, ИдСервера, ИдТребования);
	Для Каждого Требование Из Клиент.ТребованияНазначения(ИдКластера, ИдСервера) Цикл
		Ожидаем.Что(Требование.Ид).Не_().Равно(ИдТребования);
	КонецЦикла;
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура СчётчикСВыборочнымиРесурсамиСоздаётсяЧитаетсяИОчищается() Экспорт
	// Счётчик остаётся на одноразовом стенде: шаг workflow сверяет флаги через rac.
	ЗаписатьТестовыйСчётчик();

	Счётчик = Клиент.Счётчик(ИдКластера, "v8ras-e2e");
	Ожидаем.Что(Счётчик.ПериодСбора).Равно(600);
	Ожидаем.Что(Счётчик.Группа).Равно(0);
	Ожидаем.Что(Счётчик.ТипОтбора).Равно(2);
	Ожидаем.Что(Счётчик.АнализироватьПамять).Равно(Истина);
	Ожидаем.Что(Счётчик.АнализироватьВызовы).Равно(Истина);
	Ожидаем.Что(Счётчик.АнализироватьДлительность).Равно(Ложь);
	Ожидаем.Что(Счётчик.АнализироватьСеансы).Равно(Ложь);
	Ожидаем.Что(Счётчик.Описание).Равно("v8ras e2e");
	Ожидаем.Что(Клиент.Счётчики(ИдКластера).Количество() >= 1).Равно(Истина);
	Ожидаем.Что(Клиент.ЗначенияСчётчика(ИдКластера, "v8ras-e2e").Количество() >= 0).Равно(Истина);
	Ожидаем.Что(Клиент.НакопленныеЗначенияСчётчика(ИдКластера, "v8ras-e2e").Количество() >= 0).Равно(Истина);
	Клиент.ОчиститьЗначенияСчётчика(ИдКластера, "v8ras-e2e");
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура СчётчикУдаляется() Экспорт
	Клиент.ЗаписатьСчётчик(ИдКластера, Новый Структура("Имя,ПериодСбора", "v8ras-e2e-tmp", 60));
	Клиент.УдалитьСчётчик(ИдКластера, "v8ras-e2e-tmp");
	Для Каждого Счётчик Из Клиент.Счётчики(ИдКластера) Цикл
		Ожидаем.Что(Счётчик.Имя).Не_().Равно("v8ras-e2e-tmp");
	КонецЦикла;
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ОграничениеСоздаётсяИЧитается() Экспорт
	// Ограничение остаётся на одноразовом стенде: шаг workflow сверяет пределы через rac.
	ЗаписатьТестовыйСчётчик();
	Инфо = Новый Структура("Имя,Счётчик,Действие,Длительность,Память,Вызовы,Сообщение,Описание",
		"v8ras-e2e-limit", "v8ras-e2e", 2, 1000, 2000, 3, "v8ras e2e: предел", "v8ras e2e");

	Клиент.ЗаписатьОграничение(ИдКластера, Инфо);
	Ограничение = Клиент.Ограничение(ИдКластера, "v8ras-e2e-limit");
	Ожидаем.Что(Ограничение.Счётчик).Равно("v8ras-e2e");
	Ожидаем.Что(Ограничение.Действие).Равно(2);
	Ожидаем.Что(Ограничение.Длительность).Равно(1000);
	Ожидаем.Что(Ограничение.Память).Равно(2000);
	Ожидаем.Что(Ограничение.Вызовы).Равно(3);
	Ожидаем.Что(Ограничение.ПроцессорноеВремя).Равно(0);
	Ожидаем.Что(Ограничение.Сообщение).Равно("v8ras e2e: предел");
	Ожидаем.Что(Клиент.Ограничения(ИдКластера).Количество() >= 1).Равно(Истина);
КонецПроцедуры

&Тест
&ВключенЕсли("() -> ЕстьСтенд()")
Процедура ОграничениеУдаляется() Экспорт
	Клиент.ЗаписатьОграничение(ИдКластера, Новый Структура("Имя,Действие,Сеансы", "v8ras-e2e-tmp", 0, 100));
	Клиент.УдалитьОграничение(ИдКластера, "v8ras-e2e-tmp");
	Для Каждого Ограничение Из Клиент.Ограничения(ИдКластера) Цикл
		Ожидаем.Что(Ограничение.Имя).Не_().Равно("v8ras-e2e-tmp");
	КонецЦикла;
КонецПроцедуры

&ПередКаждым
Процедура Подключиться() Экспорт
	Если Не ЕстьСтенд() Тогда
		Возврат;
	КонецЕсли;
	Адрес = СтрРазделить(АдресСтенда(), ":");
	Клиент = Новый КлиентКластераRAS(Адрес[0], Число(Адрес[1]));
	Клиент.Подключить();
	Кластеры = Клиент.Кластеры();
	Если Кластеры.Количество() > 0 Тогда
		ИдКластера = Кластеры[0].Ид;
		// на свежем кластере администратор не задан — пустая аутентификация принимается
		Клиент.АутентифицироватьКластер(ИдКластера, "", "");
	КонецЕсли;
КонецПроцедуры

&ПослеКаждого
Процедура Отключиться() Экспорт
	Если Клиент <> Неопределено Тогда
		Клиент.Отключить();
		Клиент = Неопределено;
	КонецЕсли;
КонецПроцедуры

Функция ЕстьСтенд() Экспорт
	Возврат Не ПустаяСтрока(АдресСтенда());
КонецФункции

// Стенд есть и версия платформы из V8RAS_E2E_V8_VERSION не ниже 8.3.27; без переменной — Ложь.
Функция ПлатформаНеНиже8327() Экспорт
	Части = СтрРазделить(ПеременнаяСреды("V8RAS_E2E_V8_VERSION"), ".");
	Если Не ЕстьСтенд() Или Части.Количество() < 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Своя = Число(Части[0]) * 1000000 + Число(Части[1]) * 1000 + Число(Части[2]);
	Возврат Своя >= 8 * 1000000 + 3 * 1000 + 27;
КонецФункции

// Счётчик v8ras-e2e: только память и вызовы — чтобы проверить порядок флагов на сервере.
Процедура ЗаписатьТестовыйСчётчик()
	Инфо = Новый Структура("Имя,ПериодСбора,АнализироватьПамять,АнализироватьВызовы,Описание", "v8ras-e2e", 600, Истина, Истина, "v8ras e2e");
	Клиент.ЗаписатьСчётчик(ИдКластера, Инфо);
КонецПроцедуры

Функция АдресСтенда()
	Возврат ПеременнаяСреды("V8RAS_E2E_RAS");
КонецФункции

Функция ПеременнаяСреды(Знач Имя)
	Значение = ПеременныеСреды().Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции
