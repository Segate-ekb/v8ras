#Использовать "../src/swp"
#Использовать asserts

// BSLLS:LineLength-off
// Кодек SWP: запись и чтение. Эталонные байты сняты с бинарного протокола сервисов 1С
// (от старшего байта + схемы Size/NullableSize). Значения гоняются и туда-обратно.

&Тест
Процедура ЦелыеПишутсяОтСтаршегоБайта() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Короткое(256))).Равно("0100");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Целое(2000))).Равно("000007d0");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Целое(475223888))).Равно("1c535750");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Длинное(2000))).Равно("00000000000007d0");
КонецПроцедуры

&Тест
Процедура ОтрицательныеЦелыеВДополнительномКоде() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Короткое(-1))).Равно("ffff");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Целое(-1))).Равно("ffffffff");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Длинное(-1))).Равно("ffffffffffffffff");
КонецПроцедуры

&Тест
Процедура РазмерКодируетсяПоСхемеSize() Экспорт
	Проверить("Size", "0,1,63,64,127,128,255,256,16383,16384,100000",
		"00,01,3f,40,7f,8001,ff01,8002,ff7f,808001,a08d06");
КонецПроцедуры

&Тест
Процедура РазмерNullКодируетсяПоСхемеNullableSize() Экспорт
	Проверить("Null", "0,1,63,64,127,128,255,256,4095,4096,100000",
		"00,01,3f,4001,7f01,4002,7f03,4004,7f3f,4040,609a0c");
КонецПроцедуры

&Тест
Процедура СтрокаПишетсяДлинойИБайтамиUTF8() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Текст(""))).Равно("00");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Текст("A"))).Равно("0141");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Текст("v8.service.Admin.Cluster")))
		.Равно("1876382e736572766963652e41646d696e2e436c7573746572");
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().Текст("Привет"))).Равно("0cd09fd180d0b8d0b2d0b5d182");
КонецПроцедуры

&Тест
Процедура UUIDПишется16БайтамиВПорядкеСтроки() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписиSWP().УИД("6d6958e1-a96c-4999-a995-698a0298161e")))
		.Равно("6d6958e1a96c4999a995698a0298161e");
КонецПроцедуры

&Тест
Процедура ПримитивыЧитаютсяОбратноЗаписи() Экспорт
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Короткое(256)).ПрочитатьКороткое()).Равно(256);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Целое(475223888)).ПрочитатьЦелое()).Равно(475223888);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Длинное(9000000000)).ПрочитатьДлинное()).Равно(9000000000);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Флаг(Истина)).ПрочитатьФлаг()).Равно(Истина);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Текст("Привет мир")).ПрочитатьТекст()).Равно("Привет мир");
	Идентификатор = "6d6958e1-a96c-4999-a995-698a0298161e";
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().УИД(Идентификатор)).ПрочитатьУИД()).Равно(Идентификатор);
КонецПроцедуры

&Тест
Процедура ОтрицательноеДлинноеЧитаетсяСоЗнаком() Экспорт
	// memory-current сеанса RAS бывает отрицательным: int64 в дополнительном коде
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Длинное(-63251448)).ПрочитатьДлинное()).Равно(-63251448);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Длинное(-1)).ПрочитатьДлинное()).Равно(-1);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Длинное(9223372036854775807)).ПрочитатьДлинное()).Равно(9223372036854775807);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Длинное(-9223372036854775808)).ПрочитатьДлинное()).Равно(-9223372036854775808);
КонецПроцедуры

&Тест
Процедура РазмерыЧитаютсяОбратноЗаписи() Экспорт
	Для Каждого Текст Из СтрРазделить("0,1,63,64,127,128,255,16384,100000", ",") Цикл
		Значение = Число(Текст);
		Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Размер(Значение)).ПрочитатьРазмер(), "Size " + Значение).Равно(Значение);
		Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().РазмерNull(Значение)).ПрочитатьРазмерNull(), "Null " + Значение).Равно(Значение);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ДвойноеЧитаетсяПоIEEE754() Экспорт
	Ожидаем.Что(ДвойноеИзHex("3ff0000000000000")).Равно(1);
	Ожидаем.Что(ДвойноеИзHex("3fe0000000000000")).Равно(0.5);
	Ожидаем.Что(ДвойноеИзHex("4004000000000000")).Равно(2.5);
	Ожидаем.Что(ДвойноеИзHex("c004000000000000")).Равно(-2.5);
	Ожидаем.Что(ДвойноеИзHex("0000000000000000")).Равно(0);
КонецПроцедуры

&Тест
Процедура ДвойноеПишетсяИЧитаетсяОбратно() Экспорт
	Для Каждого Текст Из СтрРазделить("0,1,0.5,-2.5,1.5,42,1234.5,-0.25", ",") Цикл
		Значение = Число(Текст);
		Прочитано = Читатель(Новый БуферЗаписиSWP().Двойное(Значение)).ПрочитатьДвойное();
		Ожидаем.Что(Прочитано, "double " + Значение).Равно(Значение);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ВремяПишетсяИЧитаетсяОбратно() Экспорт
	Момент = Дата(2020, 1, 1, 12, 30, 45);
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Время(Момент)).ПрочитатьВремя()).Равно(Момент);
	Пусто = '00010101000000';
	Ожидаем.Что(Читатель(Новый БуферЗаписиSWP().Время(Пусто)).ПрочитатьВремя()).Равно(Пусто);
КонецПроцедуры

&Тест
Процедура ЧтениеЗаГраницейБросаетПонятнуюОшибку() Экспорт
	Читал = Читатель(Новый БуферЗаписиSWP().Байт(7));
	Читал.ПрочитатьБайт();
	Попытка
		Читал.ПрочитатьБайт();
		Ожидаем.Что("без ошибки").Равно("ошибка");
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("обрывается");
	КонецПопытки;
КонецПроцедуры

Процедура Проверить(Знач Схема, Знач Значения, Знач Ожидания)
	МассивЗначений = СтрРазделить(Значения, ",");
	МассивОжиданий = СтрРазделить(Ожидания, ",");
	Для Индекс = 0 По МассивЗначений.ВГраница() Цикл
		Значение = Число(МассивЗначений[Индекс]);
		Буфер = Новый БуферЗаписиSWP();
		Если Схема = "Size" Тогда
			Буфер.Размер(Значение);
		Иначе
			Буфер.РазмерNull(Значение);
		КонецЕсли;
		Ожидаем.Что(Hex(Буфер), Схема + " " + Значение).Равно(МассивОжиданий[Индекс]);
	КонецЦикла;
КонецПроцедуры

Функция Читатель(Знач Буфер)
	Возврат Новый БуферЧтенияSWP(Буфер.ДвоичныеДанные());
КонецФункции

Функция ДвойноеИзHex(Знач Hex)
	Возврат Новый БуферЧтенияSWP(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзHexСтроки(Hex))).ПрочитатьДвойное();
КонецФункции

Функция Hex(Знач Буфер)
	Возврат НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Буфер.ДвоичныеДанные())));
КонецФункции
