// Фикстура: сокет по сценарию. Отдаёт заранее заготовленный поток ответа сервера
// и копит отправленные байты. Утиный тип TCPСоединения для проверки рукопожатия
// и запросов без реального сервера RAS.

Перем _Ответ;      // БуферДвоичныхДанных — заготовленный поток от «сервера»
Перем _Позиция;    // Число — смещение чтения ответа
Перем _Отправлено; // Массив чисел — накопленные отправленные байты
Перем _Закрыт;     // Булево

Процедура ОтправитьДвоичныеДанные(Знач Данные) Экспорт
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		_Отправлено.Добавить(Буфер[Индекс]);
	КонецЦикла;
КонецПроцедуры

Функция ПрочитатьДвоичныеДанные(Знач Количество) Экспорт
	Доступно = _Ответ.Размер - _Позиция;
	Отдать = Мин(Количество, Доступно);
	Результат = Новый БуферДвоичныхДанных(Отдать);
	Для Индекс = 0 По Отдать - 1 Цикл
		Результат[Индекс] = _Ответ[_Позиция + Индекс];
	КонецЦикла;
	_Позиция = _Позиция + Отдать;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Результат);
КонецФункции

Процедура Закрыть() Экспорт
	_Закрыт = Истина;
КонецПроцедуры

// Отправленные байты в шестнадцатеричном виде — для проверок запросов.
Функция ОтправленноеHex() Экспорт
	Разряды = "0123456789abcdef";
	Результат = "";
	Для Каждого Значение Из _Отправлено Цикл
		Результат = Результат + Сред(Разряды, Цел(Значение / 16) + 1, 1) + Сред(Разряды, (Значение % 16) + 1, 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Закрыт() Экспорт
	Возврат _Закрыт;
КонецФункции

// Параметры:
//   Ответ - ДвоичныеДанные - заготовленный поток ответа сервера.
Процедура ПриСозданииОбъекта(Знач Ответ = Неопределено)
	Если Ответ = Неопределено Тогда
		_Ответ = Новый БуферДвоичныхДанных(0);
	Иначе
		_Ответ = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Ответ);
	КонецЕсли;
	_Позиция = 0;
	_Отправлено = Новый Массив;
	_Закрыт = Ложь;
КонецПроцедуры
