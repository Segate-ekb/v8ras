// Фикстура: сокет по сценарию. Отдаёт заранее заготовленный поток ответа сервера порциями
// (как TCP), копит отправленные байты. Утиный тип TCPСоединения для проверки протокола без сервера.

Перем _Ответ;      // БуферДвоичныхДанных — заготовленный поток
Перем _Позиция;    // Число — смещение чтения
Перем _Отправлено; // Массив из ДвоичныеДанные — отправленное
Перем _Порция;     // Число — максимум байтов за один ПрочитатьДвоичныеДанные
Перем _Закрыт;     // Булево

Процедура ОтправитьДвоичныеДанные(Знач Данные) Экспорт
	_Отправлено.Добавить(Данные);
КонецПроцедуры

Функция ПрочитатьДвоичныеДанные(Знач Количество) Экспорт
	Доступно = _Ответ.Размер - _Позиция;
	Отдать = Мин(Мин(Количество, _Порция), Доступно);
	Результат = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(_Ответ.Прочитать(_Позиция, Отдать));
	_Позиция = _Позиция + Отдать;
	Возврат Результат;
КонецФункции

Процедура Закрыть() Экспорт
	_Закрыт = Истина;
КонецПроцедуры

// Весь отправленный поток в шестнадцатеричном виде — для проверок запросов.
Функция ОтправленноеHex() Экспорт
	Если _Отправлено.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(
		ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(СоединитьДвоичныеДанные(_Отправлено))));
КонецФункции

Функция Закрыт() Экспорт
	Возврат _Закрыт;
КонецФункции

// Параметры:
//   Ответ  - ДвоичныеДанные - заготовленный поток ответа сервера.
//   Порция - Число          - максимум байтов за чтение (эмуляция дробления TCP).
Процедура ПриСозданииОбъекта(Знач Ответ = Неопределено, Знач Порция = 65536)
	Если Ответ = Неопределено Тогда
		_Ответ = Новый БуферДвоичныхДанных(0);
	Иначе
		_Ответ = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Ответ);
	КонецЕсли;
	_Позиция = 0;
	_Порция = Порция;
	_Отправлено = Новый Массив;
	_Закрыт = Ложь;
КонецПроцедуры
