// Фикстура: открыватель соединения по сценарию — ждёт заданное время, затем отдаёт объект
// или падает с заданным текстом. Подменяет TCPСоединение в проверках предела времени подключения.

Перем _ЗадержкаМс; // Число
Перем _Сокет;      // Произвольный — что вернуть
Перем _Ошибка;     // Строка — пусто: вернуть _Сокет, иначе упасть с этим текстом

Функция ОткрытьБезПредела(Знач Хост, Знач Порт) Экспорт
	Если _ЗадержкаМс > 0 Тогда
		Приостановить(_ЗадержкаМс);
	КонецЕсли;
	Если НЕ ПустаяСтрока(_Ошибка) Тогда
		ВызватьИсключение _Ошибка;
	КонецЕсли;
	Возврат _Сокет;
КонецФункции

Процедура ПриСозданииОбъекта(Знач ЗадержкаМс = 0, Знач Сокет = Неопределено, Знач Ошибка = "")
	_ЗадержкаМс = ЗадержкаМс;
	_Сокет = Сокет;
	_Ошибка = Ошибка;
КонецПроцедуры
