// Фикстура сквозных тестов: живой RAS из переменных среды. V8RAS_E2E_RAS — адрес host:port
// (без него стенда нет и наборы пропускаются), V8RAS_E2E_V8_VERSION — версия платформы на стенде.

Перем _Клиент;     // КлиентКластераRAS — текущее подключение
Перем _ИдКластера; // Строка — UUID первого кластера, уже прошедшего аутентификацию

Функция Доступен() Экспорт
	Возврат Не ПустаяСтрока(ПеременнаяСреды("V8RAS_E2E_RAS"));
КонецФункции

Функция ВерсияПлатформы() Экспорт
	Возврат ПеременнаяСреды("V8RAS_E2E_V8_VERSION");
КонецФункции

// Подключается к стенду и аутентифицируется в первом кластере; на свежем кластере
// администраторов нет, пустая аутентификация принимается.
Функция Подключить() Экспорт
	Адрес = СтрРазделить(ПеременнаяСреды("V8RAS_E2E_RAS"), ":");
	_Клиент = Новый КлиентКластераRAS(Адрес[0], Число(Адрес[1]));
	_Клиент.Подключить();
	_ИдКластера = _Клиент.Кластеры()[0].Ид;
	_Клиент.АутентифицироватьКластер(_ИдКластера, "", "");
	Возврат _Клиент;
КонецФункции

Процедура Отключить() Экспорт
	Если _Клиент <> Неопределено Тогда
		_Клиент.Отключить();
		_Клиент = Неопределено;
	КонецЕсли;
КонецПроцедуры

Функция ИдКластера() Экспорт
	Возврат _ИдКластера;
КонецФункции

Функция ИдПервогоСервера() Экспорт
	Возврат _Клиент.РабочиеСерверы(_ИдКластера)[0].Ид;
КонецФункции

Функция ПеременнаяСреды(Знач Имя)
	Значение = ПеременныеСреды().Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции
