#Использовать "fixtures"
#Использовать asserts

// BSLLS:LineLength-off
// Рукопожатие RAS на сокете-сценарии: согласование, соединение, открытие конечной
// точки с автоопределением версии и запасным выбором по списку сервера.

&Тест
Процедура ОткрытиеНаПредпочитаемойВерсииВозвращаетИдКонечнойТочки() Экспорт
	Поток = Склеить(ПакетCONNECT_ACK(), ПакетOPEN_ACK("10.0", 7), Неопределено);
	Сокет = Новый СокетСценарий(Поток);

	Рукопожатие = Новый РукопожатиеRAS(Новый СоединениеRAS(Сокет));
	Итог = Рукопожатие.ОткрытьСеанс();

	Ожидаем.Что(Итог.ВерсияСервиса).Равно("10.0");
	Ожидаем.Что(Итог.ИдКонечнойТочки).Равно(7);
	Ожидаем.Что(Итог.ВерсияКонечнойТочки).Равно(10);
КонецПроцедуры

&Тест
Процедура ОтправленныеПакетыНачинаютсяССогласованияИСоединения() Экспорт
	Поток = Склеить(ПакетCONNECT_ACK(), ПакетOPEN_ACK("10.0", 1), Неопределено);
	Сокет = Новый СокетСценарий(Поток);

	Рукопожатие = Новый РукопожатиеRAS(Новый СоединениеRAS(Сокет));
	Рукопожатие.ОткрытьСеанс();

	Отправлено = Сокет.ОтправленноеHex();
	// NEGOTIATE без кадра: магия + версия протокола + версия кодека
	Ожидаем.Что(Лев(Отправлено, 16)).Равно("1c53575001000100");
	// за ним кадр CONNECT: тип 01, длина 1a, тело с параметром connect.timeout
	Ожидаем.Что(Отправлено).Содержит("011a010f636f6e6e6563742e74696d656f75740500000000000007d0");
	// запрос открытия сервиса администрирования
	Ожидаем.Что(Отправлено).Содержит(HexТекста("v8.service.Admin.Cluster"));
КонецПроцедуры

&Тест
Процедура ПриОтказеВыбираетсяВысшаяОбщаяВерсия() Экспорт
	// сервер не принял 10.0, сообщил поддержку 8.0 и 9.0 → берём 9.0
	Отказ = ПакетFAILURE("Unsupported version, supported=[8.0, 9.0]]");
	Поток = Склеить(ПакетCONNECT_ACK(), Отказ, ПакетOPEN_ACK("9.0", 4));
	Сокет = Новый СокетСценарий(Поток);

	Рукопожатие = Новый РукопожатиеRAS(Новый СоединениеRAS(Сокет));
	Итог = Рукопожатие.ОткрытьСеанс();

	Ожидаем.Что(Итог.ВерсияСервиса).Равно("9.0");
	Ожидаем.Что(Итог.ВерсияКонечнойТочки).Равно(9);
КонецПроцедуры

&Тест
Процедура НовыйСерверБезОбщейВерсииДаётПонятнуюОшибку() Экспорт
	// сервер новее библиотеки: поддерживает только 11.0 и 12.0 — общих версий нет
	Отказ = ПакетFAILURE("Unsupported version, supported=[11.0, 12.0]]");
	Поток = Склеить(ПакетCONNECT_ACK(), Отказ, Неопределено);
	Сокет = Новый СокетСценарий(Поток);
	Рукопожатие = Новый РукопожатиеRAS(Новый СоединениеRAS(Сокет));

	Ошибка = "";
	Попытка
		Рукопожатие.ОткрытьСеанс();
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Ошибка).Содержит("не принял версию");
	Ожидаем.Что(Ошибка).Содержит("11.0");
	Ожидаем.Что(Ошибка).Содержит("Обновите библиотеку");
КонецПроцедуры

#Область Сборка

// Склеивает тела кадров (БуферЗаписи) в единый поток байтов ответа.
Функция Склеить(Знач Буфер1, Знач Буфер2, Знач Буфер3)
	Итог = Новый БуферЗаписи();
	ДобавитьБайты(Итог, Буфер1);
	ДобавитьБайты(Итог, Буфер2);
	ДобавитьБайты(Итог, Буфер3);
	Возврат Итог.ДвоичныеДанные();
КонецФункции

Процедура ДобавитьБайты(ЦельБуфер, Знач ИсточникБуфер)
	Если ИсточникБуфер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ИсточникБуфер.ДвоичныеДанные());
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		ЦельБуфер.Байт(Буфер[Индекс]);
	КонецЦикла;
КонецПроцедуры

Функция Кадр(Знач Тип, Знач ТелоБуфер)
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ТелоБуфер.ДвоичныеДанные());
	Кадр = Новый БуферЗаписи();
	Кадр.Байт(Тип).Размер(Буфер.Размер);
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Кадр.Байт(Буфер[Индекс]);
	КонецЦикла;
	Возврат Кадр;
КонецФункции

Функция ПакетCONNECT_ACK()
	Возврат Кадр(2, Новый БуферЗаписи());
КонецФункции

Функция ПакетOPEN_ACK(Знач Версия, Знач ИдКонечнойТочки)
	Тело = Новый БуферЗаписи();
	Тело.Текст("v8.service.Admin.Cluster").Текст(Версия).РазмерNull(ИдКонечнойТочки);
	Возврат Кадр(12, Тело);
КонецФункции

Функция ПакетFAILURE(Знач Сообщение)
	Тело = Новый БуферЗаписи();
	Тело.Текст("v8.service.Admin.Cluster").Текст("10.0").РазмерNull(0).Текст("ClassCause").Текст(Сообщение);
	Возврат Кадр(15, Тело);
КонецФункции

Функция HexТекста(Знач Текст)
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8", Ложь);
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Разряды = "0123456789abcdef";
	Результат = "";
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Значение = Буфер[Индекс];
		Результат = Результат + Сред(Разряды, Цел(Значение / 16) + 1, 1) + Сред(Разряды, (Значение % 16) + 1, 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
