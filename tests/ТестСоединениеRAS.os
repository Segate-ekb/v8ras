#Использовать "../src/internal"
#Использовать asserts

// BSLLS:LineLength-off
// Кадрирование пакетов RAS поверх реального TCP-сокета по петле (loopback):
// клиент пишет, сервер читает тем же кодом. Без сервера 1С.

Перем Сервер;
Перем СокетСервера;
Перем КлиентскоеСоединение;
Перем СерверноеСоединение;

&Тест
Процедура ПакетСТеломПроходитПоПетлеЦелым() Экспорт
	Тело = Новый БуферЗаписи().Текст("v8.service.Admin.Cluster").Текст("10.0").Байт(0);
	КлиентскоеСоединение.ОтправитьПакет(11, Тело.ДвоичныеДанные());

	Пакет = СерверноеСоединение.ПрочитатьПакет();
	Ожидаем.Что(Пакет.Тип).Равно(11);
	Ожидаем.Что(Hex(Пакет.Данные)).Равно(Hex(Тело.ДвоичныеДанные()));
КонецПроцедуры

&Тест
Процедура ПустойПакетПроходитПоПетле() Экспорт
	КлиентскоеСоединение.ОтправитьПакет(16, Новый БуферЗаписи().ДвоичныеДанные());

	Пакет = СерверноеСоединение.ПрочитатьПакет();
	Ожидаем.Что(Пакет.Тип).Равно(16);
	Ожидаем.Что(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Пакет.Данные).Размер).Равно(0);
КонецПроцедуры

&Тест
Процедура ДлинныйПакетКадрируетсяМногобайтовойДлиной() Экспорт
	// тело > 127 байт: длина Size занимает два байта
	Строитель = Новый БуферЗаписи();
	Для Сч = 1 По 200 Цикл
		Строитель.Байт(Сч % 256);
	КонецЦикла;
	КлиентскоеСоединение.ОтправитьПакет(14, Строитель.ДвоичныеДанные());

	Пакет = СерверноеСоединение.ПрочитатьПакет();
	Ожидаем.Что(Пакет.Тип).Равно(14);
	Ожидаем.Что(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Пакет.Данные).Размер).Равно(200);
	Ожидаем.Что(Hex(Пакет.Данные)).Равно(Hex(Строитель.ДвоичныеДанные()));
КонецПроцедуры

&Тест
Процедура NEGOTIATEПередаётсяБезКадраТипаИДлины() Экспорт
	// тип 0 — только тело: 8 байт, без ведущего байта типа и длины
	Тело = Новый БуферЗаписи().Целое(475223888).Короткое(256).Короткое(256);
	КлиентскоеСоединение.ОтправитьПакет(0, Тело.ДвоичныеДанные());

	Принято = СокетСервера.ПрочитатьДвоичныеДанные(8);
	Ожидаем.Что(Hex(Принято)).Равно("1c53575001000100");
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждымТестом() Экспорт
	Порт = 20000 + ТекущаяУниверсальнаяДатаВМиллисекундах() % 20000;
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	Клиент = Новый TCPСоединение("127.0.0.1", Порт);
	СокетСервера = Сервер.ОжидатьСоединения();
	КлиентскоеСоединение = Новый СоединениеRAS(Клиент);
	СерверноеСоединение = Новый СоединениеRAS(СокетСервера);
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждогоТеста() Экспорт
	Попытка
		КлиентскоеСоединение.Закрыть();
	Исключение
	КонецПопытки;
	Попытка
		СерверноеСоединение.Закрыть();
	Исключение
	КонецПопытки;
	Попытка
		Сервер.Остановить();
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция Hex(Знач Данные)
	Б = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Разряды = "0123456789abcdef";
	Результат = "";
	Для Индекс = 0 По Б.Размер - 1 Цикл
		Значение = Б[Индекс];
		Результат = Результат + Сред(Разряды, Цел(Значение / 16) + 1, 1) + Сред(Разряды, (Значение % 16) + 1, 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции
