#Использовать "../src/internal"
#Использовать asserts

// BSLLS:LineLength-off
// Кодек записи: целые от старшего байта, две схемы varint, строки UTF-8, UUID.
// Эталонные байты сняты с бинарного протокола RAS 1С (big-endian + Size/NullableSize).

&Тест
Процедура ЦелыеПишутсяОтСтаршегоБайта() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписи().Короткое(256))).Равно("0100");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Целое(2000))).Равно("000007d0");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Целое(475223888))).Равно("1c535750");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Длинное(2000))).Равно("00000000000007d0");
КонецПроцедуры

&Тест
Процедура РазмерКодируетсяПоСхемеSize() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(0))).Равно("00");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(63))).Равно("3f");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(64))).Равно("40");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(127))).Равно("7f");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(128))).Равно("8001");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(255))).Равно("ff01");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(256))).Равно("8002");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(16383))).Равно("ff7f");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(16384))).Равно("808001");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Размер(100000))).Равно("a08d06");
КонецПроцедуры

&Тест
Процедура РазмерNullКодируетсяПоСхемеNullableSize() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(0))).Равно("00");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(63))).Равно("3f");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(64))).Равно("4001");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(127))).Равно("7f01");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(128))).Равно("4002");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(255))).Равно("7f03");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(256))).Равно("4004");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(4095))).Равно("7f3f");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(4096))).Равно("4040");
	Ожидаем.Что(Hex(Новый БуферЗаписи().РазмерNull(100000))).Равно("609a0c");
КонецПроцедуры

&Тест
Процедура СтрокаПишетсяДлинойИБайтамиUTF8() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписи().Текст(""))).Равно("00");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Текст("A"))).Равно("0141");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Текст("v8.service.Admin.Cluster")))
		.Равно("1876382e736572766963652e41646d696e2e436c7573746572");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Текст("Привет")))
		.Равно("0cd09fd180d0b8d0b2d0b5d182");
КонецПроцедуры

&Тест
Процедура ФлагПишетсяОднимБайтом() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписи().Флаг(Истина))).Равно("01");
	Ожидаем.Что(Hex(Новый БуферЗаписи().Флаг(Ложь))).Равно("00");
КонецПроцедуры

&Тест
Процедура UUIDПишется16БайтамиВПорядкеСтроки() Экспорт
	Ожидаем.Что(Hex(Новый БуферЗаписи().УИД("6d6958e1-a96c-4999-a995-698a0298161e")))
		.Равно("6d6958e1a96c4999a995698a0298161e");
КонецПроцедуры

&Тест
Процедура ТелоNEGOTIATEСобираетсяИзПримитивов() Экспорт
	// магия 0x1c535750, версия протокола 256, версия кодека 256
	Буфер = Новый БуферЗаписи();
	Буфер.Целое(475223888).Короткое(256).Короткое(256);
	Ожидаем.Что(Hex(Буфер)).Равно("1c53575001000100");
КонецПроцедуры

&Тест
Процедура ТелоCONNECTСобираетсяИзПримитивов() Экспорт
	// параметры { "connect.timeout": LONG 2000 }: NullableSize(1) + строка + тип 5 + длинное
	Буфер = Новый БуферЗаписи();
	Буфер.РазмерNull(1).Текст("connect.timeout").ТипизированноеДлинное(2000);
	Ожидаем.Что(Hex(Буфер)).Равно("010f636f6e6e6563742e74696d656f75740500000000000007d0");
КонецПроцедуры

Функция Hex(Знач Буфер)
	Данные = Буфер.ДвоичныеДанные();
	Б = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Разряды = "0123456789abcdef";
	Результат = "";
	Для Индекс = 0 По Б.Размер - 1 Цикл
		Значение = Б[Индекс];
		Результат = Результат
			+ Сред(Разряды, Цел(Значение / 16) + 1, 1)
			+ Сред(Разряды, (Значение % 16) + 1, 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции
