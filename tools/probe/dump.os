#Использовать "../../src/swp"
#Использовать "../../src/internal"
// Снимает сырые ответы RAS по всем версиям сервиса в hex-файлы: dump/v<N>/<код>.hex

Функция Снять(Точка, Код, Тело, Каталог, Имя)
	Попытка
		Читатель = Точка.Запрос(Код, Тело, Код + 1);
	Исключение
		Сообщить("  " + Имя + " (" + Код + "): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если Читатель = Неопределено Тогда
		Сообщить("  " + Имя + " (" + Код + "): пустой ответ");
		Возврат Неопределено;
	КонецЕсли;
	Данные = Читатель.ПрочитатьДвоичные(Читатель.Остаток());
	Запись = Новый ЗаписьТекста(Каталог + "/" + Формат(Код, "ЧГ=0") + "-" + Имя + ".hex", КодировкаТекста.UTF8);
	Запись.Записать(ПолучитьHexСтрокуИзДвоичныхДанных(Данные));
	Запись.Закрыть();
	Сообщить("  " + Имя + " (" + Код + "): " + Данные.Размер() + " байт");
	Возврат Данные;
КонецФункции

Функция ПервыйУИД(Данные)
	Если Данные = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Б = Новый БуферЧтенияSWP(Данные);
	Если Б.ПрочитатьРазмер() = 0 Тогда Возврат Неопределено; КонецЕсли;
	Возврат Б.ПрочитатьУИД();
КонецФункции

Функция УИДы(Знач Первый, Знач Второй = Неопределено, Знач Третий = Неопределено)
	Тело = Новый БуферЗаписиSWP().УИД(Первый);
	Если Второй <> Неопределено Тогда Тело.УИД(Второй); КонецЕсли;
	Если Третий <> Неопределено Тогда Тело.УИД(Третий); КонецЕсли;
	Возврат Тело;
КонецФункции

Каталог = АргументыКоманднойСтроки[0];
Порт = Число(АргументыКоманднойСтроки[1]);
Версии = СтрРазделить(АргументыКоманднойСтроки[2], ",");
Для Каждого Версия Из Версии Цикл
	Папка = Каталог + "/v" + СтрЗаменить(Версия, ".0", "");
	СоздатьКаталог(Папка);
	Сокет = Новый TCPСоединение("localhost", Порт);
	Сокет.ТаймаутЧтения = 15000;
	Канал = Новый КаналSWP(Сокет);
	Сеанс = Новый РукопожатиеSWP(Канал).ОткрытьСеанс(СообщенияRAS.ИмяСервиса(), СтрРазделить(Версия, ","), Версия);
	Точка = Новый КонечнаяТочкаSWP(Канал, Сеанс.ИдКонечнойТочки, Сеанс.ВерсияКонечнойТочки);
	Сообщить("== версия " + Версия + " (точка v" + Точка.Версия() + ")");
	Кластеры = Снять(Точка, 11, Неопределено, Папка, "clusters");
	Кл = ПервыйУИД(Кластеры);
	Точка.Запрос(9, УИДы(Кл).Текст("").Текст("")); // администратор кластера (на стенде не задан)
	Снять(Точка, 135, Неопределено, Папка, "agent-version");
	Снять(Точка, 13, УИДы(Кл), Папка, "cluster-info");
	Снять(Точка, 18, УИДы(Кл), Папка, "managers");
	Серверы = Снять(Точка, 22, УИДы(Кл), Папка, "servers");
	Срв = ПервыйУИД(Серверы);
	Снять(Точка, 24, УИДы(Кл, Срв), Папка, "server-info");
	Процессы = Снять(Точка, 29, УИДы(Кл), Папка, "processes");
	Прц = ПервыйУИД(Процессы);
	Снять(Точка, 31, УИДы(Кл, Прц), Папка, "process-info");
	Снять(Точка, 33, УИДы(Кл, Срв), Папка, "server-processes");
	Снять(Точка, 35, УИДы(Кл), Папка, "cluster-services");
	Базы = Снять(Точка, 42, УИДы(Кл), Папка, "infobases-short");
	Иб = ПервыйУИД(Базы);
	Снять(Точка, 46, УИДы(Кл, Иб), Папка, "infobase-short-info");
	// Полная информация о базах — после аутентификации пользователем базы (стенд: Администратор, пустой пароль)
	Точка.Запрос(10, УИДы(Кл).Текст("Администратор").Текст(""));
	Снять(Точка, 44, УИДы(Кл), Папка, "infobases");
	Снять(Точка, 48, УИДы(Кл, Иб), Папка, "infobase-info");
	Снять(Точка, 50, УИДы(Кл), Папка, "connections-short");
	Снять(Точка, 52, УИДы(Кл, Иб), Папка, "infobase-connections-short");
	Снять(Точка, 56, УИДы(Кл, Прц, Иб), Папка, "infobase-connections");
	Сеансы = Снять(Точка, 65, УИДы(Кл), Папка, "sessions");
	Снять(Точка, 67, УИДы(Кл, Иб), Папка, "infobase-sessions");
	Снять(Точка, 72, УИДы(Кл), Папка, "locks");
	Снять(Точка, 85, УИДы(Кл, Срв), Папка, "assignment-rules");
	Снять(Точка, 89, УИДы(Кл), Папка, "security-profiles");
	Снять(Точка, 118, УИДы(Кл), Папка, "counters");
	Снять(Точка, 124, УИДы(Кл), Папка, "limits");
	Снять(Точка, 0, Неопределено, Папка, "agent-admins");
	Снять(Точка, 2, УИДы(Кл), Папка, "cluster-admins");
	Сокет.Закрыть();
КонецЦикла;
