#Использовать "../../src/swp"
#Использовать "../../src/internal"
Порт = Число(АргументыКоманднойСтроки[0]);
Для Каждого Версия Из СтрРазделить(АргументыКоманднойСтроки[1], ",") Цикл
	Сокет = Новый TCPСоединение("localhost", Порт);
	Сокет.ТаймаутЧтения = 10000;
	Канал = Новый КаналSWP(Сокет);
	Рукопожатие = Новый РукопожатиеSWP(Канал);
	Известные = Новый Массив; Известные.Добавить(Версия);
	Попытка
		Сеанс = Рукопожатие.ОткрытьСеанс(СообщенияRAS.ИмяСервиса(), Известные, Версия);
		Сообщить(Версия + " -> принята, конечная точка v" + Сеанс.ВерсияКонечнойТочки);
	Исключение
		Сообщить(Версия + " -> " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Сокет.Закрыть();
КонецЦикла;
